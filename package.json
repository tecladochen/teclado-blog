{
  "name": "teclado-blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "description": "Teclado 的个人博客，用来记录日常生活、阅读感受和偶尔的技术折腾。",
  "author": "Teclado <tecladochen@qq.com> (https://github.com/tecladochen)",
  "license": "MIT",
  "repository": "https://github.com/tecladochen/teclado-blog",
  "scripts": {
    "dev": "astro check && astro dev",
    "build": "astro check && astro build",
    "build:ci": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "theme:create": "tsx scripts/create-post.ts",
    "theme:check": "tsx scripts/check-post.ts",
    "theme:update": "tsx scripts/update-theme.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@github/clipboard-copy-element": "^1.3.2",
    "@swup/astro": "^1.8.0",
    "astro": "^7.3.3",
    "astro-robots-txt": "^1.0.0",
    "astro-seo": "^1.2.0",
    "giscus": "^1.6.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/tabler": "^1.2.39",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.16.4",
    "@types/sanitize-html": "^2.16.1",
    "@unocss/astro": "^66.10.5",
    "@unocss/eslint-plugin": "^66.10.5",
    "@unocss/preset-attributify": "^66.10.5",
    "@unocss/reset": "^66.10.5",
    "@unocss/transformer-directives": "^66.10.5",
    "astro-eslint-parser": "^3.1.0",
    "consola": "^3.4.2",
    "dayjs": "^1.11.23",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-format": "^2.0.1",
    "lint-staged": "^16.1.2",
    "markdown-it": "^14.1.0",
    "prettier-plugin-astro": "^0.14.1",
    "rollup": "^4.63.4",
    "sanitize-html": "^2.17.7",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "unocss": "^66.10.5",
    "unocss-preset-theme": "^0.14.1",
    "vite-plugin-devtools-json": "^1.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
