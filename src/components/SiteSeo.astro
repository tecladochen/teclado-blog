---
import type { ImageMetadata } from 'astro'
import type { SEOProps } from 'astro-seo'
import { SEO } from 'astro-seo'
import { getImage } from 'astro:assets'
import { themeConfig } from '~/.config'

interface Props {
  title?: string
  desc?: string
  banner?: ImageMetadata
  type?: 'article' | 'website'
  publishedTime?: Date
  modifiedTime?: Date
  author?: string
  categories?: string[]
}

const props = Astro.props

const configSEO = themeConfig.seo
const configSite = themeConfig.site

const pageTitle = props.title ?? configSite.title
const title
  = props.title && props.title !== configSite.title ? `${props.title} · ${configSite.title}` : configSite.title
const desc = props.desc ?? configSite.description
const siteUrl = Astro.site ?? new URL(configSite.website)
const canonical = new URL(Astro.url.pathname, siteUrl).toString()
const twitter = configSEO.twitter
const rss = new URL('/atom.xml', siteUrl).toString()
const optimizedImage = await getOptimizedImageURL()
const [language, region] = (themeConfig.appearance.locale ?? 'zh-cn').split('-')
const languageTag = region ? `${language}-${region.toUpperCase()}` : language
const locale = languageTag.replace('-', '_')
const author = props.author ?? configSite.author

const seoLinks = [
  { rel: 'icon', href: '/favicon.svg', type: 'image/svg+xml' },
  { rel: 'icon', href: '/favicon.png', type: 'image/png', sizes: '512x512' },
  {
    rel: 'alternate',
    type: 'application/rss+xml',
    title: themeConfig.site.title,
    href: rss,
  },
  ...configSEO.link,
]

const seoMeta = [
  { name: 'viewport', content: 'width=device-width' },
  { name: 'generator', content: Astro.generator },
  { name: 'twitter:image', content: optimizedImage },
  { name: 'twitter:image:alt', content: desc },
  { name: 'twitter:card', content: 'summary_large_image' },
  { name: 'twitter:title', content: title },
  { name: 'twitter:description', content: desc },
  { name: 'author', content: author },
  { property: 'og:description', content: desc },
  { property: 'og:site_name', content: configSite.title },
  { property: 'og:locale', content: locale },
  { property: 'og:image:alt', content: desc },
  { property: 'og:image:width', content: String(props.banner?.width ?? 1200) },
  { property: 'og:image:height', content: String(props.banner?.height ?? 630) },
  ...(props.type === 'article'
    ? [
        ...(props.publishedTime
          ? [{ property: 'article:published_time', content: props.publishedTime.toISOString() }]
          : []),
        ...(props.modifiedTime
          ? [{ property: 'article:modified_time', content: props.modifiedTime.toISOString() }]
          : []),
        { property: 'article:author', content: author },
        ...(props.categories?.[0] ? [{ property: 'article:section', content: props.categories[0] }] : []),
        ...(props.categories?.map(category => ({ property: 'article:tag', content: category })) ?? []),
      ]
    : []),
  ...(twitter
    ? [
        { name: 'twitter:creator', content: twitter },
        { name: 'twitter:site', content: twitter },
      ]
    : []),
  ...configSEO.meta,
]

const openGraph: SEOProps['openGraph'] = {
  basic: {
    title,
    type: props.type ?? 'website',
    image: optimizedImage,
    url: canonical,
  },
}

const websiteId = new URL('/#website', siteUrl).toString()
const webpageId = `${canonical}#webpage`
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      'url': new URL('/', siteUrl).toString(),
      'name': configSite.title,
      'description': configSite.description,
      'inLanguage': languageTag,
      'author': {
        '@type': 'Person',
        'name': configSite.author,
        'url': new URL('/about/', siteUrl).toString(),
      },
    },
    props.type === 'article'
      ? {
          '@type': 'BlogPosting',
          '@id': webpageId,
          'url': canonical,
          'mainEntityOfPage': canonical,
          'headline': pageTitle,
          'name': title,
          'description': desc,
          'image': optimizedImage,
          'datePublished': props.publishedTime?.toISOString(),
          'dateModified': (props.modifiedTime ?? props.publishedTime)?.toISOString(),
          'inLanguage': languageTag,
          'keywords': props.categories,
          'author': {
            '@type': 'Person',
            'name': author,
            'url': new URL('/about/', siteUrl).toString(),
          },
          'publisher': {
            '@type': 'Person',
            'name': configSite.author,
            'url': new URL('/about/', siteUrl).toString(),
          },
          'isPartOf': { '@id': websiteId },
        }
      : {
          '@type': 'WebPage',
          '@id': webpageId,
          'url': canonical,
          'name': title,
          'description': desc,
          'inLanguage': languageTag,
          'isPartOf': { '@id': websiteId },
        },
  ],
}).replace(/</g, '\\u003c')

async function getOptimizedImageURL() {
  const image = props.banner && (await getImage({ src: props.banner, format: 'jpeg' }))
  return new URL(image?.src ?? '/og.png', siteUrl).toString()
}
---

<SEO
  charset="utf-8"
  title={title}
  description={desc}
  canonical={canonical}
  extend={{ link: seoLinks, meta: seoMeta }}
  openGraph={openGraph}
/>
<script is:inline type="application/ld+json" set:html={structuredData} />
