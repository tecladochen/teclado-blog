---
type Heading = { depth: number, slug: string, text: string }
type Props = { headings: Heading[] }

const sections = Astro.props.headings.filter(heading => heading.depth === 2)
const showTableOfContents = sections.length >= 2
---

{
  showTableOfContents && (
    <aside id="toc-container" class="toc-redesign reading-design not-prose select-none">
      <div class="toc-launcher">
        <button
          id="toc-toggle-btn"
          type="button"
          aria-label="打开文章目录"
          aria-expanded="false"
          aria-controls="toc-drawer"
          class="toc-toggle"
        >
          <span class="toc-toggle-label">目录</span>
          <span id="toc-progress-badge">0%</span>
          <span class="toc-toggle-rule" aria-hidden="true">
            <span />
          </span>
        </button>
      </div>

      <div id="toc-backdrop" class="toc-backdrop" />

      <div id="toc-drawer" role="dialog" aria-modal="true" aria-label="文章目录" aria-hidden="true" inert>
        <div class="toc-head">
          <div>
            <span class="toc-kicker">目录</span>
            <span class="toc-count">{sections.length} 节</span>
          </div>
          <button id="toc-close-btn" type="button" aria-label="关闭目录" class="toc-close">
            <span aria-hidden="true">×</span>
          </button>
        </div>

        <nav class="toc-navigation custom-scrollbar" aria-label="文章章节">
          <ol>
            {sections.map(heading => (
              <li>
                <a
                  href={`#${heading.slug}`}
                  data-no-swup
                  data-slug={heading.slug}
                  class="toc-item-link not-underline-hover"
                >
                  <span class="toc-marker" aria-hidden="true" />
                  <span class="toc-title">{heading.text}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>

        <div class="toc-progress-track" aria-hidden="true">
          <span id="toc-progress-fill" />
        </div>
        <div class="toc-foot">
          <button id="toc-scroll-top-btn" type="button">
            <>
              <span aria-hidden="true">↑</span>
              <span>回到顶部</span>
            </>
          </button>
          <span class="toc-read-progress">
            阅读进度 <span id="toc-footer-progress">0%</span>
          </span>
        </div>
      </div>
    </aside>
  )
}

<script>
  let tableOfContentsController: AbortController | undefined

  function setupTableOfContents() {
    tableOfContentsController?.abort()

    const container = document.getElementById('toc-container')
    const toggleBtn = document.getElementById('toc-toggle-btn')
    const closeBtn = document.getElementById('toc-close-btn')
    const backdrop = document.getElementById('toc-backdrop')
    const drawer = document.getElementById('toc-drawer')
    const progressBadge = document.getElementById('toc-progress-badge')
    const progressFill = document.getElementById('toc-progress-fill')
    const footerProgress = document.getElementById('toc-footer-progress')
    const scrollTopBtn = document.getElementById('toc-scroll-top-btn')
    const tocLinks = container?.querySelectorAll<HTMLAnchorElement>('.toc-item-link') ?? []

    if (!container || !toggleBtn || !drawer || !backdrop) {
      return
    }

    const controller = new AbortController()
    const { signal } = controller
    tableOfContentsController = controller
    let isOpen = false
    let returnFocus: HTMLElement | null = null
    const motion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ? ('instant' as const) : ('smooth' as const)

    function focusable() {
      return Array.from(drawer!.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'))
    }

    function openDrawer() {
      isOpen = true
      returnFocus = document.activeElement as HTMLElement
      drawer!.inert = false
      drawer!.setAttribute('aria-hidden', 'false')
      backdrop!.classList.add('is-visible')
      toggleBtn!.setAttribute('aria-expanded', 'true')
      toggleBtn!.setAttribute('aria-label', '关闭文章目录')
      requestAnimationFrame(() => closeBtn?.focus())
    }

    function closeDrawer() {
      isOpen = false
      drawer!.setAttribute('aria-hidden', 'true')
      backdrop!.classList.remove('is-visible')
      toggleBtn!.setAttribute('aria-expanded', 'false')
      toggleBtn!.setAttribute('aria-label', '打开文章目录')
      returnFocus?.focus()
      returnFocus = null
      drawer!.inert = true
    }

    toggleBtn.addEventListener(
      'click',
      (event) => {
        event.stopPropagation()
        isOpen ? closeDrawer() : openDrawer()
      },
      { signal },
    )
    closeBtn?.addEventListener('click', closeDrawer, { signal })
    backdrop.addEventListener('click', closeDrawer, { signal })

    window.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && isOpen) {
          event.preventDefault()
          closeDrawer()
        }
        if (event.key !== 'Tab' || !isOpen) {
          return
        }
        const items = focusable()
        const first = items[0]
        const last = items.at(-1)
        if (!first || !last) {
          return
        }
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault()
          last.focus()
          return
        }
        if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault()
          first.focus()
        }
      },
      { signal },
    )

    scrollTopBtn?.addEventListener(
      'click',
      () => {
        window.scrollTo({ top: 0, behavior: motion() })
        closeDrawer()
      },
      { signal },
    )

    tocLinks.forEach(link =>
      link.addEventListener(
        'click',
        (event) => {
          const href = link.getAttribute('href')
          if (!href?.startsWith('#')) {
            return
          }
          event.preventDefault()
          const rawId = href.slice(1)
          const target = document.getElementById(decodeURIComponent(rawId)) || document.getElementById(rawId)
          closeDrawer()
          if (target) {
            target.tabIndex = -1
            target.focus({ preventScroll: true })
            target.scrollIntoView({ behavior: motion() })
            history.replaceState(null, '', href)
          }
        },
        { signal },
      ),
    )

    const article = document.querySelector('.article-sheet')
    const headings = Array.from(document.querySelectorAll<HTMLElement>('.post-prose-content h2[id]'))

    function update() {
      const scrollTop = window.scrollY
      const articleTop = article ? article.getBoundingClientRect().top + scrollTop : 0
      const articleEnd = article
        ? article.getBoundingClientRect().bottom + scrollTop
        : document.documentElement.scrollHeight
      const distance = articleEnd - articleTop - window.innerHeight
      const percent = Math.min(
        100,
        Math.max(0, Math.round((distance > 0 ? (scrollTop - articleTop) / distance : 1) * 100)),
      )
      if (progressFill) {
        progressFill.style.transform = `scaleX(${percent / 100})`
      }
      if (progressBadge) {
        progressBadge.textContent = `${percent}%`
      }
      toggleBtn!.style.setProperty('--toc-progress', `${percent}%`)
      if (footerProgress) {
        footerProgress.textContent = `${percent}%`
      }

      let currentSlug = ''
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top > 140) {
          break
        }
        currentSlug = heading.id
      }
      tocLinks.forEach((link) => {
        const slug = link.dataset.slug
        const current = slug && (slug === currentSlug || decodeURIComponent(slug) === currentSlug)
        current ? link.setAttribute('aria-current', 'location') : link.removeAttribute('aria-current')
      })
    }

    window.addEventListener('scroll', update, { passive: true, signal })
    window.addEventListener('resize', update, { passive: true, signal })
    update()
    if (window.location.search.includes('toc=open') || window.location.hash === '#toc') {
      openDrawer()
    }
  }

  setupTableOfContents()
  document.addEventListener('astro:page-load', setupTableOfContents)
</script>

<style>
  .toc-redesign {
    color: var(--reading-ink);
    font-family: var(--reading-sans);
  }

  .toc-launcher {
    position: fixed;
    right: 20px;
    bottom: max(20px, env(safe-area-inset-bottom));
    z-index: 40;
  }

  .toc-toggle {
    --toc-progress: 0%;
    position: relative;
    display: grid;
    grid-template-columns: auto auto;
    min-width: 92px;
    min-height: 42px;
    align-items: center;
    gap: 3px 12px;
    padding: 8px 13px 7px;
    border: 1px solid var(--reading-rule);
    border-radius: 9px;
    background: color-mix(in srgb, var(--uno-colors-background) 90%, transparent);
    box-shadow: 0 12px 28px -22px rgba(38, 30, 27, 0.62);
    color: var(--reading-ink);
    cursor: pointer;
    backdrop-filter: blur(12px);
    transition:
      transform 300ms var(--reading-ease),
      opacity 180ms ease,
      border-color 180ms ease,
      background 180ms ease;
  }

  .toc-toggle:hover,
  .toc-toggle:focus-visible {
    border-color: color-mix(in srgb, var(--reading-hover-ink) 42%, transparent);
    background: color-mix(in srgb, var(--uno-colors-background) 82%, var(--reading-hover));
    transform: translateY(-2px);
  }

  .toc-toggle[aria-expanded='true'] {
    pointer-events: none;
    opacity: 0;
    transform: translateY(4px) scale(0.92);
  }

  .toc-toggle-label {
    font-family: var(--reading-serif);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
  }

  #toc-progress-badge {
    color: var(--reading-muted);
    font:
      8px/1 'JetBrains Mono Variable',
      monospace;
  }

  .toc-toggle-rule {
    grid-column: 1 / -1;
    width: 100%;
    height: 1px;
    overflow: hidden;
    background: var(--reading-rule);
  }

  .toc-toggle-rule > span {
    display: block;
    width: var(--toc-progress);
    height: 100%;
    background: var(--reading-accent);
    transition: width 220ms linear;
  }

  .toc-backdrop {
    position: fixed;
    z-index: 50;
    inset: 0;
    pointer-events: none;
    background: transparent;
    opacity: 0;
  }

  .toc-backdrop.is-visible {
    pointer-events: auto;
    opacity: 1;
  }

  #toc-drawer {
    position: fixed;
    right: 22px;
    bottom: max(22px, env(safe-area-inset-bottom));
    z-index: 60;
    display: flex;
    width: min(300px, calc(100vw - 24px));
    max-height: min(570px, calc(100dvh - 36px));
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--reading-rule);
    border-radius: 13px;
    background: color-mix(in srgb, var(--uno-colors-background) 96%, transparent);
    box-shadow:
      0 26px 64px -42px rgba(38, 30, 27, 0.58),
      0 1px 0 color-mix(in srgb, var(--reading-surface) 64%, transparent) inset;
    backdrop-filter: blur(12px) saturate(0.9);
    transform-origin: right bottom;
    transition:
      opacity 180ms ease,
      transform 420ms var(--reading-ease),
      clip-path 460ms var(--reading-ease);
  }

  #toc-drawer[aria-hidden='true'] {
    pointer-events: none;
    opacity: 0;
    transform: translateY(12px) scale(0.98);
    clip-path: inset(82% 0 0 62% round 10px);
  }

  #toc-drawer[aria-hidden='false'] {
    pointer-events: auto;
    opacity: 1;
    transform: none;
    clip-path: inset(0 round 13px);
  }

  .toc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 17px 13px 20px;
    border-bottom: 1px solid var(--reading-rule);
  }

  .toc-head > div {
    display: flex;
    align-items: baseline;
    gap: 9px;
  }

  .toc-kicker {
    font-family: var(--reading-serif);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .toc-count {
    color: var(--reading-muted);
    font:
      8px/1 'JetBrains Mono Variable',
      monospace;
    letter-spacing: 0.08em;
  }

  .toc-close {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--uno-colors-background) 62%, transparent);
    color: var(--reading-muted);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    transition:
      color 180ms ease,
      background 180ms ease,
      transform 300ms var(--reading-ease);
  }

  .toc-close:hover,
  .toc-close:focus-visible {
    background: var(--reading-hover);
    color: var(--reading-hover-ink);
    transform: rotate(90deg);
  }

  .toc-navigation {
    min-height: 0;
    padding: 10px 14px 12px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .toc-navigation ol {
    position: relative;
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    counter-reset: chapter;
    list-style: none;
  }

  .toc-navigation ol::before {
    position: absolute;
    top: 23px;
    bottom: 23px;
    left: 40px;
    width: 1px;
    background: var(--reading-rule);
    content: '';
  }

  .toc-navigation li {
    counter-increment: chapter;
  }

  .toc-item-link {
    position: relative;
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 10px;
    min-height: 46px;
    align-items: center;
    padding: 6px 7px;
    color: var(--reading-secondary);
    font-family: var(--reading-serif);
    font-size: 13px;
    line-height: 1.55;
    transition:
      color 180ms ease,
      transform 320ms var(--reading-ease);
  }

  .toc-item-link:hover,
  .toc-item-link:focus-visible {
    color: var(--reading-hover-ink);
    transform: translateX(3px);
  }

  .toc-marker {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 22px 7px;
    align-items: center;
    gap: 7px;
    color: var(--reading-muted);
    font:
      8px/1 'JetBrains Mono Variable',
      monospace;
  }

  .toc-marker::before {
    content: counter(chapter, decimal-leading-zero);
  }

  .toc-marker::after {
    width: 7px;
    height: 7px;
    border: 2px solid var(--uno-colors-background);
    border-radius: 50%;
    background: currentColor;
    content: '';
    opacity: 0.36;
    transition:
      opacity 180ms ease,
      transform 320ms var(--reading-ease),
      box-shadow 180ms ease;
  }

  .toc-title {
    position: relative;
    width: fit-content;
    max-width: 100%;
  }

  .toc-title::after {
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--reading-accent);
    content: '';
    opacity: 0;
    transition:
      width 380ms var(--reading-ease),
      opacity 180ms ease;
  }

  .toc-item-link[aria-current='location'] {
    color: var(--reading-ink);
    font-weight: 700;
    transform: translateX(3px);
  }

  .toc-item-link[aria-current='location'] .toc-marker {
    color: var(--reading-accent);
  }

  .toc-item-link[aria-current='location'] .toc-marker::after {
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--reading-accent) 10%, transparent);
    opacity: 1;
    transform: scale(1.06);
  }

  .toc-item-link[aria-current='location'] .toc-title::after {
    width: 24px;
    opacity: 1;
  }

  .toc-progress-track {
    height: 1px;
    margin: 0 20px;
    overflow: hidden;
    background: var(--reading-rule);
  }

  #toc-progress-fill {
    display: block;
    height: 100%;
    background: var(--reading-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms linear;
  }

  .toc-foot {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    padding: 8px 13px 12px 12px;
    color: var(--reading-muted);
    font-size: 10px;
  }

  #toc-scroll-top-btn {
    display: flex;
    min-height: 34px;
    align-items: center;
    gap: 7px;
    padding: 0 7px;
    cursor: pointer;
    transition:
      color 180ms ease,
      transform 260ms var(--reading-ease);
  }

  #toc-scroll-top-btn:hover,
  #toc-scroll-top-btn:focus-visible {
    color: var(--reading-hover-ink);
    transform: translateY(-2px);
  }

  #toc-footer-progress {
    color: var(--reading-accent);
    font-family: 'JetBrains Mono Variable', monospace;
  }

  @media (min-width: 640px) {
    .toc-launcher {
      right: 16px;
      bottom: max(20px, env(safe-area-inset-bottom));
    }

    #toc-drawer {
      right: 12px;
      bottom: max(20px, env(safe-area-inset-bottom));
    }
  }

  @media (max-width: 639px) {
    #toc-drawer {
      right: 10px;
      bottom: max(10px, env(safe-area-inset-bottom));
      width: calc(100vw - 20px);
      max-height: calc(100dvh - 20px);
      border-radius: 12px;
    }

    #toc-drawer[aria-hidden='false'] {
      clip-path: inset(0 round 12px);
    }

    .toc-head {
      padding: 18px 15px 12px 18px;
    }

    .toc-navigation {
      padding-inline: 12px;
    }

    .toc-item-link {
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #toc-drawer,
    .toc-item-link,
    .toc-toggle,
    .toc-title::after,
    #toc-progress-fill {
      transition: none !important;
    }
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }

  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb {
    border-radius: 4px;
    background: color-mix(in srgb, var(--reading-rule) 85%, transparent);
  }
</style>
