---
import { themeConfig } from '~/.config'
import { getPathFromCategory } from '~/utils'

interface Props {
  category: string
}

const { category } = Astro.props

function getCategoryUrl(category: string) {
  return `/categories/${getPathFromCategory(category, themeConfig.site.categoryMap)}`
}
---

<a href={getCategoryUrl(category)} class="category-pill not-underline-hover">
  <span class="hash opacity-40 select-none">#</span><span>{category}</span>
</a>

<style>
  .category-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    font-size: 0.78rem;
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
    background-color: rgba(125, 125, 125, 0.07);
    color: currentColor;
    opacity: 0.75;
    transition: all 0.2s ease;
  }
  .category-pill:hover {
    opacity: 1;
    background-color: rgba(125, 125, 125, 0.14);
    color: var(--uno-colors-primary, currentColor);
  }
</style>
