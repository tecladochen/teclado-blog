---
import type { Post } from '~/types'
import { formatDate } from '~/utils'
import PostCategory from './PostCategory.astro'
import PostSeriesLink from './PostSeriesLink.astro'

interface Props {
  post: Post
}

const { post } = Astro.props

const categoryList = post.data.categories ?? []
const series = post.data.series
const displayDate = post.data.modDate ?? post.data.pubDate
---

<header class="post-header flex flex-col gap-1.5 mb-2.5">
  <h2 class="post-item-title m-0">
    <a class="not-prose not-underline-hover post-link" href={`/posts/${post.id}/`}>{post.data.title}</a>
  </h2>
  <div class="post-meta">
    <span class="post-meta-date">
      <time datetime={displayDate.toISOString()}>{formatDate(displayDate)}</time>
    </span>
    {categoryList.map((category) => <PostCategory category={category} />)}
    {series && <PostSeriesLink name={series.name} />}
  </div>
</header>

<style>
  .post-item-title {
    font-size: 1.22rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: -0.015em;
  }

  .post-link {
    color: var(--uno-colors-primary, currentColor);
    text-decoration: none !important;
    transition: opacity 0.2s ease, color 0.2s ease;
  }

  .post-link:hover {
    opacity: 0.72;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.65rem;
    row-gap: 0.35rem;
    line-height: 1.5;
  }

  .post-meta-date {
    display: inline-flex;
    align-items: center;
    font-variant-numeric: tabular-nums;
    font-size: 0.8rem;
    opacity: 0.55;
    letter-spacing: 0.02em;
  }
</style>
