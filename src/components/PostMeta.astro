---
import type { Post } from '~/types'
import { formatDate, getWordCountAndReadTime } from '~/utils'

interface Props {
  post: Post
}

const { post } = Astro.props

const publishedText = formatDate(post.data.pubDate, 'YYYY-MM-DD')
const modifiedText = post.data.modDate ? formatDate(post.data.modDate, 'YYYY-MM-DD') : undefined
const showModifiedDate = modifiedText && modifiedText !== publishedText
const { minutes } = getWordCountAndReadTime(post.body)
---

<header class="post-header not-prose">
  <div class="post-dateline" data-reading-reveal>
    <time datetime={post.data.pubDate.toISOString()}>{publishedText}</time>
    <span aria-hidden="true">/</span>
    <span>{minutes} 分钟阅读</span>
    {showModifiedDate && <span class="post-updated">更新于 {modifiedText}</span>}
  </div>
  <h1 data-reading-reveal>{post.data.title}</h1>
  {
    post.data.description && (
      <p class="post-dek" data-reading-reveal>
        {post.data.description}
      </p>
    )
  }
</header>

<style>
  .post-header {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    column-gap: 40px;
    padding: 28px 4px 74px;
    font-family: var(--reading-sans);
  }
  .post-dateline {
    grid-row: 1 / span 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 8px 20px 8px 0;
    border-right: 1px solid var(--reading-rule);
    color: var(--reading-muted);
    font-size: 11px;
    line-height: 1.8;
    letter-spacing: 0.03em;
  }
  .post-dateline time {
    font-family: 'JetBrains Mono Variable', monospace;
  }
  .post-dateline > span[aria-hidden='true'] {
    width: 22px;
    height: 1px;
    overflow: hidden;
    margin-block: 6px;
    background: var(--reading-accent);
    color: transparent;
  }
  .post-updated {
    margin-top: auto;
    white-space: nowrap;
  }
  h1 {
    max-width: 12em;
    margin: 0 0 44px;
    font-family: var(--reading-serif);
    font-size: clamp(40px, 6.4vw, 62px);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.05em;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  .post-dek {
    max-width: 31rem;
    margin: 0 0 0 auto;
    padding-top: 22px;
    border-top: 1px solid var(--reading-rule);
    color: var(--reading-secondary);
    font-size: 15px;
    line-height: 1.95;
  }
  @media (max-width: 639px) {
    .post-header {
      grid-template-columns: minmax(0, 1fr);
      padding: 10px 0 48px;
    }
    .post-dateline {
      grid-row: auto;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      padding: 0 0 20px;
      border-right: 0;
      border-bottom: 1px solid var(--reading-rule);
    }
    .post-dateline > span[aria-hidden='true'] {
      width: 12px;
      margin: 0 2px;
    }
    h1 {
      margin: 28px 0 30px;
      font-size: clamp(34px, 10vw, 44px);
      line-height: 1.38;
    }
    .post-dek {
      max-width: none;
      margin: 0 0 0 42px;
      padding-top: 18px;
      font-size: 15px;
    }
    .post-updated {
      margin: 0 0 0 auto;
    }
  }
</style>
