---
const { translate: t } = Astro.locals

const commands = [
  { label: t('Now'), detail: 'STATUS', href: '/now' },
  { label: t('Map'), detail: 'FIELD', href: '/map' },
  { label: t('Journey'), detail: 'ORBIT', href: '/journey' },
  { label: t('Archive'), detail: 'TIMELINE', href: '/archive' },
  { label: t('Categories'), detail: 'INDEX', href: '/categories' },
  { label: t('Series'), detail: 'PATHS', href: '/series' },
]
---

<dialog
  id="search-palette"
  class="search-palette"
  aria-labelledby="search-title"
  data-loading-label={t('search_loading')}
  data-failed-label={t('search_failed')}
  data-empty-label={t('no_search_results')}
  data-retry-label={t('retry')}
>
  <div class="search-frame">
    <header class="search-header">
      <div>
        <span class="search-coordinate">COMMAND / FIND</span>
        <h2 id="search-title">{t('Search')}</h2>
      </div>
      <button class="search-close" type="button" data-search-close aria-label={t('close_search')}>
        <span aria-hidden="true">ESC</span>
      </button>
    </header>

    <label class="search-input-wrap" for="site-search-input">
      <span class="i-mdi-magnify" aria-hidden="true"></span>
      <input
        id="site-search-input"
        type="search"
        autocomplete="off"
        placeholder={t('search_placeholder')}
        aria-label={t('Search')}
        aria-controls="search-results"
        aria-autocomplete="list"
      />
      <kbd>⌘ K</kbd>
    </label>

    <div id="search-results" class="search-results" role="listbox" aria-label={t('search_results')}></div>

    <section class="search-commands" data-search-commands>
      <p>{t('quick_actions')}</p>
      <div>
        {
          commands.map((command, index) => (
            <a id={`search-command-${index}`} href={command.href} role="option" data-search-option>
              <span>{command.label}</span>
              <small>{command.detail}</small>
            </a>
          ))
        }
        <a id="search-command-random" href="/archive" role="option" data-search-option data-random-post>
          <span>{t('Random')}</span>
          <small>SHUFFLE</small>
        </a>
      </div>
    </section>

    <footer class="search-footer" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> {t('select')}</span>
      <span><kbd>↵</kbd> {t('open')}</span>
      <span><kbd>esc</kbd> {t('close')}</span>
    </footer>
  </div>
</dialog>

<script>
  import type { SearchIndexItem } from '~/types'

  const dialog = document.querySelector<HTMLDialogElement>('#search-palette')

  if (dialog && !dialog.dataset.ready) {
    dialog.dataset.ready = 'true'

    const input = dialog.querySelector<HTMLInputElement>('#site-search-input')
    const results = dialog.querySelector<HTMLElement>('#search-results')
    const commands = dialog.querySelector<HTMLElement>('[data-search-commands]')
    const closeButton = dialog.querySelector<HTMLButtonElement>('[data-search-close]')
    let searchIndex: SearchIndexItem[] | null = null
    let indexPromise: Promise<SearchIndexItem[]> | null = null
    let activeIndex = -1
    let returnFocus: HTMLElement | null = null

    const normalize = (value: string) => value.normalize('NFKC').toLocaleLowerCase().replace(/\s+/g, ' ').trim()

    const getOptions = () =>
      Array.from(dialog.querySelectorAll<HTMLElement>('[data-search-option]')).filter(
        (option) => option.offsetParent !== null,
      )

    const setActiveOption = (nextIndex: number) => {
      const options = getOptions()
      if (!options.length) {
        return
      }

      activeIndex = (nextIndex + options.length) % options.length
      options.forEach((option, index) => {
        option.toggleAttribute('data-active', index === activeIndex)
      })
      const active = options[activeIndex]
      input?.setAttribute('aria-activedescendant', active.id)
      active.scrollIntoView({ block: 'nearest' })
    }

    const loadIndex = () => {
      if (searchIndex) {
        return Promise.resolve(searchIndex)
      }
      if (indexPromise) {
        return indexPromise
      }

      indexPromise = fetch('/search-index.json')
        .then((response) => {
          if (!response.ok) {
            throw new Error(`Search index returned ${response.status}`)
          }
          return response.json() as Promise<SearchIndexItem[]>
        })
        .then((data) => {
          searchIndex = data
          return data
        })
        .finally(() => {
          indexPromise = null
        })

      return indexPromise
    }

    const createStatus = (label: string, retry = false) => {
      if (!results) {
        return
      }
      results.replaceChildren()
      const status = document.createElement('p')
      status.className = 'search-status'
      status.textContent = label
      results.append(status)

      if (retry) {
        const button = document.createElement('button')
        button.type = 'button'
        button.className = 'search-retry'
        button.textContent = dialog.dataset.retryLabel ?? 'Retry'
        button.dataset.searchRetry = ''
        results.append(button)
      }
    }

    const scoreItem = (item: SearchIndexItem, tokens: string[]) => {
      const title = normalize(item.title)
      const taxonomy = normalize([...item.categories, item.series ?? ''].join(' '))
      const description = normalize(item.description)
      const content = normalize(item.content)
      const combined = `${title} ${taxonomy} ${description} ${content}`

      if (!tokens.every((token) => combined.includes(token))) {
        return -1
      }

      return tokens.reduce((score, token) => {
        const titleScore = title === token ? 100 : title.startsWith(token) ? 60 : title.includes(token) ? 40 : 0
        score += titleScore
        if (taxonomy.includes(token)) {
          score += 24
        }
        if (description.includes(token)) {
          score += 12
        }
        if (content.includes(token)) {
          score += 3
        }
        return score
      }, 0)
    }

    const renderResults = (items: SearchIndexItem[], query: string) => {
      if (!results || !commands) {
        return
      }

      const tokens = normalize(query).split(' ').filter(Boolean)
      commands.hidden = tokens.length > 0
      results.replaceChildren()
      activeIndex = -1
      input?.removeAttribute('aria-activedescendant')

      if (!tokens.length) {
        return
      }

      const matches = items
        .map((item) => ({ item, score: scoreItem(item, tokens) }))
        .filter((match) => match.score >= 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 8)

      if (!matches.length) {
        createStatus(dialog.dataset.emptyLabel ?? 'No results')
        return
      }

      const list = document.createElement('ol')
      list.className = 'search-result-list'

      matches.forEach(({ item }, index) => {
        const listItem = document.createElement('li')
        const link = document.createElement('a')
        const heading = document.createElement('strong')
        const description = document.createElement('span')
        const meta = document.createElement('small')

        link.id = `search-result-${index}`
        link.href = item.url
        link.dataset.searchOption = ''
        link.setAttribute('role', 'option')
        heading.textContent = item.title
        description.textContent = item.description
        meta.textContent = [...item.categories, item.series ?? ''].filter(Boolean).join(' / ')

        link.append(heading, description, meta)
        listItem.append(link)
        list.append(listItem)
      })

      results.append(list)
    }

    const refreshResults = async (force = false) => {
      const query = input?.value ?? ''
      if (!normalize(query)) {
        commands?.removeAttribute('hidden')
        results?.replaceChildren()
      }

      if (force) {
        searchIndex = null
        indexPromise = null
      }

      if (!searchIndex && normalize(query)) {
        createStatus(dialog.dataset.loadingLabel ?? 'Loading…')
      }

      await loadIndex()
        .then((items) => {
          if (input?.value === query) {
            renderResults(items, query)
          }
        })
        .catch(() => {
          commands?.setAttribute('hidden', '')
          createStatus(dialog.dataset.failedLabel ?? 'Search failed', true)
        })
    }

    const openSearch = (trigger?: HTMLElement) => {
      if (!dialog.open) {
        returnFocus = trigger ?? (document.activeElement as HTMLElement)
        dialog.showModal()
      }
      requestAnimationFrame(() => input?.focus())
      void refreshResults()
    }

    const closeSearch = () => {
      if (!dialog.open) {
        return
      }
      dialog.close()
      returnFocus?.focus()
      returnFocus = null
    }

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement
      const searchTrigger = target.closest<HTMLElement>('[data-search-open]')
      if (searchTrigger) {
        event.preventDefault()
        openSearch(searchTrigger)
        return
      }

      const randomTrigger = target.closest<HTMLAnchorElement>('[data-random-post]')
      if (randomTrigger) {
        event.preventDefault()
        void loadIndex()
          .then((items) => {
            const currentPath = window.location.pathname.replace(/\/$/, '')
            const candidates = items.filter((item) => item.url.replace(/\/$/, '') !== currentPath)
            const pool = candidates.length ? candidates : items
            const selected = pool[Math.floor(Math.random() * pool.length)]
            window.location.assign(selected?.url ?? '/archive')
          })
          .catch(() => window.location.assign('/archive'))
        return
      }

      if (target.closest('[data-search-option]')) {
        dialog.close()
        return
      }

      if (target.closest('[data-search-retry]')) {
        void refreshResults(true)
      }
    })

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLocaleLowerCase() === 'k') {
        event.preventDefault()
        openSearch()
        return
      }

      if (!dialog.open) {
        return
      }
      if (event.key === 'Escape') {
        event.preventDefault()
        closeSearch()
        return
      }
      if (event.key === 'ArrowDown') {
        event.preventDefault()
        setActiveOption(activeIndex + 1)
        return
      }
      if (event.key === 'ArrowUp') {
        event.preventDefault()
        setActiveOption(activeIndex - 1)
        return
      }
      if (event.key === 'Enter' && activeIndex >= 0) {
        event.preventDefault()
        getOptions()[activeIndex]?.click()
      }
    })

    input?.addEventListener('input', () => {
      void refreshResults()
    })
    closeButton?.addEventListener('click', closeSearch)
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) {
        closeSearch()
      }
    })
    dialog.addEventListener('close', () => {
      if (input) {
        input.value = ''
        input.removeAttribute('aria-activedescendant')
      }
      results?.replaceChildren()
      commands?.removeAttribute('hidden')
      activeIndex = -1
    })
    document.addEventListener('astro:page-load', () => {
      if (dialog.open) {
        dialog.close()
      }
    })
  }
</script>

<style is:global>
  .search-palette {
    width: min(42rem, calc(100vw - 2rem));
    max-height: min(44rem, calc(100vh - 2rem));
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid currentColor;
    border-radius: 0;
    color: var(--uno-colors-primary);
    background: var(--uno-colors-background);
    box-shadow: 0.8rem 0.8rem 0 var(--uno-colors-shadow);
  }

  .search-palette::backdrop {
    background: color-mix(in srgb, var(--uno-colors-primary) 28%, transparent);
    backdrop-filter: blur(2px);
  }

  .search-frame {
    display: flex;
    flex-direction: column;
    max-height: min(44rem, calc(100vh - 2rem));
  }

  .search-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.25rem 1rem;
    border-bottom: 1px solid var(--uno-colors-shadow);
  }

  .search-coordinate {
    display: block;
    margin-bottom: 0.2rem;
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    opacity: 0.55;
  }

  .search-header h2 {
    margin: 0;
    font-size: 1.1rem;
  }

  .search-close {
    padding: 0.28rem 0.45rem;
    border: 1px solid var(--uno-colors-shadow);
    color: inherit;
    background: transparent;
    font: inherit;
    font-size: 0.62rem;
    cursor: pointer;
  }

  .search-input-wrap {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.7rem;
    align-items: center;
    margin: 1rem 1.25rem 0;
    padding: 0.7rem 0.8rem;
    border: 1px solid currentColor;
  }

  .search-input-wrap input {
    min-width: 0;
    border: 0;
    outline: 0;
    color: inherit;
    background: transparent;
    font: inherit;
  }

  .search-input-wrap kbd,
  .search-footer kbd {
    font-family: inherit;
    font-size: 0.66rem;
    opacity: 0.55;
  }

  .search-results,
  .search-commands {
    min-height: 0;
    overflow-y: auto;
  }

  .search-result-list {
    margin: 0;
    padding: 1rem 1.25rem 0;
    list-style: none;
  }

  .search-result-list li + li {
    border-top: 1px solid var(--uno-colors-shadow);
  }

  .search-result-list a {
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
    padding: 0.75rem 0.55rem;
    text-decoration: none;
  }

  .search-result-list strong {
    font-size: 0.95rem;
  }

  .search-result-list span {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.78rem;
    line-height: 1.55;
    opacity: 0.72;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .search-result-list small {
    font-size: 0.66rem;
    opacity: 0.52;
  }

  [data-search-option][data-active],
  [data-search-option]:focus-visible {
    color: var(--uno-colors-background);
    background: var(--uno-colors-primary);
    outline: none;
  }

  .search-commands {
    padding: 1rem 1.25rem;
  }

  .search-commands > p {
    margin: 0 0 0.6rem;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    opacity: 0.55;
  }

  .search-commands > div {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--uno-colors-shadow);
    border-left: 1px solid var(--uno-colors-shadow);
  }

  .search-commands a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.7rem;
    border-right: 1px solid var(--uno-colors-shadow);
    border-bottom: 1px solid var(--uno-colors-shadow);
    text-decoration: none;
  }

  .search-commands small {
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    opacity: 0.55;
  }

  .search-status {
    margin: 0;
    padding: 2rem 1.25rem 0.5rem;
    text-align: center;
    opacity: 0.65;
  }

  .search-retry {
    display: block;
    margin: 0 auto 1.25rem;
    border: 0;
    color: inherit;
    background: transparent;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .search-footer {
    display: flex;
    gap: 1rem;
    margin-top: auto;
    padding: 0.7rem 1.25rem;
    border-top: 1px solid var(--uno-colors-shadow);
    font-size: 0.65rem;
    opacity: 0.58;
  }

  @media (max-width: 520px) {
    .search-palette {
      width: calc(100vw - 1rem);
      max-height: calc(100vh - 1rem);
    }

    .search-frame {
      max-height: calc(100vh - 1rem);
    }

    .search-commands > div {
      grid-template-columns: 1fr;
    }

    .search-footer {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-palette::backdrop {
      backdrop-filter: none;
    }
  }
</style>
