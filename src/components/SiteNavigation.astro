---
import { themeConfig } from '~/.config'
import AmbientEnvironment from '~/components/AmbientEnvironment.astro'
import { getSocialIconClass } from '~/utils/socialIcons'

const { navLinks, socialLinks } = themeConfig.site
const { translate: t } = Astro.locals
const currentPath = Astro.url.pathname

const navLabels: Record<string, string> = {
  Posts: '文章',
  Journey: '轨迹',
  Links: '友链',
  About: '关于',
}

function isNavActive(href: string) {
  const cleanPath = currentPath.replace(/\/$/, '') || '/'
  const cleanHref = href.replace(/\/$/, '') || '/'
  if (cleanHref === '/') {
    return cleanPath === '/' || cleanPath.startsWith('/posts') || /^\/\d+/.test(cleanPath)
  }
  return cleanPath === cleanHref || cleanPath.startsWith(`${cleanHref}/`)
}
---

<nav class="flex shrink-0 items-center gap-2 text-xs font-sans sm:gap-5" id="site-nav">
  <ul class="m-0 flex list-none items-center gap-1 p-0 sm:gap-1.5">
    {
      navLinks.map((nav) => {
        const label = navLabels[nav.name] ?? t(nav.name)
        const active = isNavActive(nav.href)
        return (
          <li>
            <a
              data-nav-item
              data-href={nav.href}
              class:list={[
                'nav-link not-underline-hover px-1.5 sm:px-3 py-2 sm:py-1 rounded-md transition-colors duration-150 block text-[13px] sm:text-[14px]',
                active ? 'is-active' : 'is-inactive',
              ]}
              href={nav.href}
            >
              {label}
            </a>
          </li>
        )
      })
    }
  </ul>

  <div class="mx-1 hidden h-3.5 w-[1px] select-none bg-black/10 sm:block dark:bg-white/10"></div>

  <ul class="m-0 hidden list-none items-center gap-2 p-0 sm:flex">
    {
      socialLinks.map(({ href, name }) => (
        <li>
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            title={name}
            class="not-underline-hover inline-flex items-center justify-center rounded p-1.5 text-neutral-400 transition-colors hover:bg-black/[0.04] dark:text-neutral-500 hover:text-neutral-800 dark:hover:bg-white/[0.06] dark:hover:text-neutral-200"
          >
            <span class:list={[getSocialIconClass(name), 'w-4 h-4 sm:w-4.5 sm:h-4.5']} aria-hidden="true" />
          </a>
        </li>
      ))
    }
  </ul>

  <AmbientEnvironment />
</nav>

<style>
  .nav-link {
    cursor: pointer;
    user-select: none;
  }
  .nav-link.is-active {
    font-weight: 600;
    color: #171717;
    background-color: rgba(0, 0, 0, 0.08);
  }
  :global(.dark) .nav-link.is-active {
    color: #ededed;
    background-color: rgba(255, 255, 255, 0.12);
  }
  .nav-link.is-inactive {
    font-weight: 400;
    color: #737373;
  }
  .nav-link.is-inactive:hover {
    color: #171717;
    background-color: rgba(0, 0, 0, 0.04);
  }
  :global(.dark) .nav-link.is-inactive {
    color: #a3a3a3;
  }
  :global(.dark) .nav-link.is-inactive:hover {
    color: #ededed;
    background-color: rgba(255, 255, 255, 0.06);
  }
</style>

<script>
  function syncActiveNav(targetHref?: string) {
    const navItems = document.querySelectorAll<HTMLAnchorElement>('[data-nav-item]')
    const path = (targetHref !== undefined ? targetHref : window.location.pathname).replace(/\/$/, '') || '/'

    function checkActive(href: string, targetPath: string) {
      if (href === '/') {
        return targetPath === '/' || targetPath.startsWith('/posts') || /^\/\d+/.test(targetPath)
      }
      return targetPath === href || targetPath.startsWith(`${href}/`)
    }

    navItems.forEach((item) => {
      const itemHref = (item.getAttribute('data-href') || item.getAttribute('href') || '').replace(/\/$/, '') || '/'
      const active = checkActive(itemHref, path)
      item.classList.toggle('is-active', active)
      item.classList.toggle('is-inactive', !active)
    })
  }

  // 1. 点击时立即切换选中状态（0ms即时反馈）
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-nav-item]')
    if (target) {
      const href = target.getAttribute('data-href') || target.getAttribute('href') || ''
      syncActiveNav(href)
      return
    }

    // 如果点击了首页Logo，也将导航高亮切到“文章/首页”
    const logoTarget = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-nav-logo]')
    if (logoTarget) {
      syncActiveNav('/')
    }
  })

  // 2. 监听 Swup 与浏览器历史事件，确保路由切换完成后高亮 100% 同步准确
  document.addEventListener('astro:page-load', () => syncActiveNav())
  document.addEventListener('astro:after-swap', () => syncActiveNav())
  window.addEventListener('popstate', () => syncActiveNav())
  document.addEventListener('DOMContentLoaded', () => syncActiveNav())
  syncActiveNav()
</script>
