---
import { themeConfig } from '~/.config'
import { getSocialIconClass } from '~/utils/socialIcons'

const { navLinks, socialLinks } = themeConfig.site
const { translate: t } = Astro.locals
---

<nav class="site-nav">
  <ul class="nav-menu">
    {
      navLinks.map((nav) => (
        <li>
          <a class="nav-item" href={nav.href}>
            {t(nav.name)}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="nav-separator" role="presentation"></div>

  <ul class="social-menu">
    {
      socialLinks.map(({ href, name }) => (
        <li>
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            title={name}
            class="social-item"
          >
            <span class:list={[getSocialIconClass(name), 'w-4 h-4']} aria-hidden="true" />
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-menu,
  .social-menu {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-menu {
    gap: 0.25rem;
  }

  .social-menu {
    gap: 0.25rem;
  }

  .nav-item {
    font-size: 0.875rem;
    font-weight: 400;
    color: currentColor;
    opacity: 0.65;
    padding: 0.35rem 0.65rem;
    border-radius: 6px;
    text-decoration: none !important;
    letter-spacing: 0.02em;
    transition: all 0.2s ease;
  }

  .nav-item:hover {
    opacity: 1;
    color: var(--uno-colors-primary, currentColor);
    background-color: rgba(125, 125, 125, 0.08);
  }

  .nav-separator {
    width: 1px;
    height: 1rem;
    background-color: rgba(125, 125, 125, 0.2);
    margin: 0 0.25rem;
  }

  .social-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem;
    border-radius: 6px;
    color: currentColor;
    opacity: 0.55;
    text-decoration: none !important;
    transition: all 0.2s ease;
  }

  .social-item:hover {
    opacity: 1;
    color: var(--uno-colors-primary, currentColor);
    background-color: rgba(125, 125, 125, 0.08);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .site-nav {
      width: 100%;
      justify-content: space-between;
    }
    .nav-separator {
      display: none;
    }
  }
</style>
