---
import { themeConfig } from '~/.config'
import { getSocialIconClass } from '~/utils/socialIcons'

const { navLinks, socialLinks } = themeConfig.site
const { translate: t } = Astro.locals
const currentPath = Astro.url.pathname

const navLabels: Record<string, string> = {
  Posts: '文章',
  Journey: '轨迹',
  Links: '链接',
  About: '关于',
}

function isNavActive(href: string) {
  if (href === '/') {
    return currentPath === '/' || currentPath.startsWith('/posts') || /^\/\d+/.test(currentPath)
  }
  return currentPath.startsWith(href)
}
---

<nav class="flex items-center gap-1 sm:gap-4 text-xs font-sans shrink-0">
  <ul class="flex items-center gap-0.5 sm:gap-1.5 m-0 p-0 list-none">
    {
      navLinks.map((nav) => {
        const label = navLabels[nav.name] ?? t(nav.name)
        const active = isNavActive(nav.href)
        return (
          <li>
            <a
              class:list={[
                'not-underline-hover px-1.5 sm:px-2.5 py-0.8 rounded-md transition-all duration-200 block text-[12px] sm:text-[13px]',
                active
                  ? 'font-medium text-neutral-900 dark:text-neutral-100 bg-black/[0.05] dark:bg-white/[0.08]'
                  : 'text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-200 hover:bg-black/[0.03] dark:hover:bg-white/[0.04]',
              ]}
              href={nav.href}
            >
              {label}
            </a>
          </li>
        )
      })
    }
  </ul>

  <div class="hidden sm:block h-3 w-[1px] bg-black/10 dark:bg-white/10 mx-0.5 select-none"></div>

  <div class="flex items-center gap-1 sm:gap-2.5">
    <button
      type="button"
      data-search-open
      class="flex items-center gap-1 text-[11px] text-neutral-400 hover:text-neutral-700 dark:text-neutral-500 dark:hover:text-neutral-300 transition-colors bg-transparent border-0 cursor-pointer p-1 rounded"
      title="全局搜索 (⌘K)"
    >
      <span class="i-tabler-search w-3.5 h-3.5" aria-hidden="true"></span>
      <span
        class="text-[10px] font-mono px-1 py-0.2 border border-black/10 dark:border-white/15 rounded bg-black/[0.02] dark:bg-white/[0.04] hidden sm:inline"
        >⌘K</span
      >
    </button>

    <ul class="hidden sm:flex items-center gap-1 m-0 p-0 list-none">
      {
        socialLinks.map(({ href, name }) => (
          <li>
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              title={name}
              class="text-neutral-400 hover:text-neutral-700 dark:text-neutral-500 dark:hover:text-neutral-200 transition-all p-1 inline-flex items-center justify-center rounded not-underline-hover hover:bg-black/[0.03] dark:hover:bg-white/[0.05]"
            >
              <span class:list={[getSocialIconClass(name), 'w-3.5 h-3.5']} aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
