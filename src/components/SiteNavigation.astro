---
import { themeConfig } from '~/.config'
import { getSocialIconClass } from '~/utils/socialIcons'

const { navLinks, socialLinks } = themeConfig.site
const { translate: t } = Astro.locals
const currentPath = Astro.url.pathname

const navLabels: Record<string, { num: string; zh: string; en: string }> = {
  Posts: { num: '01', zh: '目录', en: 'Essays' },
  Journey: { num: '02', zh: '轨迹', en: 'Journey' },
  Links: { num: '03', zh: '友人', en: 'Links' },
  About: { num: '04', zh: '题记', en: 'About' },
}

function isNavActive(href: string) {
  if (href === '/') {
    return currentPath === '/' || currentPath.startsWith('/posts') || /^\/\d+/.test(currentPath)
  }
  return currentPath.startsWith(href)
}
---

<nav
  class="editorial-nav flex flex-wrap items-center justify-between gap-y-2 text-xs font-serif tracking-wider uppercase py-2.5 hairline-y text-[var(--paper-sub)]"
>
  <ul class="flex items-center gap-5 sm:gap-8 m-0 p-0 list-none">
    {
      navLinks.map((nav) => {
        const item = navLabels[nav.name] ?? { num: '', zh: t(nav.name), en: nav.name }
        const active = isNavActive(nav.href)
        return (
          <li>
            <a
              class:list={[
                'editorial-nav-link not-underline-hover transition-colors pb-0.5',
                active
                  ? 'text-[var(--paper-rust)] font-semibold border-b-2 border-[var(--paper-rust)]'
                  : 'hover:text-[var(--uno-colors-primary)] text-[var(--paper-sub)]',
              ]}
              href={nav.href}
            >
              <span class="nav-num font-mono opacity-65 mr-1">{item.num}.</span>
              <span>{item.zh}</span>
              <span class="nav-en font-sans text-[10px] opacity-65 ml-1 hidden sm:inline">{item.en}</span>
            </a>
          </li>
        )
      })
    }
  </ul>

  <div class="flex items-center gap-3 sm:gap-4 text-xs font-mono">
    <button
      type="button"
      data-search-open
      class="hover:text-[var(--uno-colors-primary)] flex items-center gap-1.5 transition-colors text-[11px] bg-transparent border-0 cursor-pointer p-0 text-[var(--paper-muted)]"
      title="检索"
    >
      <span>检索</span>
      <span class="text-[10px] px-1 py-0.5 border border-[var(--paper-border)] rounded bg-[var(--paper-card)]">⌘K</span>
    </button>
    <span class="text-[var(--paper-border)] select-none">|</span>
    <ul class="flex items-center gap-2.5 m-0 p-0 list-none">
      {
        socialLinks.map(({ href, name }) => (
          <li>
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              title={name}
              class="hover:text-[var(--uno-colors-primary)] text-[var(--paper-muted)] transition-colors inline-flex items-center justify-center p-0.5 not-underline-hover"
            >
              <span class:list={[getSocialIconClass(name), 'w-3.5 h-3.5']} aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .editorial-nav-link {
    display: inline-flex;
    align-items: baseline;
    text-decoration: none !important;
  }
</style>
