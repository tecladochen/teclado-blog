---
import { themeConfig } from '~/.config'
import '@waline/client/style'
import '~/styles/reading-design.css'

interface Props {
  path: string
  heading?: string
  description?: string
  placeholder?: string
}

const waline = themeConfig.comment?.waline

if (!waline) {
  throw new Error('Waline comments are not configured')
}

const {
  path,
  heading = '评论',
  description = '欢迎留下你的想法，留言将在审核后显示。',
  placeholder = '写下你的想法…',
} = Astro.props
const headingId = `waline-heading-${path.replace(/^\/+|\/+$/g, '').replaceAll('/', '-') || 'root'}`
---

<section class="waline-section reading-design" aria-labelledby={headingId}>
  <header class="waline-heading">
    <h2 id={headingId}>{heading}</h2>
    <p>{description}</p>
  </header>
  <div class="waline-frame">
    <div id="waline" data-path={path} data-server-url={waline.serverURL} data-placeholder={placeholder}></div>
  </div>
</section>

<script>
  import type { WalineInstance } from '@waline/client'

  declare global {
    interface Window {
      __tecladoWaline?: WalineInstance | null
      __tecladoWalineSetup?: () => void
      __tecladoWalineAvatarObserver?: MutationObserver
      __tecladoWalineVisibilityObserver?: IntersectionObserver
    }
  }

  function getAvatarInitial(nick: string) {
    return Array.from(nick.trim())[0]?.toLocaleUpperCase() ?? '访'
  }

  function setupCommentAvatars(el: HTMLElement) {
    const prepareAvatar = (avatar: HTMLImageElement) => {
      if (avatar.dataset.tecladoAvatarReady)
        return

      avatar.dataset.tecladoAvatarReady = 'true'

      const user = avatar.closest<HTMLElement>('.wl-user')
      const item = avatar.closest<HTMLElement>('.wl-card-item')
      const nick = item?.querySelector<HTMLElement>(':scope > .wl-card .wl-nick')?.textContent?.trim() ?? ''

      if (!user || !nick)
        return

      user.dataset.avatarInitial = getAvatarInitial(nick)
      user.dataset.avatarTone = String(
        Array.from(nick).reduce((sum, char) => sum + (char.codePointAt(0) ?? 0), 0) % 3,
      )

      const showFallback = () => {
        user.dataset.avatarFallback = 'true'
      }

      avatar.addEventListener('error', showFallback, { once: true })

      // Waline uses Libravatar for email-based avatars. Asking Libravatar to
      // return 404 keeps real avatars intact while letting us replace only its
      // unrelated blue placeholder with a local, theme-aware fallback.
      try {
        const avatarURL = new URL(avatar.src)

        if (
          avatarURL.hostname === 'seccdn.libravatar.org'
          && !avatarURL.searchParams.has('d')
          && !avatarURL.searchParams.has('default')
        ) {
          avatarURL.searchParams.set('d', '404')
          avatar.src = avatarURL.toString()
        }
      }
      catch {
        // Keep non-standard avatar URLs untouched. The error listener above
        // still provides a local fallback if they fail to load.
      }

      if (avatar.complete && avatar.naturalWidth === 0)
        showFallback()
    }

    const prepareAllAvatars = (root: ParentNode) => {
      root.querySelectorAll<HTMLImageElement>('.wl-user-avatar').forEach(prepareAvatar)
    }

    window.__tecladoWalineAvatarObserver?.disconnect()
    prepareAllAvatars(el)

    window.__tecladoWalineAvatarObserver = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        mutation.addedNodes.forEach((node) => {
          if (!(node instanceof HTMLElement))
            return

          if (node.matches('.wl-user-avatar'))
            prepareAvatar(node as HTMLImageElement)

          prepareAllAvatars(node)
        })
      })
    })
    window.__tecladoWalineAvatarObserver.observe(el, { childList: true, subtree: true })
  }

  async function mountWaline(el: HTMLElement) {
    const { init } = await import('@waline/client')

    if (!el.isConnected || document.querySelector('#waline') !== el)
      return

    window.__tecladoWaline = init({
      el,
      serverURL: el.dataset.serverUrl ?? '',
      path: el.dataset.path ?? window.location.pathname,
      lang: 'zh-CN',
      dark: 'html.dark',
      login: 'enable',
      requiredMeta: ['nick', 'mail'],
      wordLimit: 1000,
      pageSize: 10,
      commentSorting: 'latest',
      comment: false,
      pageview: false,
      reaction: false,
      search: false,
      imageUploader: false,
      noRss: true,
      locale: {
        placeholder: el.dataset.placeholder ?? '写下你的想法…',
      },
    })

    // Waline keeps preview mode open when the emoji button is pressed. Switch
    // back to the editor first so the emoji picker always responds directly.
    el.addEventListener(
      'click',
      (event) => {
        const target = event.target as HTMLElement | null
        const emojiButton = target?.closest<HTMLButtonElement>('.wl-action[title="表情"]')

        if (!emojiButton)
          return

        el.querySelector<HTMLButtonElement>('.wl-action[title="预览"].active')?.click()
      },
      true,
    )

    setupCommentAvatars(el)
  }

  function setupWaline() {
    const el = document.querySelector<HTMLElement>('#waline')

    window.__tecladoWalineVisibilityObserver?.disconnect()
    delete window.__tecladoWalineVisibilityObserver

    if (!el) {
      window.__tecladoWalineAvatarObserver?.disconnect()
      delete window.__tecladoWalineAvatarObserver
      window.__tecladoWaline?.destroy()
      delete window.__tecladoWaline
      return
    }

    if (window.__tecladoWaline?.el === el)
      return

    window.__tecladoWaline?.destroy()
    delete window.__tecladoWaline

    if (!('IntersectionObserver' in window)) {
      void mountWaline(el)
      return
    }

    window.__tecladoWalineVisibilityObserver = new IntersectionObserver(
      (entries, observer) => {
        if (!entries.some(entry => entry.isIntersecting))
          return

        observer.disconnect()
        delete window.__tecladoWalineVisibilityObserver
        void mountWaline(el)
      },
      { rootMargin: '800px 0px' },
    )
    window.__tecladoWalineVisibilityObserver.observe(el)
  }

  if (window.__tecladoWalineSetup)
    document.removeEventListener('astro:page-load', window.__tecladoWalineSetup)

  window.__tecladoWalineSetup = setupWaline
  document.addEventListener('astro:page-load', setupWaline)
  setupWaline()
</script>

<style is:global>
  .waline-section {
    margin-top: 0;
  }

  .waline-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }

  .waline-heading h2 {
    margin: 0;
    color: var(--reading-ink);
    font-family: var(--reading-serif);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.5;
  }

  .waline-heading p {
    margin: 0;
    color: var(--reading-muted);
    font-size: 0.74rem;
    line-height: 1.6;
    text-align: right;
  }

  .waline-frame {
    border-top: 1px solid var(--reading-rule);
    padding-top: 1rem;
  }

  #waline {
    --waline-theme-color: var(--reading-accent);
    --waline-active-color: var(--reading-hover-ink);
    --waline-color: var(--reading-ink);
    --waline-bg-color: var(--reading-surface);
    --waline-bg-color-light: var(--reading-hover);
    --waline-bg-color-hover: var(--reading-hover);
    --waline-border-color: var(--reading-rule);
    --waline-disable-bg-color: rgba(105, 100, 96, 0.08);
    --waline-disable-color: var(--reading-muted);
    --waline-code-bg-color: rgba(105, 100, 96, 0.08);
    --waline-info-bg-color: var(--reading-hover);
    --waline-info-color: var(--reading-muted);
    --waline-font-size: 1rem;
    --waline-avatar-size: 2.75rem;
    --comment-like-color: #a75450;
    --comment-like-hover: #8f413e;
    font-family: var(--reading-sans);
  }

  .dark #waline {
    --waline-theme-color: #d0a49a;
    --waline-active-color: #e3bbb2;
    --waline-bg-color-light: rgba(255, 255, 255, 0.045);
    --waline-bg-color-hover: rgba(255, 255, 255, 0.065);
    --waline-disable-bg-color: rgba(255, 255, 255, 0.06);
    --waline-code-bg-color: rgba(255, 255, 255, 0.06);
    --waline-info-bg-color: rgba(255, 255, 255, 0.045);
    --comment-like-color: #d58b86;
    --comment-like-hover: #e5aaa5;
  }

  #waline .wl-panel {
    overflow: visible;
    margin: 0;
    border: 1px solid var(--reading-rule);
    border-radius: 0.45rem;
    background: color-mix(in srgb, var(--reading-surface) 62%, transparent);
    box-shadow: none;
    transition:
      border-color 200ms ease,
      background-color 200ms ease;
  }

  #waline .wl-panel:focus-within {
    border-color: color-mix(in srgb, var(--reading-accent) 58%, var(--reading-rule));
    background: color-mix(in srgb, var(--reading-surface) 82%, transparent);
  }

  #waline .wl-header {
    border-bottom: 1px solid var(--reading-rule);
    background: color-mix(in srgb, var(--reading-surface) 28%, transparent);
  }

  #waline .wl-header-item {
    position: relative;
    padding: 0;
    color: var(--reading-secondary);
    transition: color 180ms ease;
  }

  #waline .wl-header-item:not(:last-child) {
    border-right-color: var(--reading-rule);
  }

  #waline .wl-header-item::after {
    position: absolute;
    right: 0.85rem;
    bottom: -1px;
    left: 0.85rem;
    height: 1px;
    background: var(--reading-accent);
    content: '';
    opacity: 0;
    transform: scaleX(0.25);
    transform-origin: center;
    transition:
      opacity 180ms ease,
      transform 260ms var(--reading-ease);
  }

  #waline .wl-header-item:focus-within::after {
    opacity: 0.7;
    transform: scaleX(1);
  }

  #waline .wl-header-item label {
    padding: 0.82rem 0.35rem 0.82rem 0.9rem;
    color: var(--reading-muted);
    font-size: 0.72rem;
    line-height: 1.4;
    white-space: nowrap;
    transition: color 180ms ease;
  }

  #waline .wl-header-item:focus-within label {
    color: var(--reading-accent);
  }

  #waline .wl-header .wl-input {
    box-sizing: border-box;
    padding: 0.78rem 0.9rem 0.78rem 0.35rem;
    background: transparent;
    font-size: 0.84rem;
    line-height: 1.5;
  }

  #waline .wl-header .wl-input:focus {
    background: transparent;
  }

  #waline .wl-input,
  #waline .wl-editor {
    color: var(--reading-ink);
    font-size: 0.88rem;
  }

  #waline :is(.wl-input, .wl-editor)::placeholder {
    color: var(--reading-muted);
    opacity: 0.72;
  }

  #waline .wl-editor {
    min-height: 7.25rem;
    padding: 1rem 0.9rem;
    line-height: 1.8;
  }

  #waline .wl-preview {
    padding: 0.2rem 0.9rem 0.8rem;
  }

  #waline .wl-preview h4 {
    margin: 0 0 0.45rem;
    color: var(--reading-secondary);
    font-size: 0.76rem;
    font-weight: 500;
  }

  #waline .wl-preview .wl-content {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    min-height: 6.6rem;
    padding: 0.75rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--reading-rule) 72%, transparent);
    border-radius: 0.3rem;
    background: color-mix(in srgb, var(--reading-surface) 72%, transparent);
    color: var(--reading-ink);
    font-size: 0.88rem;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  #waline .wl-footer {
    padding: 0.65rem 0.75rem;
    border-top: 1px solid var(--reading-rule);
    border-radius: 0 0 0.45rem 0.45rem;
    background: color-mix(in srgb, var(--reading-surface) 38%, transparent);
  }

  #waline .wl-emoji-popup {
    inset-inline: 0;
    top: calc(100% + 0.5rem);
    box-sizing: border-box;
    width: auto;
    max-width: none;
    border-color: var(--reading-rule);
    background: var(--reading-surface);
    box-shadow: 0 0.75rem 2rem color-mix(in srgb, var(--reading-ink) 10%, transparent);
  }

  #waline .wl-emoji-popup .wl-tab-wrapper {
    scrollbar-color: color-mix(in srgb, var(--reading-accent) 52%, transparent) transparent;
  }

  #waline .wl-emoji-popup .wl-tab.active {
    background: var(--reading-surface);
  }

  #waline .wl-text-number {
    display: none;
  }

  #waline .wl-action[title='Markdown Guide'] {
    display: none;
  }

  #waline .wl-btn {
    border-radius: 0.2rem;
    font-size: 0.78rem;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease,
      transform 320ms var(--reading-ease);
  }

  #waline .wl-btn:hover {
    transform: translateY(-1px);
  }

  #waline .wl-btn.primary {
    border-color: var(--reading-accent);
    background: var(--reading-accent);
    color: #fff;
    box-shadow: none;
  }

  #waline .wl-btn.primary:hover {
    border-color: var(--reading-hover-ink);
    background: var(--reading-hover-ink);
  }

  .dark #waline .wl-btn.primary {
    border-color: #d0a49a;
    background: #d0a49a;
    color: #231c1a;
  }

  .dark #waline .wl-btn.primary:hover {
    border-color: #e3bbb2;
    background: #e3bbb2;
  }

  #waline .wl-card {
    border-bottom-color: var(--reading-rule);
  }

  #waline .wl-user {
    position: relative;
  }

  #waline .wl-user[data-avatar-fallback='true'] .wl-user-avatar {
    visibility: hidden;
  }

  #waline .wl-user[data-avatar-fallback='true']::before {
    display: grid;
    position: absolute;
    inset-block-start: calc(var(--avatar-size) * 0.06);
    inset-inline-start: calc(var(--avatar-size) * 0.06);
    box-sizing: border-box;
    width: calc(var(--avatar-size) * 0.88);
    height: calc(var(--avatar-size) * 0.88);
    place-items: center;
    border: 0;
    border-radius: 27%;
    background: color-mix(in srgb, var(--reading-accent) 9%, var(--reading-surface));
    color: color-mix(in srgb, var(--reading-accent) 68%, var(--reading-secondary));
    content: attr(data-avatar-initial);
    font-family: var(--reading-sans);
    font-size: calc(var(--avatar-size) * 0.34);
    font-weight: 600;
    line-height: 1;
  }

  #waline .wl-user[data-avatar-fallback='true'][data-avatar-tone='1']::before {
    background: color-mix(in srgb, var(--reading-accent) 11%, var(--reading-surface));
  }

  #waline .wl-user[data-avatar-fallback='true'][data-avatar-tone='2']::before {
    background: color-mix(in srgb, var(--reading-secondary) 7%, var(--reading-surface));
  }

  #waline .wl-card .wl-nick {
    color: var(--reading-ink);
    font-family: var(--reading-serif);
    font-size: 0.86rem;
    font-weight: 600;
  }

  #waline .wl-card .wl-time,
  #waline .wl-card .wl-meta {
    color: var(--reading-muted);
    font-size: 0.72rem;
  }

  #waline .wl-card .wl-comment-actions {
    display: flex;
    align-items: center;
    gap: 0.08rem;
  }

  #waline .wl-card :is(.wl-like, .wl-reply) {
    box-sizing: border-box;
    min-height: 1.55rem;
    padding: 0.2rem 0.28rem;
    border-radius: 0.28rem;
    color: color-mix(in srgb, var(--reading-muted) 86%, var(--reading-ink));
    font-family: var(--reading-sans);
    font-size: 0.66rem;
    gap: 0.12rem;
    opacity: 0.82;
    transition:
      color 180ms ease,
      background-color 180ms ease,
      opacity 180ms ease;
  }

  #waline .wl-card :is(.wl-like, .wl-reply) svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  #waline .wl-card .wl-like svg path {
    fill: currentColor;
  }

  #waline .wl-card .wl-like {
    color: var(--comment-like-color);
    opacity: 0.9;
  }

  #waline .wl-card .wl-reply {
    color: var(--comment-like-color);
    opacity: 0.9;
  }

  #waline .wl-card .wl-reply:is(:hover, :focus-visible) {
    background: color-mix(in srgb, var(--comment-like-color) 8%, transparent);
    color: var(--comment-like-hover);
    opacity: 1;
    outline: none;
  }

  #waline .wl-card .wl-reply.active {
    background: color-mix(in srgb, var(--comment-like-color) 10%, transparent);
    color: var(--comment-like-hover);
    opacity: 1;
  }

  #waline .wl-card .wl-like:is(:hover, :focus-visible) {
    background: color-mix(in srgb, var(--comment-like-color) 8%, transparent);
    color: var(--comment-like-hover);
    opacity: 1;
    outline: none;
  }

  #waline .wl-card .wl-like.active {
    background: color-mix(in srgb, var(--comment-like-color) 10%, transparent);
    color: var(--comment-like-color);
    opacity: 1;
  }

  #waline .wl-card .wl-content {
    color: var(--reading-secondary);
    font-size: 0.9rem;
    line-height: 1.85;
  }

  #waline .wl-count {
    visibility: hidden;
    width: 0;
  }

  #waline .wl-sort li {
    color: var(--reading-muted);
    font-size: 0.72rem;
  }

  #waline .wl-empty {
    min-height: 4.5rem;
    margin-top: 0;
    border: 0;
    border-bottom: 1px solid var(--reading-rule);
    background: transparent;
    color: var(--reading-muted);
    font-family: var(--reading-serif);
    font-size: 0.82rem;
  }

  #waline .wl-power {
    color: var(--reading-muted);
    font-size: 0.66rem;
    opacity: 0.7;
  }

  @media (max-width: 640px) {
    .waline-heading {
      display: block;
    }

    .waline-heading p {
      margin-top: 0.2rem;
      text-align: left;
    }

    #waline {
      --waline-avatar-size: 2.35rem;
    }

    #waline .wl-editor {
      min-height: 6.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #waline .wl-btn {
      transition: none;
      transform: none !important;
    }
  }
</style>
