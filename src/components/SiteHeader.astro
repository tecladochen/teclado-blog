---
import { site } from '~/site'

const current = Astro.url.pathname.replace(/\/$/, '') || '/'

function isCurrent(href: string) {
  const path = href.replace(/\/$/, '') || '/'
  if (path === '/') return current === '/'
  if (path === '/writing') return current === '/writing' || current.startsWith('/posts')
  return current === path || current.startsWith(`${path}/`)
}
---

<header class="site-header" data-header>
  <a class="brand" href="/">
    <span class="brand-title">{site.title}</span>
    <span class="brand-sub">{site.subtitle}</span>
  </a>
  <nav class="nav" aria-label="站点">
    {
      site.nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.name}
        </a>
      ))
    }
    <button class="seal" type="button" data-theme-toggle aria-label="切换昼夜">
      <span data-theme-label>昼</span>
    </button>
  </nav>
</header>
