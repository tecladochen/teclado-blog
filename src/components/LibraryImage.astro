---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface Props {
  image?: ImageMetadata
  title: string
  shape?: 'portrait' | 'square'
  icon?: string
  loading?: 'eager' | 'lazy'
  scale?: number
}

const { image, title, shape = 'portrait', icon = 'i-tabler-book', loading = 'lazy', scale = 1 } = Astro.props
// Keep smaller catalog covers at their original resolution.
const widths = image ? [...new Set([160, 240, 360, 480].map(width => Math.min(width, image.width)))] : []
const sizes = '(max-width: 560px) calc((100vw - 52px) / 2), (max-width: 639px) calc((100vw - 72px) / 3), (max-width: 760px) calc((100vw - 88px) / 3), (max-width: 880px) calc((100vw - 144px) / 5), 148px'
---

<div class:list={['library-image', `is-${shape}`]}>
  {image
    ? <Image src={image} alt={title} width={widths[widths.length - 1]} widths={widths} sizes={sizes} format="webp" quality={65} loading={loading} decoding="async" style={scale !== 1 ? `transform: scale(${scale})` : undefined} />
    : <span class:list={[icon, 'h-7 w-7']} aria-hidden="true" />}
</div>

<style>
  .library-image {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid var(--theme-border-subtle);
    background: var(--theme-accent-soft);
    color: var(--theme-muted);
    border-radius: 3px;
  }
  .is-portrait { aspect-ratio: 2 / 3; }
  .is-square { aspect-ratio: 1; }
  .library-image :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
