---
import type { CollectionEntry } from 'astro:content'
import { formatChineseDate, kindLabel } from '~/lib/content'

interface Props {
  post: CollectionEntry<'posts'>
  index?: string
}

const { post, index = '01' } = Astro.props
const titleName = `post-${post.id}`
---

<article class="featured" data-magnetic data-reveal>
  <a class="featured-visual" href={`/posts/${post.id}/`}>
    <span class="featured-kicker">{index} · {kindLabel(post.data.kind)}</span>
    <b aria-hidden="true">{index}</b>
  </a>
  <div class="featured-body">
    <p class="featured-kicker">此刻桌上只有这一篇</p>
    <h3>
      <a href={`/posts/${post.id}/`} style={`view-transition-name: ${titleName}`}>
        {post.data.title}
      </a>
    </h3>
    <p>{post.data.description}</p>
    <div class="featured-meta">
      <time datetime={post.data.pubDate.toISOString()}>
        {formatChineseDate(post.data.pubDate)}
      </time>
      <a class="text-link" href={`/posts/${post.id}/`}>打开这篇</a>
    </div>
  </div>
</article>
