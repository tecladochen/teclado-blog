---
import type { KnowledgeGraphData } from '~/types'

interface Props {
  data: KnowledgeGraphData
}

const { data } = Astro.props
const { translate: t } = Astro.locals
const categories = data.nodes.filter((node) => node.kind === 'category')
const series = data.nodes.filter((node) => node.kind === 'series')
const posts = data.nodes.filter((node) => node.kind === 'post')
const serializedData = JSON.stringify(data).replaceAll('<', '\\u003c')
---

<section
  class="knowledge-map"
  data-knowledge-map
  data-label-post={t('Posts')}
  data-label-category={t('Categories')}
  data-label-series={t('Series')}
  data-label-planned={t('map_planned')}
  data-label-no-selection={t('map_no_selection')}
  data-label-intro={t('knowledge_map_intro')}
>
  <div class="map-toolbar">
    <label>
      <span>{t('select')}</span>
      <select data-map-filter>
        <option value="all">{t('map_filter_all')}</option>
        <optgroup label={t('map_filter_category')}>
          {categories.map((node) => <option value={node.id}>{node.label}</option>)}
        </optgroup>
        <optgroup label={t('map_filter_series')}>
          {series.map((node) => <option value={node.id}>{node.label}</option>)}
        </optgroup>
      </select>
    </label>

    <div class="map-tools">
      <button type="button" data-map-zoom-out aria-label={t('map_zoom_out')}>−</button>
      <button type="button" data-map-zoom-in aria-label={t('map_zoom_in')}>＋</button>
      <button type="button" data-map-reset>{t('map_reset')}</button>
    </div>
  </div>

  <div class="map-workspace">
    <div class="map-stage">
      <canvas data-map-canvas aria-hidden="true"></canvas>
      <div class="map-legend" aria-hidden="true">
        <span><i class="is-post"></i>{t('Posts')}</span>
        <span><i class="is-category"></i>{t('Categories')}</span>
        <span><i class="is-series"></i>{t('Series')}</span>
      </div>
      <noscript><p>{t('map_nodes')}</p></noscript>
    </div>

    <aside class="map-inspector" aria-live="polite">
      <span class="map-inspector-coordinate" data-map-detail-kind>NODE / —</span>
      <h2 data-map-detail-title>{t('map_no_selection')}</h2>
      <p data-map-detail-description>{t('knowledge_map_intro')}</p>
      <a href="/map" data-map-detail-link hidden>
        {t('map_open')}
        <span aria-hidden="true">→</span>
      </a>
    </aside>
  </div>

  <details class="map-node-index">
    <summary>{t('map_nodes')} / {data.nodes.length}</summary>
    <div>
      <section>
        <h2>{t('Categories')}</h2>
        <ul>
          {
            categories.map((node) => (
              <li>
                <a href={node.url}>{node.label}</a>
              </li>
            ))
          }
        </ul>
      </section>
      <section>
        <h2>{t('Series')}</h2>
        <ul>
          {
            series.map((node) => (
              <li>
                <a href={node.url}>{node.label}</a>
                {node.status === 'planned' && <small>{t('map_planned')}</small>}
              </li>
            ))
          }
        </ul>
      </section>
      <section>
        <h2>{t('Posts')}</h2>
        <ul>
          {
            posts.map((node) => (
              <li>
                <a href={node.url}>{node.label}</a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </details>

  <script is:inline type="application/json" data-map-data set:html={serializedData} />
</section>

<script>
  import type { KnowledgeGraphData, KnowledgeNode, KnowledgeNodeKind } from '~/types'

  interface LayoutNode extends KnowledgeNode {
    x: number
    y: number
    vx: number
    vy: number
    anchorX: number
    anchorY: number
    radius: number
  }

  type KnowledgeMapWindow = Window & {
    __knowledgeMapLifecycle?: AbortController
    __knowledgeMapCleanup?: () => void
  }

  const mapWindow = window as KnowledgeMapWindow
  mapWindow.__knowledgeMapLifecycle?.abort()
  const lifecycleController = new AbortController()
  mapWindow.__knowledgeMapLifecycle = lifecycleController

  function initializeKnowledgeMap() {
    mapWindow.__knowledgeMapCleanup?.()
    mapWindow.__knowledgeMapCleanup = undefined

    const root = document.querySelector<HTMLElement>('[data-knowledge-map]')
    if (!root) {
      return
    }

    const canvas = root.querySelector<HTMLCanvasElement>('[data-map-canvas]')
    const dataElement = root.querySelector<HTMLScriptElement>('[data-map-data]')
    const filter = root.querySelector<HTMLSelectElement>('[data-map-filter]')
    const title = root.querySelector<HTMLElement>('[data-map-detail-title]')
    const description = root.querySelector<HTMLElement>('[data-map-detail-description]')
    const kindLabel = root.querySelector<HTMLElement>('[data-map-detail-kind]')
    const detailLink = root.querySelector<HTMLAnchorElement>('[data-map-detail-link]')
    if (!canvas || !dataElement || !filter) {
      return
    }

    const canvasContext = canvas.getContext('2d')
    if (!canvasContext) {
      return
    }
    const context: CanvasRenderingContext2D = canvasContext

    const graph = JSON.parse(dataElement.textContent ?? '{}') as KnowledgeGraphData
    const nodes = createLayout(graph)
    const nodeMap = new Map(nodes.map((node) => [node.id, node]))
    const adjacency = new Map<string, Set<string>>()
    graph.edges.forEach((edge) => {
      const source = adjacency.get(edge.source) ?? new Set<string>()
      const target = adjacency.get(edge.target) ?? new Set<string>()
      source.add(edge.target)
      target.add(edge.source)
      adjacency.set(edge.source, source)
      adjacency.set(edge.target, target)
    })

    const controller = new AbortController()
    let frame = 0
    let width = 0
    let height = 0
    let dpr = 1
    let zoom = 1
    let offsetX = 0
    let offsetY = 0
    let selectedId = ''
    let hoveredId = ''
    let filterId = 'all'
    let pointerId: number | undefined
    let pointerStartX = 0
    let pointerStartY = 0
    let pointerOffsetX = 0
    let pointerOffsetY = 0
    let pointerMoved = false

    const labels: Record<KnowledgeNodeKind, string> = {
      post: root.dataset.labelPost ?? 'Post',
      category: root.dataset.labelCategory ?? 'Category',
      series: root.dataset.labelSeries ?? 'Series',
    }

    const getVisibleIds = () => {
      if (filterId === 'all') {
        return new Set(nodes.map((node) => node.id))
      }
      return new Set([filterId, ...(adjacency.get(filterId) ?? [])])
    }

    const requestDraw = () => {
      if (frame) {
        return
      }
      frame = requestAnimationFrame(() => {
        frame = 0
        draw()
      })
    }

    const resetView = () => {
      const fit = Math.min(width / 1000, height / 700)
      zoom = Math.max(0.42, Math.min(1.15, fit * 0.92))
      offsetX = width / 2 - 500 * zoom
      offsetY = height / 2 - 350 * zoom
      requestDraw()
    }

    const resize = () => {
      const rect = canvas.getBoundingClientRect()
      const previousWidth = width
      const previousHeight = height
      width = Math.max(1, rect.width)
      height = Math.max(1, rect.height)
      dpr = Math.min(window.devicePixelRatio || 1, 2)
      canvas.width = Math.round(width * dpr)
      canvas.height = Math.round(height * dpr)
      /* eslint-disable style/brace-style */
      if (!previousWidth || !previousHeight) {
        resetView()
      } else {
        offsetX += (width - previousWidth) / 2
        offsetY += (height - previousHeight) / 2
      }
      /* eslint-enable style/brace-style */
      requestDraw()
    }

    const worldToScreen = (node: LayoutNode) => ({
      x: node.x * zoom + offsetX,
      y: node.y * zoom + offsetY,
    })

    const hitTest = (clientX: number, clientY: number) => {
      const rect = canvas.getBoundingClientRect()
      const x = clientX - rect.left
      const y = clientY - rect.top
      const visibleIds = getVisibleIds()
      return [...nodes].reverse().find((node) => {
        if (!visibleIds.has(node.id)) {
          return false
        }
        const screen = worldToScreen(node)
        const hitRadius = Math.max(10, node.radius * zoom + 6)
        return Math.hypot(x - screen.x, y - screen.y) <= hitRadius
      })
    }

    const updateInspector = (node?: LayoutNode) => {
      if (!node) {
        kindLabel && (kindLabel.textContent = 'NODE / —')
        title && (title.textContent = root.dataset.labelNoSelection ?? '')
        description && (description.textContent = root.dataset.labelIntro ?? '')
        detailLink?.setAttribute('hidden', '')
        return
      }

      const status = node.status === 'planned' ? ` / ${root.dataset.labelPlanned ?? 'PLANNED'}` : ''
      kindLabel && (kindLabel.textContent = `${labels[node.kind].toUpperCase()}${status}`)
      title && (title.textContent = node.label)
      description && (description.textContent = node.description)
      if (detailLink) {
        detailLink.href = node.url
        detailLink.removeAttribute('hidden')
      }
    }

    const selectNode = (node?: LayoutNode) => {
      selectedId = node?.id ?? ''
      updateInspector(node)
      requestDraw()
    }

    const zoomAt = (factor: number, x = width / 2, y = height / 2) => {
      const nextZoom = Math.max(0.35, Math.min(2.4, zoom * factor))
      const worldX = (x - offsetX) / zoom
      const worldY = (y - offsetY) / zoom
      offsetX = x - worldX * nextZoom
      offsetY = y - worldY * nextZoom
      zoom = nextZoom
      requestDraw()
    }

    function draw() {
      context.setTransform(dpr, 0, 0, dpr, 0, 0)
      context.clearRect(0, 0, width, height)
      const styles = getComputedStyle(document.body)
      const primary = styles.color || '#2e405b'
      const background = styles.backgroundColor || '#fff'
      const visibleIds = getVisibleIds()
      const focusId = hoveredId || selectedId
      const focusedIds = focusId ? new Set([focusId, ...(adjacency.get(focusId) ?? [])]) : visibleIds

      context.lineWidth = 1
      for (const edge of graph.edges) {
        if (!visibleIds.has(edge.source) || !visibleIds.has(edge.target)) {
          continue
        }
        const source = nodeMap.get(edge.source)
        const target = nodeMap.get(edge.target)
        if (!source || !target) {
          continue
        }
        const start = worldToScreen(source)
        const end = worldToScreen(target)
        const highlighted = !focusId || (focusedIds.has(edge.source) && focusedIds.has(edge.target))
        context.globalAlpha = highlighted ? 0.3 : 0.07
        context.strokeStyle = primary
        context.beginPath()
        context.moveTo(start.x, start.y)
        context.lineTo(end.x, end.y)
        context.stroke()
      }

      for (const node of nodes) {
        if (!visibleIds.has(node.id)) {
          continue
        }
        const point = worldToScreen(node)
        const highlighted = !focusId || focusedIds.has(node.id)
        const active = node.id === selectedId || node.id === hoveredId
        const radius = Math.max(2.5, node.radius * zoom) + (active ? 2 : 0)
        context.globalAlpha = highlighted ? 1 : 0.18
        context.strokeStyle = primary
        context.fillStyle = node.status === 'planned' ? background : primary
        context.lineWidth = active ? 2 : 1
        context.setLineDash(node.status === 'planned' ? [3, 3] : [])
        drawNodeShape(context, node.kind, point.x, point.y, radius)
        context.fill()
        context.stroke()
        context.setLineDash([])

        const shouldLabel = node.kind !== 'post' || active || zoom > 1.05
        if (shouldLabel) {
          context.globalAlpha = highlighted ? 0.88 : 0.15
          context.fillStyle = primary
          context.font = `${active ? 700 : 500} ${Math.max(10, Math.min(13, 11 * zoom))}px sans-serif`
          context.textAlign = 'center'
          context.textBaseline = 'top'
          context.fillText(trimCanvasLabel(context, node.label, 128), point.x, point.y + radius + 5)
        }
      }
      context.globalAlpha = 1
    }

    canvas.addEventListener(
      'pointerdown',
      (event) => {
        pointerId = event.pointerId
        pointerStartX = event.clientX
        pointerStartY = event.clientY
        pointerOffsetX = offsetX
        pointerOffsetY = offsetY
        pointerMoved = false
        canvas.setPointerCapture(event.pointerId)
        canvas.classList.add('is-dragging')
      },
      { signal: controller.signal },
    )

    canvas.addEventListener(
      'pointermove',
      (event) => {
        if (pointerId === event.pointerId) {
          const dx = event.clientX - pointerStartX
          const dy = event.clientY - pointerStartY
          pointerMoved ||= Math.hypot(dx, dy) > 4
          if (pointerMoved) {
            offsetX = pointerOffsetX + dx
            offsetY = pointerOffsetY + dy
            requestDraw()
          }
          return
        }
        const node = hitTest(event.clientX, event.clientY)
        const nextHoveredId = node?.id ?? ''
        if (nextHoveredId !== hoveredId) {
          hoveredId = nextHoveredId
          canvas.style.cursor = node ? 'pointer' : 'grab'
          requestDraw()
        }
      },
      { signal: controller.signal },
    )

    canvas.addEventListener(
      'pointerup',
      (event) => {
        if (pointerId !== event.pointerId) {
          return
        }
        if (!pointerMoved) {
          selectNode(hitTest(event.clientX, event.clientY))
        }
        pointerId = undefined
        canvas.classList.remove('is-dragging')
        canvas.releasePointerCapture(event.pointerId)
      },
      { signal: controller.signal },
    )

    canvas.addEventListener(
      'pointercancel',
      () => {
        pointerId = undefined
        canvas.classList.remove('is-dragging')
      },
      { signal: controller.signal },
    )

    canvas.addEventListener(
      'pointerleave',
      () => {
        if (pointerId === undefined && hoveredId) {
          hoveredId = ''
          requestDraw()
        }
      },
      { signal: controller.signal },
    )

    canvas.addEventListener(
      'wheel',
      (event) => {
        event.preventDefault()
        const rect = canvas.getBoundingClientRect()
        zoomAt(event.deltaY < 0 ? 1.12 : 0.89, event.clientX - rect.left, event.clientY - rect.top)
      },
      { passive: false, signal: controller.signal },
    )

    filter.addEventListener(
      'change',
      () => {
        filterId = filter.value
        if (selectedId && !getVisibleIds().has(selectedId)) {
          selectNode()
        }
        requestDraw()
      },
      { signal: controller.signal },
    )

    root
      .querySelector('[data-map-zoom-in]')
      ?.addEventListener('click', () => zoomAt(1.2), { signal: controller.signal })
    root
      .querySelector('[data-map-zoom-out]')
      ?.addEventListener('click', () => zoomAt(0.82), { signal: controller.signal })
    root.querySelector('[data-map-reset]')?.addEventListener('click', resetView, { signal: controller.signal })

    const resizeObserver = new ResizeObserver(resize)
    resizeObserver.observe(canvas)
    const themeObserver = new MutationObserver(requestDraw)
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] })
    resize()

    mapWindow.__knowledgeMapCleanup = () => {
      controller.abort()
      resizeObserver.disconnect()
      themeObserver.disconnect()
      if (frame) {
        cancelAnimationFrame(frame)
      }
    }
  }

  function createLayout(graph: KnowledgeGraphData): LayoutNode[] {
    const kindRadius = { post: 4.5, category: 8.5, series: 9.5 }
    const nodes = [...graph.nodes]
      .sort((a, b) => a.id.localeCompare(b.id))
      .map((node) => {
        const seed = hashString(node.id)
        const angle = seededUnit(seed) * Math.PI * 2
        const ring = node.kind === 'category' ? 285 : node.kind === 'series' ? 175 : 90 + seededUnit(seed + 1) * 120
        const anchorX = 500 + Math.cos(angle) * ring
        const anchorY = 350 + Math.sin(angle) * ring * 0.78
        return {
          ...node,
          x: anchorX,
          y: anchorY,
          vx: 0,
          vy: 0,
          anchorX,
          anchorY,
          radius: kindRadius[node.kind],
        }
      })

    const nodeMap = new Map(nodes.map((node) => [node.id, node]))
    for (let iteration = 0; iteration < 180; iteration++) {
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i]
          const b = nodes[j]
          const dx = b.x - a.x
          const dy = b.y - a.y
          const distanceSquared = Math.max(120, dx * dx + dy * dy)
          const distance = Math.sqrt(distanceSquared)
          const force = 900 / distanceSquared
          const fx = (dx / distance) * force
          const fy = (dy / distance) * force
          a.vx -= fx
          a.vy -= fy
          b.vx += fx
          b.vy += fy
        }
      }

      for (const edge of graph.edges) {
        const source = nodeMap.get(edge.source)
        const target = nodeMap.get(edge.target)
        if (!source || !target) {
          continue
        }
        const dx = target.x - source.x
        const dy = target.y - source.y
        const distance = Math.max(1, Math.hypot(dx, dy))
        const force = (distance - 105) * 0.0025
        const fx = (dx / distance) * force
        const fy = (dy / distance) * force
        source.vx += fx
        source.vy += fy
        target.vx -= fx
        target.vy -= fy
      }

      for (const node of nodes) {
        const anchorForce = node.kind === 'post' ? 0.004 : 0.018
        node.vx += (node.anchorX - node.x) * anchorForce
        node.vy += (node.anchorY - node.y) * anchorForce
        node.vx *= 0.76
        node.vy *= 0.76
        node.x = Math.max(45, Math.min(955, node.x + node.vx))
        node.y = Math.max(45, Math.min(655, node.y + node.vy))
      }
    }
    return nodes
  }

  function drawNodeShape(
    context: CanvasRenderingContext2D,
    kind: KnowledgeNodeKind,
    x: number,
    y: number,
    radius: number,
  ) {
    context.beginPath()
    if (kind === 'category') {
      context.rect(x - radius, y - radius, radius * 2, radius * 2)
      return
    }
    if (kind === 'series') {
      context.moveTo(x, y - radius)
      context.lineTo(x + radius, y)
      context.lineTo(x, y + radius)
      context.lineTo(x - radius, y)
      context.closePath()
      return
    }
    context.arc(x, y, radius, 0, Math.PI * 2)
  }

  function trimCanvasLabel(context: CanvasRenderingContext2D, label: string, maxWidth: number) {
    if (context.measureText(label).width <= maxWidth) {
      return label
    }
    let value = label
    while (value.length > 1 && context.measureText(`${value}…`).width > maxWidth) {
      value = value.slice(0, -1)
    }
    return `${value}…`
  }

  function hashString(value: string) {
    let hash = 2166136261
    for (let index = 0; index < value.length; index++) {
      hash ^= value.charCodeAt(index)
      hash = Math.imul(hash, 16777619)
    }
    return hash >>> 0
  }

  function seededUnit(seed: number) {
    // eslint-disable-next-line unicorn/number-literal-case
    let value = seed + 0x6d2b79f5
    value = Math.imul(value ^ (value >>> 15), value | 1)
    value ^= value + Math.imul(value ^ (value >>> 7), value | 61)
    return ((value ^ (value >>> 14)) >>> 0) / 4294967296
  }

  initializeKnowledgeMap()
  document.addEventListener('astro:page-load', initializeKnowledgeMap, {
    signal: lifecycleController.signal,
  })
</script>

<style>
  .knowledge-map {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .map-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: flex-end;
    justify-content: space-between;
  }

  .map-toolbar label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: min(17rem, 100%);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    opacity: 0.76;
  }

  .map-toolbar select {
    width: 100%;
    padding: 0.42rem 0.55rem;
    border: 1px solid var(--uno-colors-shadow);
    border-radius: 0;
    color: inherit;
    background: var(--uno-colors-background);
    font: inherit;
    font-size: 0.78rem;
  }

  .map-tools {
    display: flex;
    gap: 0.35rem;
  }

  .map-tools button {
    min-width: 2rem;
    padding: 0.38rem 0.52rem;
    border: 1px solid var(--uno-colors-shadow);
    color: inherit;
    background: transparent;
    font: inherit;
    font-size: 0.7rem;
    cursor: pointer;
  }

  .map-tools button:hover,
  .map-tools button:focus-visible {
    color: var(--uno-colors-background);
    background: var(--uno-colors-primary);
    outline: none;
  }

  .map-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 12rem;
    min-height: 31rem;
    border: 1px solid currentColor;
  }

  .map-stage {
    position: relative;
    min-width: 0;
    min-height: 31rem;
    overflow: hidden;
    border-right: 1px solid var(--uno-colors-shadow);
    background-image: linear-gradient(var(--uno-colors-shadow) 1px, transparent 1px),
      linear-gradient(90deg, var(--uno-colors-shadow) 1px, transparent 1px);
    background-size: 3rem 3rem;
  }

  .map-stage canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: none;
  }

  .map-stage canvas.is-dragging {
    cursor: grabbing;
  }

  .map-legend {
    position: absolute;
    right: 0.55rem;
    bottom: 0.55rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding: 0.32rem 0.45rem;
    border: 1px solid var(--uno-colors-shadow);
    background: var(--uno-colors-background);
    font-size: 0.58rem;
    opacity: 0.76;
    pointer-events: none;
  }

  .map-legend span {
    display: flex;
    gap: 0.3rem;
    align-items: center;
  }

  .map-legend i {
    display: inline-block;
    width: 0.42rem;
    height: 0.42rem;
    border: 1px solid currentColor;
    background: currentColor;
  }

  .map-legend .is-post {
    border-radius: 999px;
  }

  .map-legend .is-series {
    transform: rotate(45deg);
  }

  .map-inspector {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    min-width: 0;
    padding: 1rem;
  }

  .map-inspector-coordinate {
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    opacity: 0.52;
  }

  .map-inspector h2 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .map-inspector p {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.65;
    opacity: 0.7;
  }

  .map-inspector a {
    align-self: flex-start;
    margin-top: auto;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .map-node-index {
    border-top: 1px solid var(--uno-colors-shadow);
    border-bottom: 1px solid var(--uno-colors-shadow);
  }

  .map-node-index summary {
    padding: 0.65rem 0;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
  }

  .map-node-index > div {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    padding: 0.25rem 0 1rem;
  }

  .map-node-index h2 {
    margin: 0 0 0.45rem;
    font-size: 0.75rem;
  }

  .map-node-index ul {
    margin: 0;
    padding: 0;
    font-size: 0.72rem;
    line-height: 1.55;
    list-style: none;
  }

  .map-node-index li + li {
    margin-top: 0.28rem;
  }

