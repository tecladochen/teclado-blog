---
import type { Post } from '~/types'
import { formatDate } from '~/utils'

interface Props {
  post: Post
  description: string
}

const { post, description } = Astro.props

const displayDate = post.data.modDate ?? post.data.pubDate
const dateStr = formatDate(displayDate, 'YYYY-MM-DD')
const categoryList = post.data.categories ?? []
---

<article class="article-entry flex flex-col gap-2 py-4 sm:py-5 group">
  <!-- 标题与悬浮反馈 -->
  <h2
    class="text-[19px] sm:text-[21px] font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 leading-snug m-0"
  >
    <a
      href={`/posts/${post.id}/`}
      class="not-underline-hover inline-block group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-200"
    >
      {post.data.title}
    </a>
  </h2>

  <!-- 元信息行：日期 + 分类标签胶囊 -->
  <div class="flex flex-wrap items-center gap-2 text-xs">
    <time datetime={dateStr} class="font-mono text-neutral-400 dark:text-neutral-500 tabular">
      {dateStr}
    </time>

    {
      categoryList.map((cat) => (
        <a
          href={`/categories/${cat}/`}
          class="not-underline-hover inline-flex items-center text-[11.5px] px-2 py-0.5 rounded bg-black/[0.04] dark:bg-white/[0.06] text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-200 hover:bg-black/[0.07] dark:hover:bg-white/[0.1] transition-colors"
        >
          <span class="opacity-40 mr-0.5">#</span>
          <span>{cat}</span>
        </a>
      ))
    }

    {
      post.data.series && (
        <span class="inline-flex items-center text-[11.5px] px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 font-mono">
          <span class="opacity-40 mr-0.5">§</span>
          <span>{post.data.series.name}</span>
        </span>
      )
    }
  </div>

  <!-- 摘要 -->
  {
    description && (
      <p class="text-[14px] sm:text-[14.5px] leading-[1.75] text-neutral-600 dark:text-neutral-400 line-clamp-3 m-0">
        {description}
      </p>
    )
  }
</article>
