---
import type { Post } from '~/types'
import { formatDate, getWordCountAndReadTime } from '~/utils'

interface Props {
  post: Post
  description?: string
}

const { post, description } = Astro.props
const dateYear = formatDate(post.data.pubDate, 'YYYY')
const dateMonthDay = formatDate(post.data.pubDate, 'MM.DD')
const { minutes } = getWordCountAndReadTime(post.body)
---

<article class="editorial-item">
  <a href={`/posts/${post.id}/`} class="editorial-link not-underline-hover">
    <div class="editorial-date">
      <time datetime={post.data.pubDate.toISOString()}>
        <span class="date-year">{dateYear}</span>
        <span class="date-month-day">{dateMonthDay}</span>
      </time>
      {post.data.pin && <span class="editorial-pin">置顶</span>}
    </div>
    <div class="editorial-main">
      <h2 class="editorial-title">{post.data.title}</h2>
      <span class="editorial-duration">{minutes} 分钟阅读</span>
    </div>
    <div class="editorial-content">
      {description && <p class="editorial-description line-clamp-3">{description}</p>}
    </div>
    <span class="editorial-arrow" aria-hidden="true">
      <svg viewBox="0 0 48 16" width="48" height="16" fill="none" stroke="currentColor" stroke-width="1.25">
        <path d="M1 8h43M37 2l7 6-7 6"></path>
      </svg>
    </span>
  </a>
</article>

<style>
  .editorial-item {
    min-width: 0;
    position: relative;
    counter-increment: article-index;
  }
  .editorial-link {
    position: relative;
    display: grid;
    grid-template-columns: 96px minmax(0, 1.15fr) minmax(16rem, 0.85fr);
    column-gap: 32px;
    min-height: 184px;
    padding: 30px 56px 30px 0;
    border-top: 1px solid var(--reading-rule);
    align-items: center;
    isolation: isolate;
  }
  .editorial-link::before {
    content: '';
    position: absolute;
    inset: 0 -12px 0 95px;
    z-index: -1;
    background: linear-gradient(90deg, var(--reading-wash), color-mix(in srgb, var(--reading-wash) 15%, transparent));
    clip-path: inset(0 100% 0 0);
    transition: clip-path 560ms var(--reading-ease);
  }
  .editorial-link::after {
    content: counter(article-index, decimal-leading-zero);
    position: absolute;
    right: 0;
    top: 25px;
    color: color-mix(in srgb, var(--reading-muted) 35%, transparent);
    font:
      10px/1 'JetBrains Mono',
      monospace;
  }
  .editorial-date {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 7px 18px 7px 0;
    border-right: 1px solid var(--reading-rule);
    color: var(--reading-muted);
    font-family: 'JetBrains Mono', monospace;
  }
  .editorial-date time {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-variant-numeric: tabular-nums;
  }
  .date-year {
    font-size: 10px;
    letter-spacing: 0.12em;
  }
  .date-month-day {
    color: var(--reading-ink);
    font-size: 19px;
    letter-spacing: -0.06em;
  }
  .editorial-pin {
    color: var(--reading-accent);
    font-size: 10px;
    letter-spacing: 0.16em;
  }
  .editorial-main {
    min-width: 0;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
  }
  .editorial-title {
    margin: 0;
    font-family: var(--reading-serif);
    font-size: clamp(25px, 3.15vw, 34px);
    font-weight: 700;
    line-height: 1.46;
    letter-spacing: -0.04em;
    text-wrap: pretty;
    overflow-wrap: anywhere;
    transition:
      color 220ms ease,
      transform 500ms var(--reading-ease);
  }
  .editorial-content {
    align-self: center;
    padding-left: 24px;
    border-left: 1px solid var(--reading-rule);
  }
  .editorial-description {
    margin: 0;
    color: var(--reading-secondary);
    font-size: 14px;
    line-height: 1.85;
  }
  .editorial-duration {
    color: var(--reading-muted);
    font-size: 11px;
    letter-spacing: 0.04em;
  }
  .editorial-arrow {
    position: absolute;
    right: 0;
    bottom: 27px;
    width: 30px;
    overflow: hidden;
    color: var(--reading-accent);
    transition: width 500ms var(--reading-ease);
  }
  .editorial-link:focus-visible {
    outline-offset: 5px;
  }
  @media (hover: hover) and (pointer: fine) {
    .editorial-link:hover::before,
    .editorial-link:focus-visible::before {
      clip-path: inset(0);
    }
    .editorial-link:is(:hover, :focus-visible) .editorial-title {
      color: var(--reading-accent);
      transform: translateX(8px);
    }
    .editorial-link:is(:hover, :focus-visible) .editorial-arrow {
      width: 48px;
    }
  }
  @media (max-width: 767px) {
    .editorial-link {
      grid-template-columns: 70px minmax(0, 1fr);
      gap: 18px 20px;
      min-height: 0;
      padding: 24px 38px 28px 0;
    }
    .editorial-link::before {
      left: 69px;
    }
    .editorial-link::after {
      top: 20px;
    }
    .editorial-date {
      grid-row: 1 / span 2;
      padding-right: 12px;
    }
    .date-month-day {
      font-size: 16px;
    }
    .editorial-title {
      font-size: clamp(23px, 7vw, 28px);
      line-height: 1.5;
    }
    .editorial-main {
      gap: 14px;
    }
    .editorial-content {
      grid-column: 2;
      padding: 0;
      border: 0;
    }
    .editorial-description {
      font-size: 14px;
      line-height: 1.8;
    }
    .editorial-arrow {
      right: 0;
      bottom: 29px;
      width: 24px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .editorial-link::before,
    .editorial-title,
    .editorial-arrow {
      transition: none;
    }
  }
</style>
