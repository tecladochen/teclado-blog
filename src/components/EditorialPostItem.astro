---
import type { Post } from '~/types'
import { themeConfig } from '~/.config'
import { formatDate, getPathFromCategory, getWordCountAndReadTime } from '~/utils'

interface Props {
  post: Post
  description?: string
}

const { post, description } = Astro.props

const displayDate = post.data.modDate ?? post.data.pubDate
const dateStr = formatDate(displayDate, 'YYYY-MM-DD')
const categoryList = post.data.categories ?? []
const { count, minutes } = getWordCountAndReadTime(post.body)

// 分类个性化色彩：随笔/读书等
const isReading = categoryList.some((c) => c.includes('读') || c.includes('书'))

function getCategoryUrl(category: string) {
  return `/categories/${getPathFromCategory(category, themeConfig.site.categoryMap)}/`
}
---

<article
  class="post-card-stationery cotton-paper rounded-2xl p-6 sm:p-7 flex flex-col gap-3.5 transition-all duration-200 hover:-translate-y-1 hover:shadow-[0_16px_36px_-6px_rgba(75,55,35,0.12)] dark:hover:shadow-[0_16px_36px_-6px_rgba(0,0,0,0.5)] group relative overflow-hidden"
>
  <!-- 顶部信息栏：分类药丸 + 日期 + 字数与阅读耗时 -->
  <div class="flex items-center justify-between gap-2 text-xs font-mono tabular z-1 relative">
    <div class="flex items-center gap-2">
      {
        categoryList.map((cat) => (
          <a
            href={getCategoryUrl(cat)}
            class:list={[
              'not-underline-hover px-2.5 py-0.5 rounded-full font-medium text-[11px] tracking-wide border transition-colors',
              isReading
                ? 'bg-[#1b4332]/[0.06] dark:bg-[#10b981]/15 text-[#1b4332] dark:text-[#34d399] border-[#1b4332]/15 dark:border-[#34d399]/20'
                : 'bg-[#5c4033]/[0.06] dark:bg-[#d4a373]/15 text-[#5c4033] dark:text-[#e0c3a2] border-[#5c4033]/15 dark:border-[#e0c3a2]/20',
            ]}
          >
            {cat}
          </a>
        ))
      }
      <span class="text-neutral-300 dark:text-neutral-600">·</span>
      <time datetime={dateStr} class="text-neutral-500 dark:text-neutral-400 font-medium">
        {dateStr}
      </time>
    </div>

    <div class="text-[11.5px] text-neutral-400 dark:text-neutral-500 hidden sm:flex items-center gap-1.5">
      <span>约 {count.toLocaleString()} 字</span>
      <span>·</span>
      <span>需 {minutes} 分钟漫读</span>
    </div>
  </div>

  <!-- 标题 -->
  <h2
    class="serif-text text-lg sm:text-[21px] font-bold tracking-tight text-[#2c241c] dark:text-[#ede4d8] leading-[1.4] m-0 group-hover:text-[#0f4c3a] dark:group-hover:text-[#34d399] transition-colors z-1 relative"
  >
    <a href={`/posts/${post.id}/`} class="not-underline-hover block">
      {post.data.title}
    </a>
  </h2>

  <!-- 摘要 -->
  {
    description && (
      <p class="text-[14px] text-[#5c5245] dark:text-[#a89f92] leading-[1.8] line-clamp-3 m-0 z-1 relative">
        {description}
      </p>
    )
  }

  <!-- 底栏：字数移动端补全 + 展卷阅读交互 -->
  <div
    class="flex items-center justify-between pt-3.5 mt-1 border-t border-[#dfd7ca]/60 dark:border-white/[0.06] text-xs z-1 relative"
  >
    <div class="text-neutral-400 dark:text-neutral-500 font-mono text-[11px] flex sm:hidden items-center gap-1">
      <span>{count} 字</span>
      <span>·</span>
      <span>{minutes} min</span>
    </div>
    <div class="hidden sm:block text-neutral-400 dark:text-neutral-500 font-mono text-[11px]">孤独终洁 · 手札</div>

    <a
      href={`/posts/${post.id}/`}
      class="not-underline-hover inline-flex items-center gap-1.5 font-medium text-[#4a3f35] dark:text-[#c4bbb0] group-hover:text-[#0f4c3a] dark:group-hover:text-[#34d399] transition-colors ml-auto text-xs"
    >
      <span>展卷阅读</span>
      <span class="text-xs transition-transform duration-200 group-hover:translate-x-1">→</span>
    </a>
  </div>
</article>
