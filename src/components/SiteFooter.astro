---
import { site } from '~/site'

const year = new Date().getFullYear()
---

<footer class="site-footer">
  <p class="footer-word" aria-hidden="true">{site.title}</p>
  <div class="footer-row">
    <p>
      © {year}
      {site.author}
      <span aria-hidden="true"> · </span>
      只留能过自己这一关的字
      <span aria-hidden="true"> · </span>
      <a href={site.icp.href} rel="nofollow">{site.icp.text}</a>
    </p>
    <p>
      {site.social.map((item) => <a href={item.href}>{item.name}</a>)}
    </p>
  </div>
</footer>
