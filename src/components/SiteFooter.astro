---
import { themeConfig } from '~/.config'
import { travels } from '~/.config/travels'

const year = new Date().getFullYear()
const showTravels = travels.length > 0

const { website, author, footer } = themeConfig.site

function parseFooter(str: string) {
  str = str.replace(/%author/g, author)
  str = str.replace(/%website/g, website)
  str = str.replace(/%year/g, year.toString())
  return str
}
---

{
  footer.length && (
    <div class="footer-colophon">
      <div class="footer-lead">
        <p class="footer-owner" set:html={parseFooter(footer[0])} />
        {showTravels && <a class="footer-travel not-underline-hover" href="/travels" aria-label="足迹">Footprints</a>}
      </div>
      {footer.slice(1).map(str => (
        <p class="footer-record" set:html={parseFooter(str)} />
      ))}
    </div>
  )
}

<style>
  .footer-colophon {
    --footer-hover: var(--theme-accent-hover);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 17px 0 2px;
    border-top: 1px solid var(--theme-border);
    color: var(--theme-muted);
    font-family: 'JetBrains Mono Variable', monospace;
  }
  .footer-lead {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 12px;
  }
  .footer-owner,
  .footer-record {
    margin: 0;
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: 0.025em;
  }
  .footer-travel {
    padding-left: 12px;
    border-left: 1px solid var(--theme-border);
    color: var(--theme-muted);
    font-family: 'Inter Variable', 'PingFang SC', sans-serif;
    font-size: 11px;
    letter-spacing: 0.025em;
    line-height: 1.5;
    white-space: nowrap;
    transition: color 180ms ease;
  }
  .footer-travel:hover,
  .footer-travel:focus-visible {
    color: var(--footer-hover);
  }
  .footer-owner {
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }
  .footer-owner :global(a),
  .footer-record :global(a) {
    color: var(--uno-colors-primary);
    transition: color 180ms ease;
  }
  .footer-owner :global(a) {
    font-family: 'Inter Variable', 'PingFang SC', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .footer-record {
    text-align: right;
    white-space: nowrap;
  }
  .footer-record :global(a) {
    color: inherit;
  }
  .footer-owner :global(a:hover),
  .footer-owner :global(a:focus-visible),
  .footer-record :global(a:hover),
  .footer-record :global(a:focus-visible) {
    color: var(--footer-hover);
  }
  @media (max-width: 639px) {
    .footer-colophon {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
      padding-top: 14px;
    }
    .footer-record {
      text-align: left;
      white-space: normal;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-travel,
    .footer-owner :global(a),
    .footer-record :global(a) {
      transition: none;
    }
  }
</style>
