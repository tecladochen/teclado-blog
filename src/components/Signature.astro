<div class:list={['signature-wrapper inline-flex items-center gap-1.5 shrink-0', className]}>
  <svg
    viewBox={signature.viewBox}
    class="signature-svg fill-current text-primary h-[1.75rem] sm:h-[2.35rem]"
    style={height ? `height: ${height};` : undefined}
    aria-label="Teclado 手写签名"
    role="img"
  >
    <defs>
      <mask id="teclado-writing-mask">
        <rect x="0" y="0" width="200" height="100" fill="black"></rect>
        <!-- 笔顺 1: 大写 T 起笔与主干 -->
        <path
          class="mask-path-t"
          d={centerlines.t}
          pathLength="1000"
          fill="none"
          stroke="white"
          stroke-width="16"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <!-- 笔顺 2: 连笔流淌书写 eclado -->
        <path
          class="mask-path-eclado"
          d={centerlines.eclado}
          pathLength="1000"
          fill="none"
          stroke="white"
          stroke-width="16"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </mask>
    </defs>
    <path d={signature.d} mask="url(#teclado-writing-mask)"></path>
  </svg>
  {dot && <span class="signature-dot w-1.5 h-1.5 rounded-full bg-emerald-500 mt-2 sm:mt-2.5 shrink-0" />}
</div>

<style>
  .signature-svg {
    display: block;
    width: auto;
  }

  /* 手写渐进揭示动画 - 只播放一次 */
  @keyframes write-t {
    0% {
      stroke-dashoffset: 1000;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }

  @keyframes write-eclado {
    0% {
      opacity: 1;
      stroke-dashoffset: 1000;
    }
    100% {
      opacity: 1;
      stroke-dashoffset: 0;
    }
  }

  /* 墨迹落笔翡翠小圆点轻快弹跳 */
  @keyframes dot-pop {
    0% {
      opacity: 0;
      transform: scale(0);
    }
    60% {
      opacity: 1;
      transform: scale(1.25);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .mask-path-t {
    stroke-dasharray: 1000 1500;
    stroke-dashoffset: 1000;
    animation: write-t 0.75s cubic-bezier(0.4, 0, 0.2, 1) 0.15s forwards;
  }

  .mask-path-eclado {
    opacity: 0;
    stroke-dasharray: 1000 1500;
    stroke-dashoffset: 1000;
    animation: write-eclado 1.55s cubic-bezier(0.25, 1, 0.5, 1) 0.7s forwards;
  }

  .signature-dot {
    opacity: 0;
    transform: scale(0);
    animation: dot-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 2.25s forwards;
  }

  /* 适应系统减弱动效偏好 */
  @media (prefers-reduced-motion: reduce) {
    .mask-path-t,
    .mask-path-eclado {
      opacity: 1;
      stroke-dashoffset: 0;
      animation: none;
    }
    .signature-dot {
      opacity: 1;
      transform: scale(1);
      animation: none;
    }
  }
</style>
