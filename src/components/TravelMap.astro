---
import type { TravelLabelSpot } from '~/utils/travelMap'
import { buildTravelMap } from '~/utils/travelMap'

const map = buildTravelMap()
const visitedRegions = map.regions.filter(region => region.visited)
const areaName = map.scope === 'world' ? '国家' : '省份'
const size = (value: number) => value.toFixed(2)

function spot(label: TravelLabelSpot, suffix = '') {
  return `--dx${suffix}:${size(label.dx)};--dy${suffix}:${size(label.dy)};--anchor${suffix}:${label.anchor}`
}
---

<section class="travel-page" data-travel-page data-scope={map.scope}>
  {
    map.empty
      ? <p class="travel-empty">还没有记录。</p>
      : (
          <>
            <header class="travel-heading">
              <div class="travel-title">
                <h1>足迹</h1>
                {map.span && <p class="travel-span">{map.span}</p>}
              </div>
              <ul class="travel-legend" aria-hidden="true">
                <li><span class="travel-legend-area" />{`去过的${areaName}`}</li>
                {map.cities.length > 0 && <li><span class="travel-legend-dot" />到访</li>}
                {map.cities.some(city => city.home) && <li><span class="travel-legend-home" />出生地</li>}
              </ul>
            </header>

            {
              map.milestones.length > 0 && (
                <ol class="travel-homes" aria-label="出生与居住地">
                  {map.milestones.map(item => (
                    <li>
                      <span class="travel-place-tag">{item.tag}</span>
                      <span class="travel-home-name">
                        {item.title}{item.place && <span class="travel-home-detail"> · {item.place}</span>}
                        <span class="travel-home-date">（{item.dateLabel}）</span>
                      </span>
                    </li>
                  ))}
                </ol>
              )
            }

            <figure class="travel-map" data-scope={map.scope}>
              <div class="travel-map-canvas">
              <svg class="travel-svg" viewBox={map.viewBox} role="img" aria-label="足迹地图">
                <g class="travel-land">
                  {map.regions.map(region => <path d={region.d} />)}
                </g>
                {
                  visitedRegions.map(region => (
                    <path
                      class="travel-region"
                      d={region.d}
                      style={`--i:${region.order}`}
                      tabindex="0"
                      role="button"
                      aria-label={region.name}
                      data-travel-mark
                      data-travel-key={region.key}
                      data-travel-entry={region.entry}
                    />
                  ))
                }
                {
                  map.regions.map(region => region.contextLabel && (
                    <text
                      class="travel-context"
                      x={region.contextLabel.x}
                      y={region.contextLabel.y}
                      style={`--size:${size(map.labelSize * 0.7)}`}
                    >
                      {region.name}
                    </text>
                  ))
                }
                {
                  map.regions.map(region => region.label && (
                    <text
                      class="travel-label"
                      x={region.label.x}
                      y={region.label.y}
                      style={`--size:${size(map.labelSize)};--i:${region.order}`}
                      data-travel-mark
                      data-travel-key={region.key}
                    >
                      {region.name}
                    </text>
                  ))
                }
                {
                  map.cities.map((city, index) => (
                    <g
                      class:list={['travel-city', { 'is-home': city.home }]}
                      style={`--i:${index}`}
                      data-travel-mark
                      data-travel-key={city.key}
                      data-travel-city={city.city}
                      data-travel-entry={city.entry}
                    >
                      <circle class="travel-city-hit" cx={city.x} cy={city.y} r={map.dotRadius * 3.2} />
                      <circle class="travel-city-halo" cx={city.x} cy={city.y} r={map.dotRadius * 2.5} />
                      {city.home
                        ? <path class="travel-city-dot travel-city-home" d={`M ${city.x} ${city.y - map.dotRadius * 1.7} L ${city.x + map.dotRadius * 1.6} ${city.y + map.dotRadius * 1.2} L ${city.x - map.dotRadius * 1.6} ${city.y + map.dotRadius * 1.2} Z`} />
                        : <circle class="travel-city-dot" cx={city.x} cy={city.y} r={map.dotRadius} />}

                      {
                        city.named && (city.label.show || city.compactLabel.show) && (
                          <text
                            class="travel-city-label"
                            x={city.x}
                            y={city.y}
                            style={`--size:${size(map.labelSize * 0.74)};${spot(city.label)};${spot(city.compactLabel, '-c')}`}
                            data-show={String(city.label.show)}
                            data-show-compact={String(city.compactLabel.show)}
                          >
                            {city.name}
                          </text>
                        )
                      }
                    </g>
                  ))
                }
                {
                  map.inset && (
                    <g class="travel-inset" aria-hidden="true">
                      <rect x={map.inset.x} y={map.inset.y} width={map.inset.width} height={map.inset.height} />
                      {
                        map.inset.lines.map(line => (
                          <path class:list={['travel-inset-line', `is-${line.kind}`, { 'is-visited': line.visited }]} d={line.d} />
                        ))
                      }
                    </g>
                  )
                }
              </svg>

              {
                map.locator && (
                  <svg
                    class="travel-locator"
                    data-corner={map.locator.corner}
                    viewBox={`0 0 ${map.locator.width} ${size(map.locator.height)}`}
                    aria-hidden="true"
                  >
                    {map.locator.regions.map(region => <path class:list={{ 'is-visited': region.visited }} d={region.d} />)}
                    <rect
                      x={map.locator.frame.x}
                      y={map.locator.frame.y}
                      width={map.locator.frame.w}
                      height={map.locator.frame.h}
                    />
                  </svg>
                )
              }
              </div>

              <div class="travel-cards" aria-live="polite">
                {
                  map.groups.map(group => (
                    <div class="travel-card" data-travel-card={group.key} data-corner={group.corner} hidden>
                      <p class="travel-card-head">
                        <span class="travel-card-name">{group.name}</span>
                        {group.cities > 0 && <span class="travel-card-count">{`${group.cities} 城`}</span>}
                      </p>
                      <ol>
                        {
                          group.items.map(item => (
                            <li data-travel-card-city={item.city} data-travel-card-entry={item.id}>
                              <span class="travel-card-city">{item.kind === 'visit' && item.place ? item.place : item.title}</span>
                              {item.visited && <time datetime={item.visited.replace('.', '-')}>{item.dateLabel}</time>}
                            </li>
                          ))
                        }
                      </ol>
                      {group.more > 0 && <p class="travel-card-more">{`还有 ${group.more} 处`}</p>}
                    </div>
                  ))
                }
              </div>
            </figure>

            <ul class="travel-index" aria-label={areaName}>
              {
                map.groups.map(group => (
                  <li>
                    <button
                      class="travel-index-item"
                      type="button"
                      aria-label={group.cities ? `${group.name}，${group.cities} 座城市` : group.name}
                      aria-pressed="false"
                      data-travel-mark
                      data-travel-key={group.key}
                      data-travel-entry={group.entry}
                    >
                      <span class="travel-index-name">{group.name}</span>
                      {group.cities > 0 && <span class="travel-index-count" aria-hidden="true">{group.cities}</span>}
                    </button>
                  </li>
                ))
              }
            </ul>

            <div class="travel-charts">
              <dl class="travel-stats">
                {
                  map.stats.map(stat => (
                    <div class="travel-stat">
                      <dt>{stat.label}</dt>
                      <dd>
                        <span class="travel-stat-value">{String(stat.value).padStart(2, '0')}</span>
                        {stat.total && <span class="travel-stat-total">/ {stat.total}</span>}
                      </dd>
                      {
                        stat.total && (
                          <dd class="travel-meter" aria-hidden="true">
                            {Array.from({ length: stat.total }, (_, index) => <span class:list={{ 'is-on': index < stat.value }} />)}
                          </dd>
                        )
                      }
                    </div>
                  ))
                }
              </dl>

              {
                map.timeline && (
                  <section class="travel-timeline" aria-label="足迹时间轴">
                    <ol class="travel-timeline-segments" style={`--tracks:${map.timeline.segments.map(segment => segment.gap ? '0.3fr' : 'minmax(4.2rem, 1fr)').join(' ')}`}>
                      {map.timeline.segments.map(segment => segment.gap
                        ? (
                          <li class="travel-gap" aria-label={`${segment.start} 至 ${segment.end} 年已缩略`} />
                        )
                        : (
                          <li class="travel-event">
                            <button
                              class:list={['travel-point', { 'is-home': segment.point.home }]}
                              type="button"
                              aria-label={`${segment.point.visited} ${segment.point.title}`}
                              aria-pressed="false"
                              data-travel-mark
                              data-travel-key={segment.point.keys.join(' ')}
                              data-travel-city={segment.point.cities.join(' ') || undefined}
                              data-travel-entry={segment.point.id}
                            >
                              <time class="travel-point-date" datetime={segment.point.visited.replace('.', '-')}>{segment.point.visited}</time>
                              <span class="travel-point-label">
                                {segment.point.title.split(' · ').map(city => <span>{city}</span>)}
                              </span>
                            </button>
                          </li>
                        ))}
                    </ol>
                  </section>
                )
              }
            </div>
          </>
        )
  }

  <script is:inline>
    ;(() => {
      const page = document.querySelector('[data-travel-page]')
      if (!page || page.dataset.ready === 'true')
        return
      page.dataset.ready = 'true'

      const marks = Array.from(page.querySelectorAll('[data-travel-mark]'))
      const cards = Array.from(page.querySelectorAll('[data-travel-card]'))
      const cardItems = Array.from(page.querySelectorAll('[data-travel-card-entry]'))

      let selected = null
      let hot = null

      const list = value => (value || '').split(' ').filter(Boolean)
      const read = element => ({
        keys: list(element.dataset.travelKey),
        cities: list(element.dataset.travelCity),
        entry: element.dataset.travelEntry || '',
        exact: element.classList.contains('travel-point'),
      })
      const same = (a, b) => Boolean(a && b)
        && a.keys.join() === b.keys.join()
        && a.cities.join() === b.cities.join()
        && a.entry === b.entry
        && a.exact === b.exact
      const isCurrent = (focus, cities, entry) => Boolean(focus)
        && (focus.cities.length
          ? list(cities).some(city => focus.cities.includes(city))
          : focus.exact && entry === focus.entry)

      const paint = () => {
        const focus = hot || selected
        marks.forEach((mark) => {
          const match = Boolean(focus) && list(mark.dataset.travelKey).some(key => focus.keys.includes(key))
          mark.classList.toggle('is-dimmed', Boolean(focus) && !match)
          mark.classList.toggle('is-focus', match)
          mark.classList.toggle('is-current', isCurrent(focus, mark.dataset.travelCity, mark.dataset.travelEntry))
          if (mark.hasAttribute('aria-pressed'))
            mark.setAttribute('aria-pressed', String(same(selected, read(mark))))
        })
        cards.forEach((card) => {
          const hidden = !focus || focus.keys.length !== 1 || card.dataset.travelCard !== focus.keys[0]
          if (card.hidden !== hidden)
            card.hidden = hidden
        })
        cardItems.forEach((item) => {
          const current = focus?.exact
            ? item.dataset.travelCardEntry === focus.entry
            : isCurrent(focus, item.dataset.travelCardCity, item.dataset.travelCardEntry)
          item.classList.toggle('is-current', current)
        })
      }

      const select = (element) => {
        const next = read(element)
        selected = same(selected, next) ? null : next
        hot = null
        paint()
      }

      const hover = (next) => {
        if (same(hot, next) || (!hot && !next))
          return
        hot = next
        paint()
      }

      page.addEventListener('click', (event) => {
        const target = event.target.closest('[data-travel-entry]')
        if (target) {
          select(target)
          return
        }
        if (selected && event.target.closest('.travel-map')) {
          selected = null
          paint()
        }
      })

      page.addEventListener('pointerover', (event) => {
        if (event.pointerType === 'touch')
          return
        const target = event.target.closest('[data-travel-mark][data-travel-entry]')
        hover(target ? read(target) : null)
      })

      page.addEventListener('pointerleave', () => hover(null))

      page.addEventListener('focusin', (event) => {
        const target = event.target.closest('[data-travel-entry]')
        if (target && target.matches(':focus-visible'))
          hover(read(target))
      })

      page.addEventListener('focusout', () => hover(null))

      page.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && (selected || hot)) {
          selected = null
          hot = null
          paint()
          return
        }
        if (event.key !== 'Enter' && event.key !== ' ')
          return
        const target = event.target.closest('[data-travel-entry]')
        if (!target || target.tagName === 'BUTTON')
          return
        event.preventDefault()
        select(target)
      })
    })()
  </script>
</section>

<style>
  .travel-page {
    --travel-serif: 'Songti SC', 'Noto Serif CJK SC', 'Source Han Serif SC', STSong, Georgia, serif;
    --travel-mono: 'JetBrains Mono Variable', monospace;
    --travel-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --travel-label-scale: 1;
    --travel-dot-scale: 1;
    --travel-home-color: #6f8063;
    margin-top: clamp(-2.5rem, -4vw, -1.5rem);
  }

  .travel-empty {
    margin: 0;
    color: var(--theme-muted);
    font-family: var(--travel-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  .travel-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--uno-colors-primary);
  }

  .travel-title {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    min-width: 0;
  }

  .travel-title h1 {
    margin: 0;
    font-family: var(--travel-serif);
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    line-height: 1.3;
  }

  .travel-span {
    margin: 0;
    padding-left: 0.9rem;
    border-left: 1px solid var(--theme-border);
    color: var(--theme-muted);
    font-family: var(--travel-mono);
    font-size: 10px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    line-height: 1.1;
    white-space: nowrap;
  }

  .travel-legend {
    display: flex;
    gap: 1.1rem;
    margin: 0;
    padding: 0 0 0.2rem;
    color: var(--theme-muted);
    font-size: 10px;
    letter-spacing: 0.12em;
    line-height: 1;
    list-style: none;
    white-space: nowrap;
  }

  .travel-legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .travel-legend-area {
    width: 12px;
    height: 8px;
    border: 1px solid color-mix(in srgb, var(--theme-accent) 58%, var(--uno-colors-background));
    background: color-mix(in srgb, var(--theme-accent) 26%, var(--uno-colors-background));
  }

  .travel-legend-home {
    width: 9px;
    height: 9px;
    background: var(--travel-home-color);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  .travel-legend-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--theme-accent-emphasis);
  }

  /* 地图 */

  .travel-map {
    position: relative;
    margin: clamp(0.75rem, 2.5vw, 1.4rem) 0 clamp(0.6rem, 2vw, 1rem);
  }

  .travel-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .travel-map-canvas {
    position: relative;
  }

  .travel-map[data-scope='region'] .travel-svg {
    -webkit-mask-image:
      linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent),
      linear-gradient(180deg, transparent, #000 11%, #000 89%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent),
      linear-gradient(180deg, transparent, #000 11%, #000 89%, transparent);
    mask-composite: intersect;
  }

  .travel-svg :focus,
  .travel-svg :focus-visible {
    outline: none;
  }

  .travel-land path {
    fill: color-mix(in srgb, var(--uno-colors-primary) 5%, var(--uno-colors-background));
    stroke: color-mix(in srgb, var(--uno-colors-primary) 15%, var(--uno-colors-background));
    stroke-linejoin: round;
    stroke-width: 0.8;
    vector-effect: non-scaling-stroke;
  }

  .travel-region {
    fill: color-mix(in srgb, var(--theme-accent) 26%, var(--uno-colors-background));
    stroke: color-mix(in srgb, var(--theme-accent) 58%, var(--uno-colors-background));
    stroke-linejoin: round;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    cursor: pointer;
    transition:
      fill 200ms ease,
      stroke 200ms ease,
      opacity 200ms ease;
    animation: travel-ink 720ms var(--travel-ease) backwards;
    animation-delay: calc(120ms + var(--i, 0) * 90ms);
  }

  .travel-region.is-focus {
    fill: color-mix(in srgb, var(--theme-accent) 40%, var(--uno-colors-background));
    stroke: var(--theme-accent);
  }

  .travel-label,
  .travel-context,
  .travel-city-label {
    font-family: var(--travel-serif);
    font-size: calc(var(--size) * var(--travel-label-scale) * 1px);
    paint-order: stroke;
    stroke: var(--uno-colors-background);
    stroke-linejoin: round;
    stroke-width: 0.24em;
    dominant-baseline: middle;
    pointer-events: none;
  }

  .travel-label {
    fill: var(--uno-colors-primary);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-anchor: middle;
    transition: opacity 200ms ease;
    animation: travel-fade 520ms ease backwards;
    animation-delay: calc(280ms + var(--i, 0) * 90ms);
  }

  .travel-context {
    fill: var(--theme-muted);
    letter-spacing: 0.24em;
    opacity: 0.72;
    text-anchor: middle;
  }

  .travel-city {
    cursor: pointer;
    transition: opacity 200ms ease;
    animation: travel-fade 420ms ease backwards;
    animation-delay: calc(480ms + var(--i, 0) * 70ms);
  }

  .travel-city-hit {
    fill: transparent;
  }

  .travel-city-hit,
  .travel-city-halo,
  .travel-city-dot {
    transform: scale(var(--travel-dot-scale));
    transform-box: fill-box;
    transform-origin: center;
  }

  .travel-city-dot {
    fill: var(--theme-accent-emphasis);
    stroke: var(--uno-colors-background);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .travel-city-home {
    fill: var(--travel-home-color);
    stroke-linejoin: round;
  }

  .travel-city.is-home .travel-city-halo {
    stroke: var(--travel-home-color);
  }

  .travel-city-halo {
    fill: none;
    stroke: var(--theme-accent-emphasis);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    opacity: 0;
    transform: scale(calc(var(--travel-dot-scale) * 0.4));
    transition:
      opacity 200ms ease,
      transform 360ms var(--travel-ease);
  }

  .travel-city.is-current .travel-city-halo {
    opacity: 1;
    transform: scale(var(--travel-dot-scale));
  }

  .travel-city-label {
    fill: var(--theme-sub);
    opacity: 0;
    text-anchor: var(--anchor);
    transform: translate(calc(var(--dx) * 1px), calc(var(--dy) * 1px));
    transition: opacity 200ms ease;
  }

  .travel-city-label[data-show='true'] {
    opacity: 1;
  }

  .travel-city.is-current .travel-city-label {
    fill: var(--uno-colors-primary);
  }

  .travel-inset rect {
    fill: var(--uno-colors-background);
    stroke: var(--theme-border);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .travel-inset-line {
    fill: none;
    stroke: var(--theme-muted);
    stroke-linejoin: round;
    stroke-width: 0.8;
    vector-effect: non-scaling-stroke;
  }

  .travel-inset-line.is-visited {
    stroke: var(--theme-accent);
  }

  .travel-locator {
    position: absolute;
    width: min(22%, 9rem);
    height: auto;
    pointer-events: none;
  }

  .travel-locator[data-corner^='t'] {
    top: 0;
  }

  .travel-locator[data-corner^='b'] {
    bottom: 0;
  }

  .travel-locator[data-corner$='l'] {
    left: 0;
  }

  .travel-locator[data-corner$='r'] {
    right: 0;
  }

  .travel-locator path {
    fill: color-mix(in srgb, var(--uno-colors-primary) 13%, var(--uno-colors-background));
  }

  .travel-locator path.is-visited {
    fill: color-mix(in srgb, var(--theme-accent) 62%, var(--uno-colors-background));
  }

  .travel-locator rect {
    fill: color-mix(in srgb, var(--theme-accent) 8%, transparent);
    stroke: var(--uno-colors-primary);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .travel-cards {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .travel-card {
    position: absolute;
    width: min(14rem, 100%);
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--theme-border);
    background: color-mix(in srgb, var(--uno-colors-background) 94%, transparent);
    box-shadow: 0 12px 28px -22px rgba(0, 0, 0, 0.45);
    font-size: 12px;
    animation: travel-card-in 240ms var(--travel-ease) both;
  }

  .travel-card[hidden] {
    display: none;
  }

  .travel-card[data-corner^='t'] {
    top: 0.25rem;
  }

  .travel-card[data-corner^='b'] {
    bottom: 0.25rem;
  }

  .travel-card[data-corner$='l'] {
    left: 0;
  }

  .travel-card[data-corner$='r'] {
    right: 0;
  }

  .travel-card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 0.4rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--theme-border-subtle);
  }

  .travel-card-name {
    font-family: var(--travel-serif);
    font-size: 1.1em;
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  .travel-card-count,
  .travel-card time,
  .travel-card-more {
    color: var(--theme-muted);
    font-family: var(--travel-mono);
    font-size: 0.82em;
    font-variant-numeric: tabular-nums;
  }

  .travel-card ol {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .travel-card li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
