---
import type { JourneyEntry } from '~/types'
import { render } from 'astro:content'

interface Props {
  entry: JourneyEntry
}

const { entry } = Astro.props
const { Content } = await render(entry)
---

<div class="journey-entry-content prose">
  <Content />
</div>

<style>
  .journey-entry-content {
    margin-top: 0.65rem;
    font-size: 0.88rem;
    opacity: 0.82;
  }

  .journey-entry-content :global(p:first-child) {
    margin-top: 0;
  }

  .journey-entry-content :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
