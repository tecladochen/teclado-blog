---
import { themeConfig } from '~/.config'
---

<header class="hero-section">
  <!-- 灵动状态胶囊 -->
  <div class="hero-status">
    <span class="status-indicator"></span>
    <span class="status-text">Digital Garden & Field Notes</span>
  </div>

  <!-- 核心诗意标语 -->
  <h1 class="hero-headline">
    在网络的角落，记录思考、实践与生活。<br />
    <span class="headline-sub">不再只是孤独，而是与自己对话。</span>
  </h1>

  <!-- 探索快捷索引 -->
  <div class="hero-pills">
    <a href="/journey" class="pill-btn">
      <span>轨迹记录</span>
      <span class="arrow">↗</span>
    </a>
    <a href="/about" class="pill-btn">
      <span>关于作者</span>
      <span class="arrow">↗</span>
    </a>
    <span class="pill-badge">00 后 · INFJ · 全栈与 AI 探索</span>
  </div>

  <!-- 两端淡隐的极细分割线 -->
  <div class="hero-divider" role="separator"></div>
</header>

<style>
  .hero-section {
    padding-top: 0.5rem;
    margin-bottom: 3.5rem;
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    background-color: rgba(125, 125, 125, 0.07);
    border: 1px solid rgba(125, 125, 125, 0.12);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    opacity: 0.85;
    margin-bottom: 1.25rem;
    user-select: none;
  }

  .status-indicator {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.5);
    animation: pulse 3s infinite ease-in-out;
  }

  .hero-headline {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.55;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem 0;
    color: var(--uno-colors-primary, currentColor);
  }

  .headline-sub {
    font-size: 1.15rem;
    font-weight: 400;
    opacity: 0.65;
    letter-spacing: normal;
  }

  .hero-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 2.25rem;
  }

  .pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8rem;
    color: currentColor;
    opacity: 0.75;
    background: rgba(125, 125, 125, 0.06);
    border: 1px solid rgba(125, 125, 125, 0.12);
    text-decoration: none !important;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .pill-btn:hover {
    opacity: 1;
    background: rgba(125, 125, 125, 0.12);
    border-color: rgba(125, 125, 125, 0.25);
    transform: translateY(-1px);
  }

  .arrow {
    font-size: 0.75rem;
    opacity: 0.7;
    transition: transform 0.2s ease;
  }

  .pill-btn:hover .arrow {
    transform: translate(1px, -1px);
  }

  .pill-badge {
    font-size: 0.78rem;
    padding: 0.3rem 0.6rem;
    opacity: 0.45;
    user-select: none;
  }

  .hero-divider {
    height: 1px;
    width: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(136, 136, 136, 0.2) 25%,
      rgba(136, 136, 136, 0.2) 75%,
      transparent 100%
    );
  }

  @keyframes pulse {
    0%, 100% {
      transform: scale(0.9);
      opacity: 0.7;
    }
    50% {
      transform: scale(1.15);
      opacity: 1;
    }
  }

  @media (max-width: 640px) {
    .hero-headline {
      font-size: 1.3rem;
    }
    .headline-sub {
      font-size: 1rem;
    }
  }
</style>
