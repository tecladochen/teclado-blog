---

---

<section class="grid grid-cols-1 md:grid-cols-12 gap-5 sm:gap-6 mb-12 sm:mb-14 items-stretch">
  <!-- 左卡片 (7列)：生活寄语与手写哲学 -->
  <div
    class="md:col-span-7 bg-white dark:bg-neutral-900/80 border border-black/[0.065] dark:border-white/[0.08] rounded-2xl p-6 sm:p-7 flex flex-col justify-between shadow-[0_1px_3px_rgba(0,0,0,0.02)] relative overflow-hidden"
  >
    <div
      class="absolute top-0 right-0 w-48 h-48 bg-emerald-500/5 rounded-full blur-2xl pointer-events-none -mr-10 -mt-10"
    >
    </div>

    <div>
      <!-- 状态微标 -->
      <div
        class="inline-flex items-center gap-2 px-2.5 py-0.8 rounded-full bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200/60 dark:border-emerald-800/50 text-emerald-800 dark:text-emerald-300 text-[11px] font-medium tracking-wide mb-4"
      >
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="font-mono uppercase font-semibold text-[10.5px]">ESSAYS & LIFE NOTES</span>
      </div>

      <!-- 主标题 -->
      <h1
        class="text-[22px] sm:text-[25px] font-bold tracking-tight text-neutral-900 dark:text-neutral-100 leading-[1.38] mb-3.5"
      >
        记录日常、散步偶得与思考切片。
      </h1>

      <!-- 导语 -->
      <p class="text-neutral-600 dark:text-neutral-400 text-[14px] sm:text-[14.5px] leading-[1.8] mb-5">
        写下平淡日子里的微光。在喧嚣嘈杂的信息流里，留下一座安静生长、与生活真诚对话的手写角落。不设限，不追赶，晴雨、草木、散步与案头杂记。
      </p>
    </div>

    <!-- 纯粹文学跋语（无任何个人身份标签） -->
    <div
      class="pt-3.5 border-t border-black/[0.05] dark:border-white/[0.06] flex items-center justify-between text-xs text-neutral-400 dark:text-neutral-500 font-mono"
    >
      <span class="italic">“世事漫随流水，闲来细嚼慢咽。”</span>
      <span class="text-[11px]">杭州</span>
    </div>
  </div>

  <!-- 右卡片 (5列)：案头手札与来信交流 -->
  <div
    class="md:col-span-5 bg-white dark:bg-neutral-900/80 border border-black/[0.065] dark:border-white/[0.08] rounded-2xl p-6 flex flex-col justify-between shadow-[0_1px_3px_rgba(0,0,0,0.02)]"
  >
    <div>
      <div class="flex items-center justify-between pb-3 mb-4 border-b border-black/[0.05] dark:border-white/[0.06]">
        <span
          class="text-[11px] font-mono uppercase tracking-wider font-semibold text-neutral-400 dark:text-neutral-500"
        >
          ALMANAC · 案头手札
        </span>
        <span
          class="text-[10px] font-mono text-amber-800 dark:text-amber-300 font-medium px-2 py-0.5 rounded bg-amber-50 dark:bg-amber-950/40 border border-amber-200/60 dark:border-amber-800/40"
        >
          AUTUMN 2026
        </span>
      </div>

      <!-- 窗前景致 -->
      <div class="mb-4">
        <div class="text-[10px] font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-1">
          SCENE / 窗前景致
        </div>
        <div class="text-xs font-semibold text-neutral-900 dark:text-neutral-100 mb-1">江南初秋 · 窗前微风有雨</div>
        <div
          class="text-[11.5px] text-neutral-500 dark:text-neutral-400 italic pl-2.5 border-l-2 border-neutral-300 dark:border-neutral-700 leading-relaxed font-serif"
        >
          “案头供一枝晚荷，听秋蝉歇息，心静则凉。”
        </div>
      </div>

      <!-- 案头在读 -->
      <div class="mb-4">
        <div class="text-[10px] font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-1">
          READING / 案头在读
        </div>
        <div class="text-xs font-semibold text-neutral-900 dark:text-neutral-100">《一句顶一万句》· 刘震云</div>
        <div class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-0.5">
          重读延津人物，字字藏着世间委屈与温热。
        </div>
      </div>

      <!-- 来信交流 -->
      <div>
        <div class="text-[10px] font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-1">
          CORRESPONDENCE / 见信如面
        </div>
        <div class="text-xs font-mono text-neutral-800 dark:text-neutral-200 font-semibold mb-0.5">
          <a
            href="mailto:tecladochen@qq.com"
            class="not-underline-hover hover:text-blue-600 dark:hover:text-blue-400 transition-colors inline-flex items-center gap-0.5"
          >
            <span>tecladochen@qq.com</span>
            <span class="text-[10px]">↗</span>
          </a>
        </div>
        <div class="text-[11px] text-neutral-500 dark:text-neutral-400">见字如面，欢迎来信聊聊生活与日常小事</div>
      </div>
    </div>

    <!-- 卡片底印 -->
    <div
      class="pt-3 mt-3 border-t border-black/[0.05] dark:border-white/[0.06] flex items-center justify-between text-[10.5px] text-neutral-400 dark:text-neutral-500 font-mono"
    >
      <span>LETTERS WELCOME</span>
      <span>SLOW & SINCERE</span>
    </div>
  </div>
</section>
