<section class="hero-section mb-10 sm:mb-12 pb-8 border-b border-dashed border-black/10 dark:border-white/10">
  <!-- 灵动状态徽标 -->
  <div
    class="inline-flex items-center gap-2 font-mono text-[11px] tracking-widest text-neutral-500 dark:text-neutral-400 uppercase mb-3.5"
  >
    <span class="relative flex h-2 w-2">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
    </span>
    <span>HELLO, I'M TECLADO</span>
  </div>

  <!-- 主标语 -->
  <h1
    class="text-2xl sm:text-[26px] font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 leading-snug mb-3"
  >
    在网络的角落，记录技术实践与生活切片。
  </h1>

  <!-- 阐述 -->
  <p class="text-sm sm:text-[14.5px] leading-relaxed text-neutral-600 dark:text-neutral-400 max-w-xl mb-5">
    写文字，做创造，在数字世界里留下一座持续生长的花园——与世界分享，亦与自己真诚对话。
  </p>

  <!-- 足迹与属性快捷入口 -->
  <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 text-xs font-mono text-neutral-500 dark:text-neutral-400">
    <a
      href="/journey"
      class="not-underline-hover text-neutral-800 dark:text-neutral-200 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors inline-flex items-center gap-0.5"
    >
      <span>轨迹足迹</span>
      <span class="text-[11px]">↗</span>
    </a>
    <span class="text-neutral-300 dark:text-neutral-700 select-none">/</span>
    <a
      href="/about"
      class="not-underline-hover text-neutral-800 dark:text-neutral-200 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors inline-flex items-center gap-0.5"
    >
      <span>关于我</span>
      <span class="text-[11px]">↗</span>
    </a>
    <span class="text-neutral-300 dark:text-neutral-700 select-none">/</span>
    <span class="text-neutral-500 dark:text-neutral-400">00 后 · INFJ · 全栈与 AI 探索</span>
  </div>
</section>
