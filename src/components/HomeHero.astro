---
import { themeConfig } from '~/.config'

const { description } = themeConfig.site
---

<header class="home-hero">
  <div class="status-bar">
    <span class="status-dot"></span>
    <span class="status-text">HELLO, I'M TECLADO</span>
  </div>

  <h1 class="hero-title font-header">
    与自己对话，留下成长的痕迹
  </h1>

  <p class="hero-desc">
    {description}
  </p>

  <div class="hero-links">
    <a href="/journey" class="hero-link">
      <span>轨迹足迹</span>
      <span class="link-arrow">↗</span>
    </a>
    <span class="hero-slash">/</span>
    <a href="/about" class="hero-link">
      <span>关于我</span>
      <span class="link-arrow">↗</span>
    </a>
    <span class="hero-slash">/</span>
    <span class="hero-tag">00 后 · INFJ · 全栈与 AI 实践</span>
  </div>
</header>

<style>
  .home-hero {
    margin-bottom: 2.75rem;
    padding-bottom: 2rem;
    border-bottom: 1px dashed rgba(136, 136, 136, 0.22);
  }

  .status-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .status-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background-color: #10b981;
    animation: pulse 3s infinite ease-in-out;
  }

  .status-text {
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .hero-title {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.45;
    margin: 0.25rem 0 0.6rem 0;
    color: var(--uno-colors-primary, currentColor);
    letter-spacing: -0.01em;
  }

  .hero-desc {
    font-size: 0.925rem;
    line-height: 1.8;
    opacity: 0.8;
    margin: 0 0 1rem 0;
    text-wrap: pretty;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.825rem;
  }

  .hero-link {
    color: currentColor;
    text-decoration: none !important;
    opacity: 0.72;
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    transition: opacity 0.2s ease, color 0.2s ease;
  }

  .hero-link:hover {
    opacity: 1;
    color: var(--uno-colors-primary, currentColor);
  }

  .link-arrow {
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .hero-slash {
    opacity: 0.25;
    user-select: none;
  }

  .hero-tag {
    opacity: 0.5;
    font-size: 0.78rem;
  }

  @keyframes pulse {
    0%, 100% {
      transform: scale(0.92);
      opacity: 0.65;
    }
    50% {
      transform: scale(1.1);
      opacity: 1;
    }
  }
</style>
