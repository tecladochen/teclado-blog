---
import Base from '~/layouts/Base.astro'
import FeaturedEssay from '~/components/FeaturedEssay.astro'
import { getPosts } from '~/lib/content'
import { site } from '~/site'

const posts = await getPosts()
---

<Base title="notes" description="已写成的笔记，以及桌上还空着的格子。">
  <section class="page-intro">
    <p class="hero-kicker">notes</p>
    <h1>notes</h1>
    <p>
      目前公开的只有一篇读书笔记。下面那些编号不是假装发过的文章，是故意摆在桌上的空位——让版面先有密度，也提醒自己后面要写什么。
    </p>
  </section>

  <section class="section writing-list">
    {posts.map((post) => <FeaturedEssay post={post} />)}
  </section>

  <section class="section">
    <div class="section-head" data-reveal>
      <h2>placeholders</h2>
      <span class="section-note">{site.desk.length} 个空位</span>
    </div>
    <div class="writing-rows">
      {
        site.desk.map((item, index) => (
          <article class="writing-row" data-reveal style={`--stagger: ${index}`}>
            <span class="no">{item.no}</span>
            <span class="kind">{item.kicker}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.excerpt}</p>
            </div>
            <time>{item.year}</time>
          </article>
        ))
      }
    </div>
  </section>
</Base>
