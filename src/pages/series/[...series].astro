---
import { themeConfig } from '~/.config'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import { formatDate, getSeries, getSeriesDescription } from '~/utils'

export async function getStaticPaths() {
  const postsBySeries = await getSeries()
  return themeConfig.site.seriesMap.map((config) => ({
    params: { series: config.path },
    props: {
      posts: postsBySeries.get(config.name) ?? [],
      name: config.name,
      description: config.description ?? getSeriesDescription(config.name, themeConfig.site.seriesMap),
    },
  }))
}

const { posts, name, description } = Astro.props
const { translate: t } = Astro.locals
---

<LayoutDefault>
  <section class="series-detail-page">
    <header class="series-detail-header">
      <h2 class="post-title">{name}</h2>
      <p>{t('series_count', posts.length)}</p>
    </header>

    {description && <p class="series-description">{description}</p>}

    {
      posts.length === 0 ? (
        <p class="series-empty">{t('series_empty')}</p>
      ) : (
        <ol class="series-post-list">
          {posts.map((post) => (
            <li class="series-post-item">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              <a class="series-post-title" href={`/posts/${post.id}/`}>{post.data.title}</a>
            </li>
          ))}
        </ol>
      )
    }
  </section>
</LayoutDefault>

<style>
  .series-detail-page {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .series-detail-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--uno-colors-shadow);
  }

  .series-detail-header p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    white-space: nowrap;
    opacity: 0.72;
  }

  .series-description {
    margin: -0.25rem 0 0;
    line-height: 1.75;
    opacity: 0.82;
    overflow-wrap: break-word;
  }

  .series-empty {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.7;
    opacity: 0.68;
  }

  .series-post-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .series-post-item {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    column-gap: 1rem;
    align-items: start;
    min-width: 0;
  }

  .series-post-item time {
    padding-top: 0.1rem;
    font-size: 0.82rem;
    line-height: 1.6;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    opacity: 0.68;
  }

  .series-post-title {
    font-size: 1.08rem;
    line-height: 1.65;
    font-weight: 700;
    overflow-wrap: break-word;
  }

  @media (max-width: 520px) {
    .series-detail-page {
      gap: 1.2rem;
    }

    .series-detail-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
    }

    .series-post-item {
      grid-template-columns: 4.9rem minmax(0, 1fr);
      column-gap: 0.75rem;
    }

    .series-post-title {
      font-size: 1rem;
      line-height: 1.6;
    }
  }
</style>
