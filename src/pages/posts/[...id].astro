---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import { render } from 'astro:content'
import Base from '~/layouts/Base.astro'
import { formatChineseDate, getPosts } from '~/lib/content'

export const getStaticPaths = (async () => {
  const posts = await getPosts()
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }))
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { post } = Astro.props
const { Content, headings } = await render(post)
const toc = headings.filter((item) => item.depth === 2)
const kindLabel = post.data.kind === 'reading' ? '读书笔记' : post.data.kind === 'life' ? '生活' : '笔记'
---

<Base title={post.data.title} description={post.data.description} type="article">
  <main class="page">
    <a class="back-link" href="/writing/">← 返回文章</a>
    <div class="article-hero" transition:name={`essay-${post.id}`}>
      <div class="ghost" aria-hidden="true">读</div>
      <header>
        <p class="article-kicker">{kindLabel}</p>
        <h1>{post.data.title}</h1>
        <div class="article-meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatChineseDate(post.data.pubDate)}</time>
          {post.data.modDate && <span>补记于 {formatChineseDate(post.data.modDate)}</span>}
        </div>
      </header>
    </div>

    <div class="article-layout">
      <article class="prose" data-article>
        <Content />
      </article>
      {
        toc.length > 0 && (
          <nav class="toc" aria-label="目录">
            {toc.map((item) => (
              <a href={`#${item.slug}`}>{item.text}</a>
            ))}
          </nav>
        )
      }
    </div>
  </main>
</Base>
