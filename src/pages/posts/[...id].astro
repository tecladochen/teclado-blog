---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import { render } from 'astro:content'
import Comments from '~/components/Comments.astro'
import SiteSeo from '~/components/SiteSeo.astro'
import TableOfContents from '~/components/TableOfContents.astro'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import LayoutPost from '~/layouts/LayoutPost.astro'
import { formatDate, getPosts } from '~/utils'

export const getStaticPaths = (async () => {
  const posts = await getPosts()
  return posts.map((post, idx) => {
    // getPosts 是降序排列（最新在前），所以 idx - 1 是较新文章，idx + 1 是较早文章
    const newer = posts[idx - 1]
    const older = posts[idx + 1]
    return {
      params: { id: post.id },
      props: { entry: post, newer, older },
    }
  })
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { entry, newer, older } = Astro.props
const { Content, headings } = await render(entry)

function getUrl(id?: string) {
  return `/posts/${id}/`
}
---

<LayoutDefault>
  <SiteSeo
    slot="seo"
    title={entry.data.title}
    desc={entry.data.description}
    banner={entry.data.banner}
    type="article"
    publishedTime={entry.data.pubDate}
    modifiedTime={entry.data.modDate}
    author={entry.data.author}
    categories={entry.data.categories}
  />

  <TableOfContents headings={headings} />

  <LayoutPost post={entry}>
    <Content />
  </LayoutPost>

  <nav class="post-adjacent reading-design" aria-label="上一篇与下一篇文章">
    {
      [older, newer].map((post, index) =>
        post
? (
          <a
            href={getUrl(post.id)}
            class:list={['post-neighbor not-underline-hover', { 'post-neighbor-next': index === 1 }]}
          >
            <span class="neighbor-label">{index === 0 ? '上一篇' : '下一篇'}</span>
            <span class="neighbor-title">{post.data.title}</span>
            <span class="neighbor-bottom">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, 'YYYY.MM.DD')}</time>
              <span class="neighbor-arrow" aria-hidden="true">
                {index === 0 ? '←' : '→'}
              </span>
            </span>
          </a>
        )
: (
          <div class:list={['post-neighbor neighbor-empty', { 'post-neighbor-next': index === 1 }]}>
            {index === 0 ? '没有更早的文章了' : '已经是最新文章了'}
          </div>
        ),
      )
    }
  </nav>

  <!-- 评论区 -->
  <Comments post={entry} />
</LayoutDefault>

<script>
  import '@github/clipboard-copy-element'

  let codeCopyController: AbortController | undefined

  function setupCodeCopy() {
    codeCopyController?.abort()
    const controller = new AbortController()
    const { signal } = controller
    codeCopyController = controller

    document.addEventListener(
      'clipboard-copy',
      (event) => {
        const target = event.target as HTMLElement
        const icon = target.querySelector('.icon') as HTMLElement
        if (icon) {
          icon.classList.replace('i-mdi-content-copy', 'i-mdi-check')
          setTimeout(() => {
            icon.classList.replace('i-mdi-check', 'i-mdi-content-copy')
          }, 1500)
        }
      },
      { signal },
    )

    const codeBlocks = Array.from(document.querySelectorAll('pre'))
    const icon = '<div class=\'i-mdi-content-copy icon text-neutral-400\'></div>'
    for (const codeBlock of codeBlocks) {
      if (codeBlock.parentElement?.classList.contains('code-container')) {
        continue
      }
      const wrapper = document.createElement('div')
      wrapper.className = 'code-container'

      const copyButton = document.createElement('clipboard-copy')
      const code = codeBlock.querySelector('code')
      copyButton.setAttribute('aria-label', '复制代码')
      copyButton.value = code?.textContent ?? ''
      copyButton.className = 'clipboard-copy'
      copyButton.innerHTML = icon

      codeBlock.appendChild(copyButton)
      codeBlock.parentNode?.insertBefore(wrapper, codeBlock)
      wrapper.appendChild(codeBlock)
    }
  }

  setupCodeCopy()
  document.addEventListener('astro:page-load', setupCodeCopy)
</script>

<style is:global>
  .post-adjacent {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 32px;
    border-block: 1px solid var(--reading-rule);
  }
  .post-neighbor {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    overflow: hidden;
    padding: 28px 24px;
  }
  .post-neighbor::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--reading-hover-ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 480ms var(--reading-ease);
  }
  .post-neighbor:first-child {
    border-right: 1px solid var(--reading-rule);
  }
  .post-neighbor-next {
    text-align: right;
  }
  .post-neighbor-next::before {
    transform-origin: right;
  }
  .neighbor-label,
  .neighbor-bottom,
  .neighbor-empty {
    font-size: 12px;
    color: var(--reading-muted);
  }
  .neighbor-title {
    align-self: flex-start;
    font-family: var(--reading-serif);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.6;
    text-wrap: pretty;
    overflow-wrap: anywhere;
    background-image: linear-gradient(var(--reading-hover-ink), var(--reading-hover-ink));
    background-repeat: no-repeat;
    background-position: left bottom;
    background-size: 0 1px;
    transition:
      color 180ms ease,
      background-size 480ms var(--reading-ease);
  }
  .post-neighbor-next .neighbor-title {
    align-self: flex-end;
    background-position: right bottom;
  }
  .neighbor-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .neighbor-bottom time {
    font:
      11px 'JetBrains Mono Variable',
      monospace;
  }
  .post-neighbor-next .neighbor-bottom {
    flex-direction: row-reverse;
  }
  .neighbor-arrow {
    font-size: 22px;
    color: var(--reading-accent);
    transition: transform 460ms var(--reading-ease);
  }
  a.post-neighbor:is(:hover, :focus-visible) {
    color: var(--reading-ink);
  }
  a.post-neighbor:is(:hover, :focus-visible)::before {
    transform: scaleX(1);
  }
  a.post-neighbor:is(:hover, :focus-visible) .neighbor-title {
    color: var(--reading-hover-ink);
    background-size: 100% 1px;
  }
  a.post-neighbor:is(:hover, :focus-visible) .neighbor-arrow {
    color: var(--reading-hover-ink);
    transform: translateX(-8px);
  }
  a.post-neighbor-next:is(:hover, :focus-visible) .neighbor-arrow {
    transform: translateX(8px);
  }
  @media (max-width: 639px) {
    .post-adjacent {
      grid-template-columns: minmax(0, 1fr);
    }
    .post-neighbor:first-child {
      border-right: 0;
      border-bottom: 1px solid var(--reading-rule);
    }
    .post-neighbor {
      padding: 22px 24px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .post-adjacent a,
    .post-neighbor::before,
    .post-adjacent .neighbor-title,
    .post-adjacent .neighbor-arrow {
      transition: none;
      transform: none !important;
    }
  }
  .code-container {
    position: relative;
  }
  .clipboard-copy {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 0.25rem;
    background: rgba(0, 0, 0, 0.05);
    transition: background-color 0.15s;
  }
  .dark .clipboard-copy {
    background: rgba(255, 255, 255, 0.1);
  }
  .clipboard-copy:hover {
    background-color: rgba(0, 0, 0, 0.15);
  }
</style>
