---
import { siteLifetimeConfig, xiaoheiConfig } from '~/.config/user'
import { xiaoheiAnimations } from '~/assets/companions/xiaohei/catalog'
import XiaoheiCompanion from '~/components/companions/XiaoheiCompanion.astro'
import { getSiteDays } from '~/utils/siteLifetime'
import { getXiaoheiRotation } from '~/utils/xiaoheiSelection'
import '@fontsource-variable/inter/wght.css'
import '@fontsource-variable/jetbrains-mono/wght.css'
import '~/styles/global.css'

// An author preview, excluded from the production build and site navigation.
export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { preview: 'xiaohei' } }] : []
}

const siteDays = getSiteDays(siteLifetimeConfig.startedOn, new Date(), siteLifetimeConfig.timeZone)
const catalog = new Map(xiaoheiAnimations.map(animation => [animation.id, animation]))
const rotation = getXiaoheiRotation(xiaoheiConfig, [...catalog.keys()]).map(id => catalog.get(id)!)
const weekLength = 7
const weeks = Array.from({ length: Math.ceil(rotation.length / weekLength) }, (_, index) => rotation.slice(index * weekLength, (index + 1) * weekLength))
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>小黑的日常 · Teclado</title>
  </head>
  <body>
    <main class="preview">
      <header>
        <div><p class="eyebrow">TECLADO / 小黑的日常</p><h1>小黑和朋友们</h1><p>从 {xiaoheiConfig.startsOn} 起，按上海日期每天换一个动作，{rotation.length} 天一轮。</p></div>
        <button type="button" data-preview-theme aria-pressed="false">深色背景</button>
      </header>
      {weeks.map((animations, week) => (
        <section class="preview-group" id={`rotation-week-${week + 1}`}>
          <h2>第 {week + 1} 周</h2>
          <div class="poses">
            {animations.map((animation, index) => (
              <section class="pose" id={`preview-${animation.id}`}>
                <div class="pose-heading"><span>第 {week * weekLength + index + 1} 天 · {animation.id}</span><h3>{animation.name}</h3></div>
                <aside data-site-companion data-variant="xiaohei" data-paused="true" aria-label={animation.name}>
                  <XiaoheiCompanion animationId={animation.id} siteDays={siteDays} />
                </aside>
                <a href={`/?xiaohei=${animation.id}`} data-no-swup>放到首页看看 <span aria-hidden="true">↗</span></a>
              </section>
            ))}
          </div>
        </section>
      ))}
      <footer><a href="/" data-no-swup>返回当前网站</a><span>{xiaoheiConfig.mode === 'daily' ? '已启用每日切换 · 按上面的顺序循环' : `目前固定显示 ${xiaoheiConfig.fixed}`}</span></footer>
    </main>
    <script>
      import { setupSiteCompanions } from '~/scripts/siteCompanion'

      setupSiteCompanions()
      document.querySelector<HTMLButtonElement>('[data-preview-theme]')?.addEventListener('click', (event) => {
        const dark = document.documentElement.classList.toggle('dark')
        const button = event.currentTarget as HTMLButtonElement
        button.setAttribute('aria-pressed', String(dark))
        button.textContent = dark ? '浅色背景' : '深色背景'
      })
    </script>
  </body>
</html>

<style>
  .preview { max-width: 1020px; margin: 0 auto; padding: 60px 28px 36px; }
  header { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 40px; }
  .eyebrow { font-size: 10px; letter-spacing: .15em; opacity: .55; }
  h1 { margin: 12px 0; font-family: 'Songti SC', serif; font-size: 29px; font-weight: 400; }
  header p:not(.eyebrow), footer { font-size: 12px; opacity: .65; }
  header button { flex-shrink: 0; padding: 8px 12px; border: 1px solid #87867740; border-radius: 20px; background: none; font: inherit; font-size: 11px; cursor: pointer; }
  .preview-group + .preview-group { margin-top: 36px; }
  .preview-group > h2 { margin: 0 0 15px; font-size: 15px; font-weight: 500; }
  .poses { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 18px; }
  .pose { display: flex; flex-direction: column; align-items: center; min-width: 0; padding: 18px 10px 16px; border: 1px solid #87867730; border-radius: 14px; background: #ffffff55; }
  :global(.dark) .pose { background: #ffffff04; }
  .pose-heading { align-self: stretch; display: grid; gap: 4px; margin-bottom: 25px; padding: 0 4px; }
  .pose-heading > span { font-family: 'JetBrains Mono Variable', monospace; font-size: 10px; white-space: nowrap; opacity: .55; }
  h3 { margin: 0; font-size: 12px; font-weight: 400; opacity: .75; }
  aside { width: 160px; }
  .pose > a { margin-top: 26px; font-size: 10px; opacity: .6; }
  footer { display: flex; justify-content: space-between; gap: 16px; margin-top: 30px; }
  @media (max-width: 760px) {
    .preview { padding: 30px 20px; }
    header { align-items: flex-start; }
    h1 { font-size: 23px; }
    footer { flex-direction: column; }
  }
</style>
