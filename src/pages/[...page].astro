---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import { themeConfig } from '~/.config'
import Pagination from '~/components/Pagination.astro'
import HomeHero from '~/components/HomeHero.astro'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import EditorialPostItem from '~/components/EditorialPostItem.astro'
import { getPostDescription, getPosts } from '~/utils'

const { translate: t } = Astro.locals

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts()
  posts.sort((a, b) => {
    if (a.data.pin && !b.data.pin) return -1
    if (!a.data.pin && b.data.pin) return 1
    return 0
  })
  return paginate(posts, { pageSize: themeConfig.site.pageSize })
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { page } = Astro.props
---

<LayoutDefault>
  {page.currentPage === 1 && <HomeHero />}

  <!-- 3. 时间线编目分割线 -->
  <div
    class="flex items-center justify-between py-2.5 hairline-y mb-2 text-xs font-mono text-[var(--paper-muted)] select-none"
  >
    <span class="uppercase tracking-widest">— 2026 丙午 · 见字如面 —</span>
    <span class="hidden sm:inline">CHRONOLOGICAL ARCHIVE</span>
    <span>共 {page.total} 篇精选</span>
  </div>

  <!-- 4. 人文流式双栏时间线列表 (Disciplined Timeline Stream) -->
  <section contain-layout class="divide-y divide-[var(--paper-border)]">
    {page.data.map((post) => <EditorialPostItem post={post} description={getPostDescription(post)} />)}
  </section>

  <div class="pt-8">
    <Pagination
      showLeft={Boolean(page.url.prev)}
      leftTitle={t('prev')}
      leftUrl={page.url.prev}
      showRight={Boolean(page.url.next)}
      rightTitle={t('next')}
      rightUrl={page.url.next}
      currentPage={page.currentPage}
      totalPage={page.lastPage}
    />
  </div>
</LayoutDefault>
