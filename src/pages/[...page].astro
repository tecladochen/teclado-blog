---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import { themeConfig } from '~/.config'
import '~/styles/reading-design.css'
import Pagination from '~/components/Pagination.astro'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import EditorialPostItem from '~/components/EditorialPostItem.astro'
import { getPosts, getPostDescription } from '~/utils'

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts()
  posts.sort((a, b) => {
    if (a.data.pin && !b.data.pin) return -1
    if (!a.data.pin && b.data.pin) return 1
    return 0
  })
  return paginate(posts, { pageSize: themeConfig.site.pageSize })
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { page } = Astro.props
---

<LayoutDefault>
  <section class="editorial-index reading-design" aria-label="文章列表">
    {page.data.map((post) => <EditorialPostItem post={post} description={getPostDescription(post)} />)}
  </section>

  <div>
    <Pagination
      showLeft={Boolean(page.url.prev)}
      leftTitle="上一页"
      leftUrl={page.url.prev}
      showRight={Boolean(page.url.next)}
      rightTitle="下一页"
      rightUrl={page.url.next}
      currentPage={page.currentPage}
      totalPage={page.lastPage}
    />
  </div>
</LayoutDefault>

<style>
  .editorial-index {
    counter-reset: article-index;
    padding: 0 4px;
  }
  @media (max-width: 639px) {
    .editorial-index {
      padding: 0;
    }
  }
</style>
