---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import { themeConfig } from '~/.config'
import Pagination from '~/components/Pagination.astro'
import HomeHero from '~/components/HomeHero.astro'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import { getPosts } from '~/utils'

const { translate: t } = Astro.locals

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts()
  posts.sort((a, b) => {
    if (a.data.pin && !b.data.pin) return -1
    if (!a.data.pin && b.data.pin) return 1
    return 0
  })
  return paginate(posts, { pageSize: themeConfig.site.pageSize })
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { page } = Astro.props
---

<LayoutDefault>
  {page.currentPage === 1 && <HomeHero />}

  <!-- 文章区域标头 -->
  <div
    class="flex items-center justify-between pb-3 mb-6 border-b border-dashed border-black/[0.08] dark:border-white/[0.08]"
  >
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-neutral-900 dark:bg-neutral-100"></span>
      <span class="text-xs font-mono tracking-wider font-semibold text-neutral-900 dark:text-neutral-100 uppercase">
        ESSAYS & OBSERVATIONS · 生活文字与散步闲笔
      </span>
    </div>
    <div class="text-xs font-mono text-neutral-400 dark:text-neutral-500 tabular">共 4 篇手札 · 按时间序</div>
  </div>

  <!-- 文章流 -->
  <section contain-layout class="flex flex-col gap-5 sm:gap-6">
    <!-- 1. 真实读后感文章 -->
    <article
      class="post-entry bg-white dark:bg-neutral-900/80 border border-black/[0.065] dark:border-white/[0.08] rounded-2xl p-6 sm:p-7 flex flex-col gap-2.5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_8px_24px_-4px_rgba(0,0,0,0.06)] group"
    >
      <div
        class="flex items-center justify-between gap-2 text-xs text-neutral-400 dark:text-neutral-500 font-mono tabular"
      >
        <div class="flex items-center gap-2">
          <span
            class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 font-medium text-[11px]"
          >
            读书随笔
          </span>
          <span>·</span>
          <time datetime="2025-06-30">2025-06-30</time>
        </div>
        <div class="text-[11.5px] text-neutral-400 dark:text-neutral-500 hidden sm:block">
          约 14 小时精读 · 3,800 字札记
        </div>
      </div>

      <h2
        class="text-lg sm:text-[20px] font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 leading-snug m-0 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors"
      >
        <a href="/posts/leave-hometown/" class="not-underline-hover block"> 读《出延津记》：孤独与寻找说得着的人 </a>
      </h2>

      <p class="text-[14px] text-neutral-600 dark:text-neutral-400 leading-[1.75] m-0">
        读完《一句顶一万句》上篇《出延津记》后的随笔：从杨百顺辗转失意的人生，到老裴、来喜与老詹带来的短暂温暖，记录那些令人难忘的人物和情节。全书将近
        27 万字，在浮躁的快节奏里，重新审视人与人之间为何“说得着”如此艰难，又为何值得一生寻觅。
      </p>

      <div
        class="flex items-center justify-between pt-3 mt-1 border-t border-black/[0.04] dark:border-white/[0.05] text-xs"
      >
        <div class="text-neutral-500 dark:text-neutral-400 font-serif text-[12px] italic hidden sm:block">
          “一个人的孤独不是孤独，一个人找另一个人，一句话找另一句话，才是真正的孤独。”
        </div>
        <a
          href="/posts/leave-hometown/"
          class="not-underline-hover inline-flex items-center gap-1 font-medium text-neutral-700 dark:text-neutral-300 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors ml-auto"
        >
          <span>阅读随笔</span>
          <span class="text-xs transition-transform duration-200 group-hover:translate-x-1">→</span>
        </a>
      </div>
    </article>

    <!-- 2. 生活随笔占位 -->
    <article
      class="post-entry bg-white dark:bg-neutral-900/80 border border-black/[0.065] dark:border-white/[0.08] rounded-2xl p-6 sm:p-7 flex flex-col gap-2.5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_8px_24px_-4px_rgba(0,0,0,0.06)] group"
    >
      <div
        class="flex items-center justify-between gap-2 text-xs text-neutral-400 dark:text-neutral-500 font-mono tabular"
      >
        <div class="flex items-center gap-2">
          <span
            class="px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 font-medium text-[11px]"
          >
            生活随笔
          </span>
          <span>·</span>
          <time datetime="2026-06-18">2026-06-18</time>
        </div>
        <div class="text-[11.5px] text-neutral-400 dark:text-neutral-500 hidden sm:block">窗前偶得 · 2,140 字</div>
      </div>

      <h2
        class="text-lg sm:text-[20px] font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 leading-snug m-0 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors"
      >
        <a href="#memo" class="not-underline-hover block"> 杭州梅雨，与窗前的一盏旧茶 </a>
      </h2>

      <p class="text-[14px] text-neutral-600 dark:text-neutral-400 leading-[1.75] m-0">
        记刚搬到杭州时连绵半月的梅雨天。屋檐下滴答落下的雨水、空气里温润的泥土气息，以及在陌生城市街巷里撑伞闲逛时重新建立起的生活秩序。生活不需要时刻赶路，慢下来听一场雨，心境便安稳了许多。
      </p>

      <div
        class="flex items-center justify-between pt-3 mt-1 border-t border-black/[0.04] dark:border-white/[0.05] text-xs"
      >
        <div class="text-neutral-500 dark:text-neutral-400 font-serif text-[12px] italic hidden sm:block">
          “雨水洗净了叶片上的灰尘，也洗净了心底无端的焦虑。”
        </div>
        <a
          href="#memo"
          class="not-underline-hover inline-flex items-center gap-1 font-medium text-neutral-700 dark:text-neutral-300 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors ml-auto"
        >
          <span>阅读随笔</span>
          <span class="text-xs transition-transform duration-200 group-hover:translate-x-1">→</span>
        </a>
      </div>
    </article>

    <!-- 3. 街道漫步占位 -->
    <article
      class="post-entry bg-white dark:bg-neutral-900/80 border border-black/[0.065] dark:border-white/[0.08] rounded-2xl p-6 sm:p-7 flex flex-col gap-2.5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_8px_24px_-4px_rgba(0,0,0,0.06)] group"
    >
      <div
        class="flex items-center justify-between gap-2 text-xs text-neutral-400 dark:text-neutral-500 font-mono tabular"
      >
        <div class="flex items-center gap-2">
          <span
            class="px-2 py-0.5 rounded bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 font-medium text-[11px]"
          >
            散步闲笔
          </span>
          <span>·</span>
          <time datetime="2026-04-10">2026-04-10</time>
        </div>
        <div class="text-[11.5px] text-neutral-400 dark:text-neutral-500 hidden sm:block">黄昏手札 · 1,680 字</div>
      </div>

      <h2
        class="text-lg sm:text-[20px] font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 leading-snug m-0 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors"
      >
        <a href="#memo" class="not-underline-hover block"> 暮色散步，和那些未完成的草稿 </a>
      </h2>

      <p class="text-[14px] text-neutral-600 dark:text-neutral-400 leading-[1.75] m-0">
        傍晚出门漫无目的地走上一万步。看下班归家的人群、街角炒热栗子飘出的焦糖甜香，以及暮色沉沉下泛着微光的河道。在具体而微的市井声响里，文字不再是高深的概念推演，而是对真实人间最诚恳的注视。
      </p>

      <div
        class="flex items-center justify-between pt-3 mt-1 border-t border-black/[0.04] dark:border-white/[0.05] text-xs"
      >
        <div class="text-neutral-500 dark:text-neutral-400 font-serif text-[12px] italic hidden sm:block">
          “走在街头，看人间的烟火气一点点升起来，是治愈一切的良药。”
        </div>
        <a
          href="#memo"
          class="not-underline-hover inline-flex items-center gap-1 font-medium text-neutral-700 dark:text-neutral-300 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors ml-auto"
        >
          <span>阅读随笔</span>
          <span class="text-xs transition-transform duration-200 group-hover:translate-x-1">→</span>
        </a>
      </div>
    </article>

    <!-- 4. 案头生活占位 -->
    <article
      class="post-entry bg-white dark:bg-neutral-900/80 border border-black/[0.065] dark:border-white/[0.08] rounded-2xl p-6 sm:p-7 flex flex-col gap-2.5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_8px_24px_-4px_rgba(0,0,0,0.06)] group"
    >
      <div
        class="flex items-center justify-between gap-2 text-xs text-neutral-400 dark:text-neutral-500 font-mono tabular"
      >
        <div class="flex items-center gap-2">
          <span
            class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 font-medium text-[11px]"
          >
            案头杂记
          </span>
          <span>·</span>
          <time datetime="2026-02-15">2026-02-15</time>
        </div>
        <div class="text-[11.5px] text-neutral-400 dark:text-neutral-500 hidden sm:block">书桌闲话 · 1,920 字</div>
      </div>

      <h2
        class="text-lg sm:text-[20px] font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 leading-snug m-0 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors"
      >
        <a href="#memo" class="not-underline-hover block"> 在书桌上安顿日常的琐碎 </a>
      </h2>

      <p class="text-[14px] text-neutral-600 dark:text-neutral-400 leading-[1.75] m-0">
        周末花了一整个下午擦拭案头，换下积灰已久的旧键帽，削好两支铅笔。在清脆的敲击声和沙沙的书写声里，生活重新回到了可感触的秩序中。字不用写得太快，一笔一画，都是自己与岁月相处的见证。
      </p>

      <div
        class="flex items-center justify-between pt-3 mt-1 border-t border-black/[0.04] dark:border-white/[0.05] text-xs"
      >
        <div class="text-neutral-500 dark:text-neutral-400 font-serif text-[12px] italic hidden sm:block">
          “一张整洁的书桌，是一日生活的庇护所。”
        </div>
        <a
          href="#memo"
          class="not-underline-hover inline-flex items-center gap-1 font-medium text-neutral-700 dark:text-neutral-300 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors ml-auto"
        >
          <span>阅读随笔</span>
          <span class="text-xs transition-transform duration-200 group-hover:translate-x-1">→</span>
        </a>
      </div>
    </article>
  </section>

  <div class="pt-8">
    <Pagination
      showLeft={Boolean(page.url.prev)}
      leftTitle={t('prev')}
      leftUrl={page.url.prev}
      showRight={Boolean(page.url.next)}
      rightTitle={t('next')}
      rightUrl={page.url.next}
      currentPage={page.currentPage}
      totalPage={page.lastPage}
    />
  </div>
</LayoutDefault>
