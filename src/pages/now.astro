---
import { getEntry, render } from 'astro:content'
import SiteSeo from '~/components/SiteSeo.astro'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import { formatDate } from '~/utils'

const nowPost = await getEntry('spec', 'now')
if (!nowPost) {
  throw new Error('No now entry found')
}

const { Content } = await render(nowPost)
const updatedDate = nowPost.data.updatedDate ?? nowPost.data.pubDate
const { translate: t } = Astro.locals
---

<LayoutDefault>
  <SiteSeo slot="seo" title={`${nowPost.data.title} · 孤独终洁`} desc={nowPost.data.description} />

  <section class="now-page">
    <header class="now-header">
      <div>
        <span class="now-coordinate">STATUS / NOW</span>
        <h1 class="post-title">{nowPost.data.title}</h1>
      </div>
      <p class="now-updated">
        <span class="now-signal" aria-hidden="true"></span>
        {t('updated_at')}
        <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
      </p>
    </header>

    <p class="now-summary">{nowPost.data.summary}</p>

    <ul class="now-focus" aria-label={t('current_focus')}>
      {
        nowPost.data.focus.map((item, index) => (
          <li>
            <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            {item}
          </li>
        ))
      }
    </ul>

    <article class="prose now-content">
      <Content />
    </article>

    <nav class="now-explore" aria-label={t('quick_actions')}>
      <a href="/map">{t('view_knowledge_map')} <span aria-hidden="true">→</span></a>
      <a href="/journey">{t('view_journey')} <span aria-hidden="true">→</span></a>
    </nav>
  </section>
</LayoutDefault>

<style>
  .now-page {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .now-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--uno-colors-shadow);
  }

  .now-coordinate {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.68rem;
    line-height: 1.4;
    letter-spacing: 0.16em;
    opacity: 0.58;
  }

  .now-updated {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-size: 0.82rem;
    white-space: nowrap;
    opacity: 0.72;
  }

  .now-signal {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: currentColor;
  }

  .now-summary {
    max-width: 38rem;
    margin: 0;
    font-family: var(--uno-fonts-ui);
    font-size: clamp(1.2rem, 3vw, 1.55rem);
    font-weight: 700;
    line-height: 1.7;
  }

  .now-focus {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--uno-colors-shadow);
    border-bottom: 1px solid var(--uno-colors-shadow);
    list-style: none;
  }

  .now-focus li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
    padding: 0.9rem;
    line-height: 1.55;
  }

  .now-focus li + li {
    border-left: 1px solid var(--uno-colors-shadow);
  }

  .now-focus span {
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.48;
  }

  .now-content {
    margin-top: 0.25rem;
  }

  .now-explore {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    justify-content: flex-end;
    padding-top: 0.8rem;
    border-top: 1px solid var(--uno-colors-shadow);
    font-size: 0.82rem;
    font-weight: 700;
  }

  @media (prefers-reduced-motion: no-preference) {
    .now-signal {
      animation: signal-pulse 2.6s ease-in-out infinite;
    }
  }

  @keyframes signal-pulse {
    50% {
      box-shadow: 0 0 0 0.35rem var(--uno-colors-shadow);
      opacity: 0.5;
    }
  }

  @media (max-width: 640px) {
    .now-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.65rem;
    }

    .now-focus {
      grid-template-columns: 1fr;
    }

    .now-focus li + li {
      border-top: 1px solid var(--uno-colors-shadow);
      border-left: 0;
    }
  }
</style>
