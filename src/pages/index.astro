---
import Base from '~/layouts/Base.astro'
import FeaturedEssay from '~/components/FeaturedEssay.astro'
import DeskCard from '~/components/DeskCard.astro'
import HeroWordmark from '~/components/HeroWordmark.astro'
import Timeline from '~/components/Timeline.astro'
import { getPosts } from '~/lib/content'
import { site } from '~/site'

const posts = await getPosts()
const featured = posts[0]
const ticker = [...site.ticker, ...site.ticker]
const phrases = JSON.stringify(site.hero.phrases)
---

<Base>
  <section class="hero">
    <div class="hero-meta">
      <span>personal notes</span>
      <span>{site.now.title}</span>
    </div>
    <HeroWordmark />
    <h1 class="hero-title">
      <span>
        {site.hero.line1}<span class="punct">，</span>
      </span>
      <span>
        {site.hero.line2}<span class="punct">。</span>
      </span>
    </h1>
    <div class="hero-row">
      <div>
        <p class="hero-copy">{site.hero.lead}</p>
        <p class="hero-cycle" data-phrases={phrases}>
          {
            site.hero.phrases.map((phrase) => (
              <span class="hero-cycle-sizer" aria-hidden="true">
                {phrase}
              </span>
            ))
          }
          <span class="hero-cycle-now" data-phrase>
            {site.hero.phrases[0]}
          </span>
        </p>
        <p class="hero-actions">
          {
            featured && (
              <a class="primary" href={`/posts/${featured.id}/`}>
                打开这篇
              </a>
            )
          }
          <a href="/about/">about</a>
        </p>
      </div>
      <aside class="now-box">
        <span>{site.now.kicker}</span>
        <p>{site.now.body}</p>
      </aside>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {ticker.map((word) => <span>{word}</span>)}
    </div>
  </div>

  <section class="section" id="featured">
    <div class="section-head" data-reveal>
      <h2>on the desk</h2>
      <a href="/writing/">全部格子</a>
    </div>
    {featured && <FeaturedEssay post={featured} />}
  </section>

  <section class="section">
    <div class="section-head" data-reveal>
      <h2>marks</h2>
      <span class="section-note">痕迹，不是年表</span>
    </div>
    <Timeline items={site.marks} />
  </section>

  <section class="quote-band" data-reveal>
    <blockquote>
      {site.quote.text}
    </blockquote>
    <cite>— {site.quote.source}</cite>
  </section>

  <section class="section">
    <div class="section-head" data-reveal>
      <h2>reserved</h2>
      <span class="section-note">未写成 · 占位</span>
    </div>
    <div class="desk-grid">
      {site.desk.map((item) => <DeskCard item={item} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-head" data-reveal>
      <h2>materials</h2>
      <span class="section-note">还没变成文章的东西</span>
    </div>
    <div class="materials">
      {
        site.materials.map((item, index) => (
          <article class="material" data-magnetic data-reveal style={`--stagger: ${index}`}>
            <span>
              {item.no} · {item.kind}
            </span>
            <h3>{item.title}</h3>
            <p>{item.note}</p>
          </article>
        ))
      }
    </div>
  </section>
</Base>
