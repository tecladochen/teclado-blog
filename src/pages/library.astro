---
import { getCollection } from 'astro:content'
import LibraryImage from '~/components/LibraryImage.astro'
import SiteSeo from '~/components/SiteSeo.astro'
import albumData from '~/data/library/albums.json'
import workData from '~/data/library/works.json'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import { formatLibraryDate, getMusicArtists, getWorkCountLabel, getWorkDate, getWorkYears, sortMusicAlbums, sortWorks, workTypes } from '~/utils/library'

const [workEntries, artistEntries, albumEntries] = await Promise.all([
  getCollection('library'),
  getCollection('musicArtists'),
  getCollection('musicAlbums'),
])
const works = sortWorks(workEntries.filter(work => work.data.status === 'completed'), workData.map(work => work.id))
const albums = sortMusicAlbums(albumEntries, albumData.map(album => album.id))
const artists = getMusicArtists(artistEntries, albums)
const artistNames = new Map(artists.map(artist => [artist.id, artist.data.name]))
const eagerWorkCovers = new Set(works.slice(0, 5).map(work => work.id))
function countLabel(entries: typeof works) {
  return getWorkCountLabel(entries.map(work => work.data.type))
}
const groups = getWorkYears(works).map(([year]) => ({ year, works: works.filter(work => getWorkDate(work.data)?.startsWith(year)) }))
function dateLabel(data: typeof works[number]['data']) {
  return data.completedOn ? (data.type === 'book' ? '读完' : '看完') : ({ book: '出版', movie: '上映', series: '首播' } as const)[data.type]
}
function dateTitle(data: typeof works[number]['data']) {
  const date = formatLibraryDate(getWorkDate(data)!)
  return `${dateLabel(data)}于${date}`
}
const icons = { book: 'i-tabler-book', movie: 'i-tabler-movie', series: 'i-tabler-device-tv' }
const categories = { all: '全部', ...workTypes, music: '音乐' }
---

<LayoutDefault>
  <SiteSeo slot="seo" title="书影音" desc="Teclado 读过的书、看过的电影与剧集，以及喜欢的专辑。" />
  <section class="library-page" data-library-page>
    <header class="library-header">
      <h1>书影音</h1>
      <p class="library-summary" data-view-summary aria-live="polite">{countLabel(works)}</p>
    </header>

    <div class="library-categories" role="tablist" aria-label="作品分类">
      {Object.entries(categories).map(([category, label]) => (
        <button id={`category-${category}`} type="button" role="tab" aria-selected={category === 'all'} aria-controls={category === 'music' ? 'music-panel' : 'shelf-panel'} tabindex={category === 'all' ? 0 : -1} data-category={category}>{label}</button>
      ))}
    </div>

    <section id="shelf-panel" role="tabpanel" aria-labelledby="category-all" data-panel="shelf">
      <div class="shelf-archive">
        {groups.map(group => (
          <section class="shelf-group" data-shelf-group>
            <header class="shelf-year-heading"><h2>{group.year}</h2><span data-group-count>{countLabel(group.works)}</span></header>
            <ul class="shelf-grid" aria-label={`${group.year} 年的作品`}>
              {group.works.map(({ id, data }) => (
                <li class="work-card" id={`work-${id}`} data-work data-type={data.type}>
                  {data.url ? <a href={data.url} target="_blank" rel="noopener noreferrer" class="cover-link not-underline-hover" aria-label={`查看${data.title}详情（新窗口）`}><LibraryImage image={data.cover} title={`${data.title}封面`} icon={icons[data.type]} loading={eagerWorkCovers.has(id) ? 'eager' : 'lazy'} /></a> : <LibraryImage image={data.cover} title={`${data.title}封面`} icon={icons[data.type]} loading={eagerWorkCovers.has(id) ? 'eager' : 'lazy'} />}
                  <h3>{data.url ? <a href={data.url} target="_blank" rel="noopener noreferrer" aria-label={`查看${data.title}详情（新窗口）`}>{data.title}<span class="i-tabler-arrow-up-right ml-1 h-3 w-3" aria-hidden="true" /></a> : data.title}</h3>
                  {data.creator && <p class="work-creator" title={data.creator}>{data.creator}</p>}
                  <p class="work-meta"><span>{workTypes[data.type]}</span>{getWorkDate(data) && <time datetime={getWorkDate(data)} title={dateTitle(data)} aria-label={dateTitle(data)}><span class="date-label">{dateLabel(data)}</span>{getWorkDate(data)!.replaceAll('-', '.')}</time>}</p>
                  {data.note && <p class="collection-note">{data.note}</p>}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <div class="library-empty" data-work-empty hidden={works.length > 0}><span class="i-tabler-books h-7 w-7" aria-hidden="true" /><p>这里还没有作品。</p></div>
    </section>

    <section id="music-panel" role="tabpanel" aria-labelledby="category-music" data-panel="music" hidden>
      <h2 class="album-heading">喜欢的专辑</h2>
      <ul class="shelf-grid album-grid" aria-label="喜欢的专辑">
        {albums.map(({ id, data }, index) => (
          <li class="work-card album-card" id={`album-${id}`}>
            <LibraryImage image={data.cover} title={`${data.title}专辑封面`} shape="square" icon="i-tabler-disc" loading={index < 5 ? 'eager' : 'lazy'} scale={data.coverScale} />
            <h3>{data.title}</h3>
            <p class="work-creator" title={data.artists.map(artist => artistNames.get(artist.id)).join(' / ')}>{data.artists.map(artist => artistNames.get(artist.id)).join(' / ')}</p>
            {data.note && <p class="collection-note">{data.note}</p>}
            {data.url && <a class="album-listen" href={data.url} target="_blank" rel="noopener noreferrer" aria-label={`收听${data.title}（新窗口）`}>收听专辑 <span class="i-tabler-arrow-up-right h-3 w-3" aria-hidden="true" /></a>}
          </li>
        ))}
      </ul>
      <div class="library-empty" hidden={albums.length > 0}><span class="i-tabler-disc h-7 w-7" aria-hidden="true" /><p>这里还没有专辑。</p></div>
    </section>
  </section>
</LayoutDefault>

<script>
import type { LibraryWork } from '~/utils/library'
import { getWorkCountLabel, workTypes } from '~/utils/library'

function initializeLibrary() {
  const page = document.querySelector<HTMLElement>('[data-library-page]')
  if (!page || page.dataset.ready === 'true')
    return
  page.dataset.ready = 'true'
  const tabs = Array.from(page.querySelectorAll<HTMLButtonElement>('[data-category]'))
  const cards = Array.from(page.querySelectorAll<HTMLElement>('[data-work]'))
  const shelf = page.querySelector<HTMLElement>('[data-panel="shelf"]')!
  const music = page.querySelector<HTMLElement>('[data-panel="music"]')!
  const summary = page.querySelector<HTMLElement>('[data-view-summary]')!
  const empty = page.querySelector<HTMLElement>('[data-work-empty]')!
  const groups = Array.from(page.querySelectorAll<HTMLElement>('[data-shelf-group]')).map(element => ({
    element,
    cards: Array.from(element.querySelectorAll<HTMLElement>('[data-work]')),
    count: element.querySelector<HTMLElement>('[data-group-count]')!,
  }))
  const countLabel = (entries: HTMLElement[]) => getWorkCountLabel(entries.map(card => card.dataset.type as LibraryWork['data']['type']))
  // Calculate the four shelf views once; switching only updates the existing DOM.
  const views = new Map(['all', ...Object.keys(workTypes)].map((category) => {
    const matches = (card: HTMLElement) => category === 'all' || card.dataset.type === category
    const entries = cards.filter(matches)
    return [category, {
      entries: new Set(entries),
      summary: countLabel(entries),
      groups: groups.map((group) => {
        const entries = group.cards.filter(matches)
        return { ...group, entries, summary: countLabel(entries) }
      }),
    }]
  }))
  const albumSummary = `${music.querySelectorAll('.album-card').length} 张专辑`
  let activeCategory: string | undefined
  let requestedCategory: string | undefined
  let transition: Animation | undefined
  let transitionSequence = 0
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

  function updateTabs(category: string) {
    tabs.forEach((tab) => {
      const selected = tab.dataset.category === category
      tab.setAttribute('aria-selected', String(selected))
      tab.tabIndex = selected ? 0 : -1
    })
  }

  function apply(category: string, updateUrl = true) {
    activeCategory = category
    updateTabs(category)
    shelf.hidden = category === 'music'
    music.hidden = category !== 'music'
    const view = views.get(category)
    if (view) {
      shelf.setAttribute('aria-labelledby', `category-${category}`)
      cards.forEach((card) => {
        const hidden = !view.entries.has(card)
        if (card.hidden !== hidden)
          card.hidden = hidden
      })
      view.groups.forEach((group) => {
        group.element.hidden = group.entries.length === 0
        group.count.textContent = group.summary
      })
      empty.hidden = view.entries.size > 0
      summary.textContent = view.summary
    }
    else {
      summary.textContent = albumSummary
    }
    if (!updateUrl)
      return
    const url = new URL(location.href)
    for (const obsolete of ['status', 'year', 'artist', 'q'])
      url.searchParams.delete(obsolete)
    if (category === 'all')
      url.searchParams.delete('category')
    else
      url.searchParams.set('category', category)
    history.replaceState(history.state, '', url)
  }

  async function select(category: string) {
    if (requestedCategory === category)
      return
    requestedCategory = category
    const sequence = ++transitionSequence
    const previous = activeCategory === 'music' ? music : shelf
    const opacity = getComputedStyle(previous).opacity
    transition?.cancel()
    updateTabs(category)
    if (reducedMotion.matches) {
      apply(category)
      return
    }
    // Match the journey filter's fade timings; the latest click always wins.
    const exit = transition = previous.animate(
      [{ opacity }, { opacity: 0 }],
      { duration: 120, easing: 'cubic-bezier(0.4, 0, 1, 1)', fill: 'forwards' },
    )
    await exit.finished.catch(() => undefined)
    if (sequence !== transitionSequence || !page?.isConnected) {
      exit.cancel()
      return
    }
    apply(category)
    exit.cancel()
    const next = category === 'music' ? music : shelf
    const enter = transition = next.animate(
      [{ opacity: 0 }, { opacity: 1 }],
      { duration: 200, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'both' },
    )
    await enter.finished.catch(() => undefined)
    enter.cancel()
    if (transition === enter)
      transition = undefined
  }
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => void select(tab.dataset.category!))
    tab.addEventListener('keydown', (event) => {
      const next = event.key === 'ArrowRight' ? (index + 1) % tabs.length : event.key === 'ArrowLeft' ? (index + tabs.length - 1) % tabs.length : event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : undefined
      if (next === undefined)
        return
      event.preventDefault()
      void select(tabs[next].dataset.category!)
      tabs[next].focus({ preventScroll: true })
    })
  })
  const category = new URLSearchParams(location.search).get('category')
  requestedCategory = tabs.some(tab => tab.dataset.category === category) ? category! : 'all'
  apply(requestedCategory, false)
}
initializeLibrary()
document.addEventListener('astro:page-load', initializeLibrary)
</script>

<style>
  .library-page { font-family: var(--uno-fonts-ui); }
  .library-page [hidden] { display: none !important; }
  .library-header { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8px 16px; margin-bottom: 14px; }
  h1 { margin: 0; font-size: 18px; font-weight: 500; letter-spacing: 0.03em; }
  h2 { margin: 0; color: var(--theme-sub); font-size: 13px; font-weight: 500; }
  .library-summary { margin: 0; color: var(--theme-muted); font-size: 11px; line-height: 1.6; }
  .library-categories { display: flex; align-items: center; gap: 26px; margin-bottom: 24px; border-bottom: 1px solid var(--theme-border); }
  .library-categories button { position: relative; min-height: 44px; touch-action: manipulation; padding: 12px 0 13px; border: 0; background: transparent; color: var(--theme-muted); font: inherit; font-size: 12px; cursor: pointer; white-space: nowrap; transition: color 160ms ease, transform 280ms cubic-bezier(0.22, 1, 0.36, 1); }
  .library-categories button::after { position: absolute; right: 0; bottom: -1px; left: 0; height: 1px; background: currentColor; content: ''; transform: scaleX(0); transform-origin: right; transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1); }
  .library-categories button[aria-selected='true']::after, .library-categories button:hover::after, .library-categories button:focus-visible::after { transform: scaleX(1); transform-origin: left; }
  .library-categories button:hover, .library-categories button:focus-visible { transform: translateY(-1px); }
  .library-categories button[aria-selected='true'], .library-categories button:hover { color: var(--uno-colors-primary); }
  .library-categories button:focus-visible { outline: 2px solid var(--theme-interactive); outline-offset: 5px; border-radius: 2px; }
  .shelf-archive { display: grid; gap: 40px; }
  .shelf-year-heading { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px 14px; margin-bottom: 16px; }
  .shelf-year-heading h2 { color: var(--uno-colors-primary); font-size: 22px; font-weight: 400; }
  .shelf-year-heading span { color: var(--theme-muted); font-size: 10px; }
  .shelf-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 32px 24px; margin: 0; padding: 0; list-style: none; }
  .work-card { min-width: 0; }
  .cover-link { display: block; }
  .cover-link:hover { opacity: 0.9; }
  .work-card h3 { margin: 12px 0 0; font-size: 14px; font-weight: 500; line-height: 1.6; overflow-wrap: anywhere; }
  .work-card h3 a { color: inherit; }
  .work-creator { overflow: hidden; margin: 4px 0 0; color: var(--theme-sub); font-size: 12px; line-height: 1.6; white-space: nowrap; text-overflow: ellipsis; }
  .work-meta { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 4px; margin: 7px 0 0; color: var(--theme-muted); font-size: 11px; }
  .work-meta time { white-space: nowrap; font-family: 'JetBrains Mono Variable', monospace; font-size: 10px; }
  .date-label { margin-right: 4px; font-family: var(--uno-fonts-ui); font-size: 9px; }
  .collection-note { margin: 9px 0 0; color: var(--theme-sub); font-size: 11px; line-height: 1.8; overflow-wrap: anywhere; }
  .library-empty { display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 14px; min-height: 220px; color: var(--theme-muted); }
  .library-empty p { margin: 0; font-size: 12px; }
  .album-heading { margin-bottom: 16px; }
  .album-card h3 { margin-top: 10px; line-height: 1.5; }
  .album-card .work-creator { margin-top: 2px; font-size: 11px; line-height: 1.5; }
  .album-listen { display: inline-flex; align-items: center; gap: 4px; margin-top: 8px; color: var(--theme-interactive); font-size: 11px; }
  @media (prefers-reduced-motion: reduce) {
    .library-categories button, .library-categories button::after { transition: none; }
    .library-categories button:hover, .library-categories button:focus-visible { transform: none; }
  }
  @media (max-width: 760px) { .shelf-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 20px; } }
  @media (max-width: 560px) {
    .library-header { align-items: start; flex-direction: column; gap: 5px; }
    .library-summary { font-size: 10px; }
    .library-categories { justify-content: space-between; gap: 16px; }
    .library-categories button { font-size: 12px; }
    .shelf-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 20px; }
    .work-card h3 { font-size: 13px; }
    .work-creator { font-size: 11px; }
    .work-meta { font-size: 10px; }
    .work-meta time { font-size: 9px; }
  }
</style>
