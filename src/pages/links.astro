---
import { friendLinks, myBlogInfo } from '~/.config'
import Waline from '~/components/comments/Waline.astro'
import SiteSeo from '~/components/SiteSeo.astro'
import LayoutDefault from '~/layouts/LayoutDefault.astro'

const friendLinkProfile = [
  `名称：${myBlogInfo.name}`,
  `描述：${myBlogInfo.desc}`,
  `网址：${myBlogInfo.url}`,
  myBlogInfo.feed ? `订阅：${myBlogInfo.feed}` : '',
  myBlogInfo.avatar ? `Logo：${myBlogInfo.avatar}` : '',
]
  .filter(Boolean)
  .join('\n')
const exchangeInfoList = [
  { label: '名称', value: myBlogInfo.name },
  { label: '描述', value: myBlogInfo.desc, isDesc: true },
  { label: '网址', value: myBlogInfo.url, isLink: true },
  ...(myBlogInfo.feed ? [{ label: '订阅', value: myBlogInfo.feed, isLink: true }] : []),
  ...(myBlogInfo.avatar ? [{ label: 'Logo', value: myBlogInfo.avatar, isLink: true, isAvatar: true }] : []),
]
---

<LayoutDefault>
  <SiteSeo slot="seo" title="友链" desc="Teclado 常访问的个人博客与独立站点。" />

  <section class="links-page" data-links-page>
    <h1 class="visually-hidden">友链</h1>
    <section class="site-info-box" data-site-info>
      <button class="site-info-summary" type="button" aria-expanded="false" aria-controls="site-info-panel">
        <span class="directory-count">{String(friendLinks.length).padStart(2, '0')} SITES</span>
        <span class="exchange-label">交换友链 <span aria-hidden="true">＋</span></span>
      </button>
      <div class="site-info-panel" id="site-info-panel" data-site-info-panel aria-hidden="true" inert>
        <div class="site-info-content">
          <div class="site-info-sheet">
            <div class="site-info-tools">
              <span class="site-info-kicker">TECLADO.INFO</span>
              <button
                type="button"
                class="copy-button"
                data-copy-value={friendLinkProfile}
                aria-label="复制全部友链资料"
              >
                <span class="copy-icon" aria-hidden="true">
                  <span class="copy-icon-default i-tabler-copy h-3.5 w-3.5"></span>
                  <span class="copy-icon-success i-tabler-check h-3.5 w-3.5"></span>
                </span>
                <span class="copy-label" aria-hidden="true">
                  <span class="copy-label-default">复制全部</span>
                  <span class="copy-label-success">已复制</span>
                </span>
                <span class="visually-hidden" data-copy-status aria-live="polite"></span>
              </button>
            </div>
            <dl class="site-info-list">
              {
                exchangeInfoList.map(item => (
                  <div class="info-row">
                    <dt>{item.label}</dt>
                    <dd class="info-val">
                      {item.isLink
? (
                        <a class="info-link not-underline-hover" href={item.value} target="_blank" rel="noopener noreferrer">
                          {item.isAvatar && (
                            <img
                              src="/favicon.svg"
                              alt=""
                              width="16"
                              height="16"
                              loading="lazy"
                              class="info-avatar-preview"
                              onerror="this.style.display='none'"
                            />
                          )}
                          <code>{item.value}</code>
                        </a>
                      )
: (
                        <span class:list={['info-text', { 'info-desc': item.isDesc }]}>{item.value}</span>
                      )}
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </div>
    </section>

    <ol class="links-list">
      {
        friendLinks.map(link => (
          <li class="friend-row" data-friend-row>
            <div class="friend-avatar-wrap">
              <div class:list={['friend-avatar-placeholder', { 'is-hidden': Boolean(link.avatar) }]} aria-hidden="true">
                {link.name.slice(0, 1)}
              </div>
              {link.avatar && (
                <img
                  src={link.avatar}
                  alt=""
                  width="44"
                  height="44"
                  loading="lazy"
                  class="friend-avatar"
                  onerror="this.style.display='none';this.previousElementSibling?.classList.remove('is-hidden')"
                />
              )}
            </div>
            <div class="friend-identity">
              <h2>
                <a href={link.url} target="_blank" rel="noopener noreferrer">
                  {link.name}
                </a>
              </h2>
              {link.author && (
                <span class="friend-author">
                  <span class="friend-author-prefix">@</span>
                  <span class="friend-author-name">{link.author}</span>
                </span>
              )}
            </div>
            <p class="friend-description">{link.desc}</p>
            <div class="friend-tags" aria-label="标签">
              {link.tags?.slice(0, 3).map(tag => (
                <span>{tag}</span>
              ))}
            </div>
            <div class="friend-actions">
              {link.feed && (
                <a
                  href={link.feed}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="friend-feed not-underline-hover"
                  title="RSS 订阅"
                  aria-label={`${link.name} RSS 订阅`}
                >
                  <span class="i-tabler-rss h-3.5 w-3.5" aria-hidden="true" />
                </a>
              )}
              <span class="friend-arrow" aria-hidden="true">
                ↗
              </span>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="links-comments">
      <Waline
        path="/links/"
        heading="留言"
        description="申请友链或随便聊聊，留言将在审核后显示。"
        placeholder="想交换友链的话，请留下名称、网址、描述和头像地址…"
      />
    </div>

    <script is:inline>
      ;(() => {
        const page = document.querySelector('[data-links-page]')
        if (!page || page.dataset.ready === 'true') {
          return
        }
        page.dataset.ready = 'true'

        const rows = Array.from(page.querySelectorAll('[data-friend-row]'))
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        const siteInfo = page.querySelector('[data-site-info]')
        const siteInfoButton = siteInfo?.querySelector('button')
        const siteInfoPanel = siteInfo?.querySelector('[data-site-info-panel]')
        const copyButtons = Array.from(page.querySelectorAll('[data-copy-value]'))
        const copyTimers = new WeakMap()

        siteInfoButton?.addEventListener('click', () => {
          const isOpen = siteInfoButton.getAttribute('aria-expanded') === 'true'
          siteInfoButton.setAttribute('aria-expanded', String(!isOpen))
          siteInfoPanel?.setAttribute('aria-hidden', String(isOpen))
          if (siteInfoPanel) {
            siteInfoPanel.inert = isOpen
          }
          siteInfo?.classList.toggle('is-open', !isOpen)
        })

        copyButtons.forEach((button) => {
          button.addEventListener('click', async () => {
            const value = button.dataset.copyValue || ''
            const status = button.querySelector('[data-copy-status]')
            const originalLabel = button.dataset.copyLabel || button.getAttribute('aria-label') || '复制'
            const currentTimer = copyTimers.get(button)

            button.dataset.copyLabel = originalLabel

            if (currentTimer) {
              window.clearTimeout(currentTimer)
            }

            try {
              await navigator.clipboard.writeText(value)
              button.classList.add('is-copied')
              button.setAttribute('aria-label', `已${originalLabel}`)
              if (status) {
                status.textContent = '已复制'
              }

              const timer = window.setTimeout(() => {
                button.classList.remove('is-copied')
                button.setAttribute('aria-label', originalLabel)
                if (status) {
                  status.textContent = ''
                }
                copyTimers.delete(button)
              }, 1400)
              copyTimers.set(button, timer)
            }
            catch {
              if (status) {
                status.textContent = '复制失败，请重试'
              }
            }
          })
        })

        if (reducedMotion || !('IntersectionObserver' in window)) {
          rows.forEach(row => row.classList.add('is-visible'))
          return
        }

        page.dataset.motionReady = 'true'
        const observer = new IntersectionObserver(
          (entries) => {
            const visibleEntries = entries
              .filter(entry => entry.isIntersecting)
              .sort((a, b) => rows.indexOf(a.target) - rows.indexOf(b.target))

            visibleEntries.forEach((entry, index) => {
              window.setTimeout(() => entry.target.classList.add('is-visible'), Math.min(index * 54, 216))
              observer.unobserve(entry.target)
            })
          },
          { rootMargin: '0px 0px -7% 0px', threshold: 0.08 },
        )

        rows.forEach(row => observer.observe(row))
      })()
    </script>
  </section>
</LayoutDefault>

<style>
  .links-page {
    --friends-ink: #2e5946;
    --friends-wash: rgba(46, 89, 70, 0.075);
    --friends-line: rgba(46, 89, 70, 0.34);
    --friends-serif: 'Songti SC', 'Noto Serif CJK SC', 'Source Han Serif SC', STSong, SimSun, Georgia, serif;
    margin-top: clamp(-1.5rem, -2.6vw, -0.8rem);
  }

  :global(.dark) .links-page {
    --friends-ink: #9ab8a8;
    --friends-wash: rgba(112, 151, 130, 0.12);
    --friends-line: rgba(154, 184, 168, 0.4);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .site-info-box {
    border: 0;
  }

  .site-info-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 2.85rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    border-bottom: 1px solid var(--theme-border);
  }

  .directory-count {
    color: var(--theme-muted);
    font:
      9px/1 'JetBrains Mono Variable',
      monospace;
    letter-spacing: 0.14em;
  }

  .exchange-label {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--theme-sub);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    transition:
      color 200ms ease,
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-info-summary:hover .exchange-label {
    color: var(--friends-ink);
  }

  .exchange-label span {
    display: inline-block;
    font-size: 0.9rem;
    transform-origin: center;
    transition: transform 480ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-info-box.is-open .exchange-label span {
    transform: rotate(45deg);
  }

  .site-info-summary:hover .exchange-label span {
    transform: scale(1.12);
  }

  .site-info-box.is-open .site-info-summary:hover .exchange-label span {
    transform: rotate(45deg) scale(1.12);
  }

  .site-info-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    will-change: grid-template-rows, opacity;
    transition:
      grid-template-rows 520ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 180ms ease;
  }

  .site-info-box.is-open .site-info-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .site-info-content {
    min-height: 0;
    overflow: hidden;
  }

  .site-info-sheet {
    position: relative;
    margin: 0.95rem 0 1.55rem;
    padding: clamp(1rem, 2.5vw, 1.45rem) clamp(0.9rem, 3vw, 1.7rem) clamp(0.85rem, 2vw, 1.2rem);
    overflow: hidden;
    border: 0;
    border-radius: 2px;
    background:
      radial-gradient(circle at 88% 8%, rgba(46, 89, 70, 0.105), transparent 27%),
      linear-gradient(118deg, rgba(46, 89, 70, 0.095), rgba(46, 89, 70, 0.035) 58%, rgba(122, 81, 72, 0.035));
    box-shadow: 0 14px 36px -32px rgba(27, 48, 38, 0.55);
    transform: translateY(-6px);
    transform-origin: top center;
    will-change: transform;
    transition: transform 480ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-info-sheet::after {
    position: absolute;
    top: -2.3rem;
    right: clamp(4.6rem, 11vw, 8rem);
    width: 7rem;
    height: 7rem;
    border-radius: 50%;
    background: rgba(248, 248, 244, 0.32);
    content: '';
    pointer-events: none;
  }

  :global(.dark) .site-info-sheet {
    background:
      radial-gradient(circle at 88% 8%, rgba(154, 184, 168, 0.13), transparent 27%),
      linear-gradient(118deg, rgba(112, 151, 130, 0.13), rgba(112, 151, 130, 0.055) 58%, rgba(208, 164, 154, 0.045));
    box-shadow: 0 18px 42px -32px rgba(0, 0, 0, 0.9);
  }

  :global(.dark) .site-info-sheet::after {
    background: rgba(24, 22, 20, 0.24);
  }

  .site-info-box.is-open .site-info-sheet {
    opacity: 1;
    transform: translateY(0);
  }

  .site-info-tools {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    padding: 0 0.2rem 0.3rem;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 180ms ease,
      transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-info-box.is-open .site-info-tools {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 80ms;
  }

  .site-info-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--friends-ink);
    font:
      10px/1 'JetBrains Mono Variable',
      monospace;
    letter-spacing: 0.17em;
  }

  .site-info-kicker::before {
    width: 1.15rem;
    height: 2px;
    background: currentColor;
    content: '';
    opacity: 0.62;
  }

  .site-info-list {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
  }

  .info-row {
    display: grid;
    grid-template-columns: 3.15rem minmax(0, 1fr);
    align-items: center;
    column-gap: 0.55rem;
    min-height: 1.75rem;
    margin: 0;
    padding: 0.08rem 0.3rem;
    opacity: 0;
    transform: translateY(-3px);
    transition:
      opacity 180ms ease,
      transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-info-box.is-open .info-row {
    opacity: 1;
    transform: translateY(0);
  }

  .site-info-box.is-open .info-row:nth-child(1) {
    transition-delay: 100ms, 100ms;
  }

  .site-info-box.is-open .info-row:nth-child(2) {
    transition-delay: 125ms, 125ms;
  }

  .site-info-box.is-open .info-row:nth-child(3) {
    transition-delay: 150ms, 150ms;
  }

  .site-info-box.is-open .info-row:nth-child(4) {
    transition-delay: 175ms, 175ms;
  }

  .site-info-box.is-open .info-row:nth-child(5) {
    transition-delay: 200ms, 200ms;
  }

  .info-row dt {
    color: var(--theme-muted);
    font:
      10px/1 'JetBrains Mono Variable',
      monospace;
    letter-spacing: 0.12em;
  }

  .info-val {
    display: flex;
    align-items: center;
    min-width: 0;
    margin: 0;
  }

  .info-text {
    color: var(--uno-colors-primary);
    font-family: var(--friends-serif);
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: 0.02em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .info-desc {
    color: var(--theme-sub);
    font-weight: 400;
    font-size: 0.8rem;
    letter-spacing: 0.01em;
  }

  .info-link {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    min-width: 0;
    max-width: 100%;
    color: var(--uno-colors-primary);
    font-size: 0.74rem;
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 160ms ease;
  }

  .info-link:hover {
    color: var(--friends-ink);
  }

  .info-link code {
    padding: 0;
    background: transparent;
    color: inherit;
    font:
      0.74rem/1.45 'JetBrains Mono Variable',
      monospace;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .info-avatar-preview {
    display: block;
    width: 14px;
    height: 14px;
    padding: 1px;
    border-radius: 2px;
    flex-shrink: 0;
    border: 0;
    background: rgba(248, 248, 244, 0.55);
  }

  :global(.dark) .info-avatar-preview {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
    filter: invert(0.9);
  }

  .copy-button {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.32rem;
    min-width: 4.85rem;
    padding: 0.3rem 0;
    border: 0;
    background: transparent;
    color: var(--theme-sub);
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition:
      color 180ms ease,
      opacity 120ms ease;
  }

  .copy-button:hover {
    color: var(--friends-ink);
  }

  .copy-button.is-copied {
    color: var(--friends-ink);
  }

  .copy-button:active {
    opacity: 0.72;
  }

  .copy-icon {
    position: relative;
    width: 0.875rem;
    height: 0.875rem;
    overflow: hidden;
  }

  .copy-icon-default,
  .copy-icon-success {
    position: absolute;
    inset: 0;
    transition:
      opacity 140ms ease,
      transform 220ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .copy-icon-success {
    opacity: 0;
    transform: translateY(4px);
  }

  .is-copied .copy-icon-default {
    opacity: 0;
    transform: translateY(-4px);
  }

  .is-copied .copy-icon-success {
    opacity: 1;
    transform: translateY(0);
  }

  .copy-label {
    display: grid;
    min-width: 2.72rem;
    justify-items: start;
    text-align: left;
  }

  .copy-label-default,
  .copy-label-success {
    grid-area: 1 / 1;
    transition: opacity 140ms ease;
  }

  .copy-label-success {
    opacity: 0;
  }

  .is-copied .copy-label-default {
    opacity: 0;
  }

  .is-copied .copy-label-success {
    opacity: 1;
  }

  .links-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    margin: clamp(1.6rem, 4vw, 2.6rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .links-comments {
    margin-top: clamp(2.7rem, 5.5vw, 3.8rem);
  }

  .friend-row {
    position: relative;
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    grid-template-rows: repeat(3, auto);
    align-items: center;
    gap: 0 0.8rem;
    min-height: 140px;
    padding: 0.82rem 0.9rem;
    overflow: hidden;
    border: 1px solid var(--theme-border);
    isolation: isolate;
    transition:
      border-color 300ms ease,
      box-shadow 400ms ease;
  }

  .friend-row::before {
    position: absolute;
    z-index: 0;
    inset: 0;
    background: var(--friends-wash);
    clip-path: circle(0 at 93% 8%);
    content: '';
    transition: clip-path 620ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .friend-row:is(:hover, :focus-within) {
    border-color: var(--friends-line);
    box-shadow: 0 9px 24px rgba(25, 45, 35, 0.045);
  }

  .friend-row:is(:hover, :focus-within)::before {
    clip-path: circle(145% at 93% 8%);
  }

  .friend-row > * {
    position: relative;
    z-index: 1;
  }

  .links-page[data-motion-ready='true'] .friend-row:not(.is-visible) {
    opacity: 0;
  }

  .links-page[data-motion-ready='true'] .friend-row:nth-child(odd):not(.is-visible) {
    transform: translate3d(-18px, 10px, 0) rotate(-0.45deg);
  }

  .links-page[data-motion-ready='true'] .friend-row:nth-child(even):not(.is-visible) {
    transform: translate3d(18px, 10px, 0) rotate(0.45deg);
  }

  .friend-row.is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0) rotate(0);
    transition:
      opacity 500ms ease,
      transform 680ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 300ms ease,
      box-shadow 400ms ease;
  }

  .friend-avatar-wrap {
    position: relative;
    width: 40px;
    height: 40px;
  }

  .friend-avatar,
  .friend-avatar-placeholder {
    width: 40px;
    height: 40px;
    border: 1px solid var(--theme-border);
    border-radius: 3px;
  }

  .friend-avatar {
    position: absolute;
    inset: 0;
    display: block;
    object-fit: cover;
    filter: grayscale(0.3) contrast(0.96);
    transition:
      filter 260ms ease,
      transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .friend-avatar-placeholder {
    display: grid;
    place-items: center;
    color: var(--theme-sub);
    font-family: var(--friends-serif);
    font-size: 0.9rem;
  }

  .friend-avatar-placeholder.is-hidden {
    display: none;
  }

  .friend-row:is(:hover, :focus-within) .friend-avatar {
    filter: grayscale(0);
    transform: rotate(-4deg) scale(1.07);
  }

  .friend-identity {
    min-width: 0;
  }

  .friend-identity h2 {
    margin: 0;
    overflow: hidden;
    font-family: var(--friends-serif);
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .friend-identity h2 a::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    content: '';
  }

  .friend-row:is(:hover, :focus-within) .friend-identity h2 {
    transform: translateX(4px);
  }

  .friend-author {
    display: flex;
    align-items: baseline;
    gap: 0.12rem;
    max-width: 100%;
    margin-top: 0.16rem;
    overflow: hidden;
    color: var(--theme-muted);
    font-size: 0.61rem;
    text-overflow: ellipsis;
