---
import { friendLinks, myBlogInfo } from '~/.config'
import SiteSeo from '~/components/SiteSeo.astro'
import LayoutDefault from '~/layouts/LayoutDefault.astro'

const friendLinkProfile = [
  `名称：${myBlogInfo.name}`,
  `描述：${myBlogInfo.desc}`,
  `网址：${myBlogInfo.url}`,
  myBlogInfo.feed ? `订阅：${myBlogInfo.feed}` : '',
  myBlogInfo.avatar ? `Logo：${myBlogInfo.avatar}` : '',
]
  .filter(Boolean)
  .join('\n')
---

<LayoutDefault>
  <SiteSeo slot="seo" title="友链" desc="Teclado 常访问的个人博客与独立站点。" />

  <section class="links-page" data-links-page>
    <h1 class="visually-hidden">友链</h1>
    <section class="site-info-box" data-site-info>
      <button class="site-info-summary" type="button" aria-expanded="false" aria-controls="site-info-panel">
        <span class="directory-count">{String(friendLinks.length).padStart(2, '0')} SITES</span>
        <span class="exchange-label">交换友链 <span aria-hidden="true">＋</span></span>
      </button>
      <div class="site-info-panel" id="site-info-panel" data-site-info-panel aria-hidden="true" inert>
        <div class="site-info-content">
          <div class="site-info-sheet">
            <div class="site-info-tools">
              <span>TECLADO.INFO</span>
              <button
                type="button"
                class="copy-button"
                data-copy-value={friendLinkProfile}
                aria-label="复制全部友链资料"
              >
                <span class="copy-icon" aria-hidden="true">
                  <span class="copy-icon-default i-tabler-copy h-3.5 w-3.5"></span>
                  <span class="copy-icon-success i-tabler-check h-3.5 w-3.5"></span>
                </span>
                <span data-copy-label aria-live="polite">复制全部</span>
              </button>
            </div>
            <dl class="site-info-list">
              <div class="info-row info-name">
                <dt>名称</dt>
                <dd>
                  <span class="info-value">{myBlogInfo.name}</span>
                </dd>
              </div>
              <div class="info-row info-description">
                <dt>描述</dt>
                <dd>
                  <span class="info-value">{myBlogInfo.desc}</span>
                </dd>
              </div>
              <div class="info-row info-address">
                <dt>网址</dt>
                <dd>
                  <a class="info-value" href={myBlogInfo.url} target="_blank" rel="noopener noreferrer">
                    <code>{myBlogInfo.url}</code>
                  </a>
                </dd>
              </div>
              {
                myBlogInfo.feed && (
                  <div class="info-row info-feed">
                    <dt>订阅</dt>
                    <dd>
                      <a class="info-value" href={myBlogInfo.feed} target="_blank" rel="noopener noreferrer">
                        <code>{myBlogInfo.feed}</code>
                      </a>
                    </dd>
                  </div>
                )
              }
              {
                myBlogInfo.avatar && (
                  <div class="info-row info-avatar">
                    <dt>Logo</dt>
                    <dd>
                      <a class="info-value" href={myBlogInfo.avatar} target="_blank" rel="noopener noreferrer">
                        <code>{myBlogInfo.avatar}</code>
                      </a>
                    </dd>
                  </div>
                )
              }
            </dl>
          </div>
        </div>
      </div>
    </section>

    <ol class="links-list">
      {
        friendLinks.map(link => (
          <li class="friend-row" data-friend-row>
            <div class="friend-avatar-wrap">
              <div class:list={['friend-avatar-placeholder', { 'is-hidden': Boolean(link.avatar) }]} aria-hidden="true">
                {link.name.slice(0, 1)}
              </div>
              {link.avatar && (
                <img
                  src={link.avatar}
                  alt=""
                  width="44"
                  height="44"
                  loading="lazy"
                  class="friend-avatar"
                  onerror="this.style.display='none';this.previousElementSibling?.classList.remove('is-hidden')"
                />
              )}
            </div>
            <div class="friend-identity">
              <h2>
                <a href={link.url} target="_blank" rel="noopener noreferrer">
                  {link.name}
                </a>
              </h2>
              {link.author && (
                <span class="friend-author">
                  <span class="friend-author-prefix">@</span>
                  <span class="friend-author-name">{link.author}</span>
                </span>
              )}
            </div>
            <p class="friend-description">{link.desc}</p>
            <div class="friend-tags" aria-label="标签">
              {link.tags?.slice(0, 3).map(tag => (
                <span>{tag}</span>
              ))}
            </div>
            <div class="friend-actions">
              {link.feed && (
                <a
                  href={link.feed}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="friend-feed not-underline-hover"
                  title="RSS 订阅"
                  aria-label={`${link.name} RSS 订阅`}
                >
                  <span class="i-tabler-rss h-3.5 w-3.5" aria-hidden="true" />
                </a>
              )}
              <span class="friend-arrow" aria-hidden="true">
                ↗
              </span>
            </div>
          </li>
        ))
      }
    </ol>

    <script is:inline>
      ;(() => {
        const page = document.querySelector('[data-links-page]')
        if (!page || page.dataset.ready === 'true') {
          return
        }
        page.dataset.ready = 'true'

        const rows = Array.from(page.querySelectorAll('[data-friend-row]'))
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        const siteInfo = page.querySelector('[data-site-info]')
        const siteInfoButton = siteInfo?.querySelector('button')
        const siteInfoPanel = siteInfo?.querySelector('[data-site-info-panel]')
        const copyButtons = Array.from(page.querySelectorAll('[data-copy-value]'))

        siteInfoButton?.addEventListener('click', () => {
          const isOpen = siteInfoButton.getAttribute('aria-expanded') === 'true'
          siteInfoButton.setAttribute('aria-expanded', String(!isOpen))
          siteInfoPanel?.setAttribute('aria-hidden', String(isOpen))
          if (siteInfoPanel) {
            siteInfoPanel.inert = isOpen
          }
          siteInfo?.classList.toggle('is-open', !isOpen)
        })

        copyButtons.forEach((button) => {
          button.addEventListener('click', async () => {
            const value = button.dataset.copyValue || ''
            const label = button.querySelector('[data-copy-label]')
            await navigator.clipboard.writeText(value)
            if (label) {
              label.textContent = '已复制'
            }
            button.classList.add('is-copied')
            window.setTimeout(() => {
              if (label) {
                label.textContent = '复制全部'
              }
              button.classList.remove('is-copied')
            }, 1400)
          })
        })

        if (reducedMotion || !('IntersectionObserver' in window)) {
          rows.forEach(row => row.classList.add('is-visible'))
          return
        }

        page.dataset.motionReady = 'true'
        const observer = new IntersectionObserver(
          (entries) => {
            const visibleEntries = entries
              .filter(entry => entry.isIntersecting)
              .sort((a, b) => rows.indexOf(a.target) - rows.indexOf(b.target))

            visibleEntries.forEach((entry, index) => {
              window.setTimeout(() => entry.target.classList.add('is-visible'), Math.min(index * 54, 216))
              observer.unobserve(entry.target)
            })
          },
          { rootMargin: '0px 0px -7% 0px', threshold: 0.08 },
        )

        rows.forEach(row => observer.observe(row))
      })()
    </script>
  </section>
</LayoutDefault>

<style>
  .links-page {
    --friends-ink: #2e5946;
    --friends-wash: rgba(46, 89, 70, 0.075);
    --friends-line: rgba(46, 89, 70, 0.34);
    --friends-serif: 'Noto Serif SC Variable', 'Songti SC', Georgia, serif;
    margin-top: clamp(-1.5rem, -2.6vw, -0.8rem);
  }

  :global(.dark) .links-page {
    --friends-ink: #9ab8a8;
    --friends-wash: rgba(112, 151, 130, 0.12);
    --friends-line: rgba(154, 184, 168, 0.4);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .site-info-box {
    border: 0;
  }

  .site-info-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 2.85rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    border-bottom: 1px solid var(--theme-border);
  }

  .directory-count {
    color: var(--theme-muted);
    font:
      9px/1 'JetBrains Mono Variable',
      monospace;
    letter-spacing: 0.14em;
  }

  .exchange-label {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--theme-sub);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    transition:
      color 200ms ease,
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-info-summary:hover .exchange-label {
    color: var(--friends-ink);
    transform: translateX(-3px);
  }

  .exchange-label span {
    display: inline-block;
    font-size: 0.9rem;
    transform-origin: center;
    transition: transform 480ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-info-box.is-open .exchange-label span {
    transform: rotate(45deg);
  }

  .site-info-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    will-change: grid-template-rows, opacity;
    transition:
      grid-template-rows 520ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 180ms ease;
  }

  .site-info-box.is-open .site-info-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .site-info-content {
    min-height: 0;
    overflow: hidden;
  }

  .site-info-sheet {
    position: relative;
    margin: 0.75rem 0 1rem;
    padding: 0.9rem 1rem 0.95rem 1.15rem;
    border-left: 2px solid var(--friends-line);
    background: linear-gradient(105deg, var(--friends-wash), rgba(46, 89, 70, 0.015) 72%, transparent);
    opacity: 1;
    transform: translateY(-7px);
    transform-origin: top center;
    will-change: transform;
    transition: transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-info-box.is-open .site-info-sheet {
    opacity: 1;
    transform: translateY(0);
  }

  .site-info-tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.7rem;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 260ms ease,
      transform 440ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-info-box.is-open .site-info-tools {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 35ms;
  }

  .site-info-tools > span {
    color: var(--theme-muted);
    font:
      8px/1 'JetBrains Mono Variable',
      monospace;
    letter-spacing: 0.13em;
  }

  .site-info-list {
    margin: 0;
    padding: 0;
  }

  .info-row {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr);
    align-items: center;
    min-height: 1.85rem;
    opacity: 0;
    transform: translateX(-7px);
    transition:
      opacity 260ms ease,
      transform 460ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-info-box.is-open .info-row {
    opacity: 1;
    transform: translateX(0);
  }

  .site-info-box.is-open .info-row:nth-child(1) {
    transition-delay: 45ms;
  }

  .site-info-box.is-open .info-row:nth-child(2) {
    transition-delay: 70ms;
  }

  .site-info-box.is-open .info-row:nth-child(3) {
    transition-delay: 95ms;
  }

  .site-info-box.is-open .info-row:nth-child(4) {
    transition-delay: 120ms;
  }

  .site-info-box.is-open .info-row:nth-child(5) {
    transition-delay: 145ms;
  }

  .info-row dt {
    color: var(--theme-muted);
    font:
      8px/1 'JetBrains Mono Variable',
      monospace;
    letter-spacing: 0.13em;
    transition: color 220ms ease;
  }

  .info-row dd {
    min-width: 0;
    margin: 0;
    color: var(--theme-sub);
    font-size: 0.74rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .info-description dd {
    color: var(--uno-colors-primary);
    font-family: var(--friends-serif);
    font-size: 0.76rem;
  }

  .info-name dd {
    color: var(--uno-colors-primary);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .info-value {
    display: inline-block;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .info-row code {
    padding: 0;
    background: transparent;
    font-size: 0.68rem;
  }

  .copy-button {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
    min-width: 4.6rem;
    padding: 0.24rem 0;
    border: 0;
    background: transparent;
    color: var(--theme-muted);
    font-size: 0.62rem;
    line-height: 1;
    cursor: pointer;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease,
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .copy-icon {
    position: relative;
    width: 0.875rem;
    height: 0.875rem;
    overflow: hidden;
  }

  .copy-icon-default,
  .copy-icon-success {
    position: absolute;
    inset: 0;
    transition:
      opacity 220ms ease,
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .copy-icon-success {
    opacity: 0;
    transform: translateY(5px);
  }

  .copy-button:hover {
    color: var(--friends-ink);
    transform: translateX(-2px);
  }

  .copy-button.is-copied {
    color: var(--friends-ink);
    transform: none;
  }

  .copy-button.is-copied .copy-icon-default {
    opacity: 0;
    transform: translateY(-5px);
  }

  .copy-button.is-copied .copy-icon-success {
    opacity: 1;
    transform: translateY(0);
  }

  .copy-button:active {
    transform: translateY(1px);
  }

  .links-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    margin: clamp(1.6rem, 4vw, 2.6rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .friend-row {
    position: relative;
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    grid-template-rows: repeat(3, auto);
    align-items: center;
    gap: 0 0.8rem;
    min-height: 140px;
    padding: 0.82rem 0.9rem;
    overflow: hidden;
    border: 1px solid var(--theme-border);
    isolation: isolate;
    transition:
      border-color 300ms ease,
      box-shadow 400ms ease;
  }

  .friend-row::before {
    position: absolute;
    z-index: 0;
    inset: 0;
    background: var(--friends-wash);
    clip-path: circle(0 at 93% 8%);
    content: '';
    transition: clip-path 620ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .friend-row:is(:hover, :focus-within) {
    border-color: var(--friends-line);
    box-shadow: 0 9px 24px rgba(25, 45, 35, 0.045);
  }

  .friend-row:is(:hover, :focus-within)::before {
    clip-path: circle(145% at 93% 8%);
  }

  .friend-row > * {
    position: relative;
    z-index: 1;
  }

  .links-page[data-motion-ready='true'] .friend-row:not(.is-visible) {
    opacity: 0;
  }

  .links-page[data-motion-ready='true'] .friend-row:nth-child(odd):not(.is-visible) {
    transform: translate3d(-18px, 10px, 0) rotate(-0.45deg);
  }

  .links-page[data-motion-ready='true'] .friend-row:nth-child(even):not(.is-visible) {
    transform: translate3d(18px, 10px, 0) rotate(0.45deg);
  }

  .friend-row.is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0) rotate(0);
    transition:
      opacity 500ms ease,
      transform 680ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 300ms ease,
      box-shadow 400ms ease;
  }

  .friend-avatar-wrap {
    position: relative;
    width: 40px;
    height: 40px;
  }

  .friend-avatar,
  .friend-avatar-placeholder {
    width: 40px;
    height: 40px;
    border: 1px solid var(--theme-border);
    border-radius: 3px;
  }

  .friend-avatar {
    position: absolute;
    inset: 0;
    display: block;
    object-fit: cover;
    filter: grayscale(0.3) contrast(0.96);
    transition:
      filter 260ms ease,
      transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .friend-avatar-placeholder {
    display: grid;
    place-items: center;
    color: var(--theme-sub);
    font-family: var(--friends-serif);
    font-size: 0.9rem;
  }

  .friend-avatar-placeholder.is-hidden {
    display: none;
  }

  .friend-row:is(:hover, :focus-within) .friend-avatar {
    filter: grayscale(0);
    transform: rotate(-4deg) scale(1.07);
  }

  .friend-identity {
    min-width: 0;
  }

  .friend-identity h2 {
    margin: 0;
    overflow: hidden;
    font-family: var(--friends-serif);
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .friend-identity h2 a::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    content: '';
  }

  .friend-row:is(:hover, :focus-within) .friend-identity h2 {
    transform: translateX(4px);
  }

  .friend-author {
    display: flex;
    align-items: baseline;
    gap: 0.12rem;
    max-width: 100%;
    margin-top: 0.16rem;
    overflow: hidden;
    color: var(--theme-muted);
    font-size: 0.61rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .friend-author-prefix {
    flex: 0 0 auto;
    color: var(--friends-ink);
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 0.92em;
  }

  .friend-author-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .friend-description {
    display: -webkit-box;
    grid-column: 1 / -1;
    align-self: start;
    margin: 0.62rem 0 0;
    overflow: hidden;
    color: var(--theme-sub);
    font-size: 0.76rem;
    line-height: 1.55;
    text-wrap: pretty;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .friend-tags {
    display: flex;
    grid-column: 1 / 3;
    align-self: end;
    flex-wrap: wrap;
    gap: 0.25rem 0.7rem;
    margin-top: 0.5rem;
  }

  .friend-tags span {
    color: var(--theme-muted);
    font-size: 0.59rem;
    white-space: nowrap;
  }

  .friend-tags span::before {
    margin-right: 0.25rem;
    color: var(--friends-ink);
    content: '·';
  }

  .friend-actions {
    z-index: 2;
    display: flex;
    grid-column: 3;
    grid-row: 1;
    align-items: center;
    gap: 0.55rem;
  }

  .friend-feed {
    display: inline-flex;
    padding: 0.3rem;
    color: var(--theme-muted);
    transition: color 180ms ease;
  }

  .friend-feed:hover {
    color: var(--friends-ink);
  }

  .friend-arrow {
    color: var(--theme-muted);
    font-size: 0.85rem;
    transition:
      color 180ms ease,
      transform 480ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .friend-row:is(:hover, :focus-within) .friend-arrow {
    color: var(--friends-ink);
    transform: translate(4px, -4px);
  }

  @media (max-width: 640px) {
    .info-row {
      grid-template-columns: 2.8rem minmax(0, 1fr);
    }

    .links-list {
      grid-template-columns: 1fr;
      gap: 0.65rem;
      margin-top: 1.25rem;
    }

    .friend-row {
      min-height: 136px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .exchange-label,
    .exchange-label span,
    .site-info-panel,
    .site-info-sheet,
    .site-info-tools,
    .info-row,
    .copy-button,
    .copy-icon-default,
    .copy-icon-success,
    .friend-row,
    .friend-row::before,
    .friend-avatar,
    .friend-identity h2,
    .friend-arrow {
      transition: none;
    }

    .links-page[data-motion-ready='true'] .friend-row:not(.is-visible) {
      opacity: 1;
      transform: none;
    }
  }
</style>
