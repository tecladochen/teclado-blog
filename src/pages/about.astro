---
import { getEntry, render } from 'astro:content'
import Base from '~/layouts/Base.astro'
import { site } from '~/site'

const page = await getEntry('pages', 'about')
if (!page) {
  throw new Error('缺少关于页：src/content/pages/about.md')
}
const { Content } = await render(page)
---

<Base title="about" description={page.data.description}>
  <section class="page-intro">
    <p class="hero-kicker">about</p>
    <h1>about</h1>
    <p>{page.data.description}</p>
  </section>

  <div class="about-grid">
    <article class="prose">
      <Content />
    </article>
    <aside>
      <article class="now-box">
        <span>{site.now.kicker}</span>
        <h2>{site.now.title}</h2>
        <p>{site.now.body}</p>
      </article>
      <div class="about-marks">
        {
          site.marks.map((mark) => (
            <article class="mark">
              <time datetime={mark.date}>{mark.year}</time>
              <h3>{mark.title}</h3>
              <p>{mark.summary}</p>
            </article>
          ))
        }
      </div>
      <p class="about-links">
        {
          site.social.map((item) => (
            <a class="text-link" href={item.href}>
              {item.name}
            </a>
          ))
        }
      </p>
    </aside>
  </div>
</Base>
