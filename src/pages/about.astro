---
import { getEntry, render } from 'astro:content'
import SiteSeo from '~/components/SiteSeo.astro'
import LayoutDefault from '~/layouts/LayoutDefault.astro'

const aboutPost = await getEntry('spec', 'about')
if (!aboutPost) {
  throw new Error('No about post found')
}
const { Content } = await render(aboutPost)
---

<LayoutDefault>
  <SiteSeo slot="seo" title={aboutPost.data.title} desc="Teclado 的个人简介、博客内容与长期计划。" />

  <section class="about-page" data-about-page>
    <header class="about-profile">
      <h1 class="about-heading">关于 Teclado</h1>
      <div class="about-titleline">
        {
          aboutPost.data.labels && (
            <ul class="about-labels" aria-label="个人标签">
              {aboutPost.data.labels.map(label => (
                <li>{label}</li>
              ))}
            </ul>
          )
        }
      </div>
      {aboutPost.data.description && <p>{aboutPost.data.description}</p>}
    </header>
    <article class="about-content" data-about-content>
      <Content />
    </article>

    <aside class="authorship-note" data-authorship-note aria-labelledby="authorship-title">
      <div class="authorship-copy">
        <p class="authorship-kicker">NOT BY AI</p>
        <h2 id="authorship-title">内容由人创作</h2>
        <p>
          本站文章与个人记录均由我独立构思和写作，不使用生成式 AI 生成或代笔。程序开发与视觉实现可能使用
          AI 工具辅助，内容中的观点、叙述与表达均来自我本人。
        </p>
      </div>
      <a
        class="authorship-badge"
        href="https://notbyai.fyi/cn/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="了解 Not By AI 人工创作声明"
      >
        <img
          src="/badges/authored-by-human-not-by-ai.svg"
          width="131"
          height="42"
          alt="Authored by Human, Not By AI"
        />
      </a>
    </aside>

    <script is:inline>
      ;(() => {
        const page = document.querySelector('[data-about-page]')
        if (!page || page.dataset.ready === 'true') {
          return
        }
        page.dataset.ready = 'true'

        const content = page.querySelector('[data-about-content]')
        const note = page.querySelector('[data-authorship-note]')
        const blocks = content ? Array.from(content.children) : []
        if (note) {
          blocks.push(note)
        }
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

        if (reducedMotion || !('IntersectionObserver' in window)) {
          blocks.forEach(block => block.classList.add('is-visible'))
          return
        }

        page.dataset.motionReady = 'true'
        const observer = new IntersectionObserver(
          (entries) => {
            const visibleEntries = entries
              .filter(entry => entry.isIntersecting)
              .sort((a, b) => blocks.indexOf(a.target) - blocks.indexOf(b.target))

            visibleEntries.forEach((entry, index) => {
              window.setTimeout(() => entry.target.classList.add('is-visible'), Math.min(index * 32, 64))
              observer.unobserve(entry.target)
            })
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        )

        blocks.forEach(block => observer.observe(block))
      })()
    </script>
  </section>
</LayoutDefault>

<style>
  .about-page {
    --about-serif: 'Songti SC', 'Noto Serif CJK SC', 'Source Han Serif SC', STSong, SimSun, Georgia, serif;
    width: 100%;
    margin-top: clamp(-1rem, -2vw, -0.5rem);
  }

  .about-profile {
    margin-bottom: 1.85rem;
    padding: 0.25rem 0 1.25rem;
    border-bottom: 1px solid var(--theme-border);
  }

  .about-titleline {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
  }

  .about-heading {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .about-labels {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.3rem 0.65rem;
    margin: 0;
    padding: 0;
    color: var(--uno-colors-primary);
    font-family: var(--about-serif);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    line-height: 1.6;
    list-style: none;
  }

  .about-labels li + li::before {
    content: '·';
    margin-right: 0.65rem;
    color: var(--theme-border-strong, var(--theme-muted));
  }

  .about-profile > p {
    max-width: 30rem;
    margin: 0.45rem 0 0;
    color: var(--theme-sub);
    font-size: 0.76rem;
    line-height: 1.7;
  }

  :global(.about-content > *) {
    margin: 0;
  }

  :global(.about-content > p) {
    margin-bottom: 1.15rem;
    color: var(--theme-sub);
    font-family: var(--about-serif);
    font-size: 0.9rem;
    line-height: 1.95;
    text-wrap: pretty;
  }

  :global(.about-content > p:first-child) {
    margin-bottom: 1.25rem;
    color: var(--uno-colors-primary);
    font-size: 1.02rem;
    line-height: 2;
  }

  :global(.about-content strong) {
    color: var(--uno-colors-primary);
    font-weight: 600;
  }

  :global(.about-content > h2) {
    margin: 2.2rem 0 0.8rem;
    color: var(--uno-colors-primary);
    font-family: var(--about-serif);
    font-size: 0.96rem;
    font-weight: 700;
    line-height: 1.6;
  }

  :global(.about-content > h2::before) {
    content: '—';
    margin-right: 0.55rem;
    color: var(--theme-muted);
    font-weight: 400;
  }

  :global(.about-content > h3) {
    margin: 1.6rem 0 0.65rem;
    color: var(--uno-colors-primary);
    font-family: var(--about-serif);
    font-size: 0.88rem;
    font-weight: 600;
  }

  :global(.about-content > ul) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.58rem;
    max-width: 46rem;
    padding-left: 0;
    list-style: none;
  }

  :global(.about-content > ul),
  :global(.about-content > ol) {
    margin: 0.15rem 0 1.25rem;
    color: var(--theme-sub);
    font-family: var(--about-serif);
    font-size: 0.86rem;
    line-height: 1.8;
  }

  :global(.about-content > ol) {
    padding-left: 1.2rem;
  }

  :global(.about-content > ul li),
  :global(.about-content > ol li) {
    margin: 0.3rem 0;
    padding-left: 0.2rem;
  }

  :global(.about-content > ul li) {
    position: relative;
    margin: 0;
    padding-left: 1rem;
    line-height: 1.85;
  }

  :global(.about-content > ul li::before) {
    position: absolute;
    top: 0.82em;
    left: 0;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--theme-muted);
    content: '';
    opacity: 0.72;
  }

  :global(.about-content > ol li::marker) {
    color: var(--theme-muted);
    font-size: 0.9em;
  }

  :global(.about-content > blockquote) {
    margin: 1.3rem 0;
    padding: 0.15rem 0 0.15rem 0.9rem;
    border-left: 2px solid var(--theme-border);
    color: var(--theme-muted);
    font-family: var(--about-serif);
    font-size: 0.86rem;
    line-height: 1.85;
  }

  :global(.about-content > blockquote p) {
    margin: 0;
  }

  :global(.about-content > hr) {
    height: 1px;
    margin: 2rem 0;
    border: 0;
    background: var(--theme-border);
  }

  :global(.about-content a) {
    color: var(--uno-colors-primary);
    text-decoration-color: var(--theme-border);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .authorship-note {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(1.5rem, 5vw, 4rem);
    margin-top: clamp(2.8rem, 7vw, 4.8rem);
    padding: 1.25rem 0 0.2rem;
    border-top: 1px solid var(--theme-border);
  }

  .authorship-copy {
    max-width: 35rem;
  }

  .authorship-kicker {
    margin: 0 0 0.35rem;
    color: var(--theme-muted);
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 0.56rem;
    letter-spacing: 0.16em;
  }

  .authorship-copy h2 {
    margin: 0;
    color: var(--uno-colors-primary);
    font-family: var(--about-serif);
    font-size: 0.9rem;
    font-weight: 650;
    line-height: 1.6;
  }

  .authorship-copy > p:last-child {
    margin: 0.48rem 0 0;
    color: var(--theme-muted);
    font-family: var(--about-serif);
    font-size: 0.72rem;
    line-height: 1.8;
    text-wrap: pretty;
  }

  .authorship-badge {
    display: inline-flex;
    flex: 0 0 auto;
    padding: 0.45rem;
    outline-offset: 4px;
  }

  .authorship-badge img {
    display: block;
    width: 131px;
    height: 42px;
  }

  .about-page[data-motion-ready='true'] :global(.about-content > *:not(.is-visible)) {
    opacity: 0;
    transform: translateY(6px);
  }

  :global(.about-content > *.is-visible) {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 360ms ease,
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .authorship-note.is-visible {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 360ms ease,
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .about-page[data-motion-ready='true'] .authorship-note:not(.is-visible) {
    opacity: 0;
    transform: translateY(6px);
  }

  @media (max-width: 620px) {
    :global(.about-content > p) {
      font-size: 0.86rem;
    }

    :global(.about-content > p:first-child) {
      font-size: 0.98rem;
    }

    :global(.about-content > h2) {
      margin-top: 1.9rem;
    }

    :global(.about-content > ul) {
      grid-template-columns: 1fr;
    }

    .authorship-note {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1rem;
      margin-top: 2.8rem;
    }

    .authorship-badge {
      margin-left: -0.45rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.about-content > *) {
      transition: none;
    }

    .about-page[data-motion-ready='true'] :global(.about-content > *:not(.is-visible)) {
      opacity: 1;
      transform: none;
    }

    .authorship-note,
    .authorship-badge {
      transition: none;
    }

    .about-page[data-motion-ready='true'] .authorship-note:not(.is-visible) {
      opacity: 1;
      transform: none;
    }
  }
</style>
