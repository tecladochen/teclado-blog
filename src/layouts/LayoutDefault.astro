---
import { themeConfig } from '~/.config'
import Analytics from '~/components/Analytics.astro'
import LaTeX from '~/components/LaTeX.astro'
import Signature from '~/components/Signature.astro'
import SiteFooter from '~/components/SiteFooter.astro'
import SiteNavigation from '~/components/SiteNavigation.astro'
import SiteSeo from '~/components/SiteSeo.astro'
import ThemeScript from '~/components/ThemeScript.astro'
import '~/styles/global.css'

const lang = themeConfig.appearance.locale ?? 'en-us'
const dark = themeConfig.appearance.theme === 'dark'
---

<html lang={lang} class:list={['animation-prepared', { dark }]}>
  <head>
    <script is:inline>
      ;(() => {
        const root = document.documentElement
        const clearIntro = () => delete root.dataset.signatureIntro

        if (root.dataset.signatureIntroRun !== 'true') {
          root.dataset.signatureIntroRun = 'true'
          root.dataset.signatureIntro = 'play'
          window.setTimeout(clearIntro, 2800)
          document.addEventListener('astro:before-swap', clearIntro, { once: true })
        }
      })()
    </script>
    <slot name="seo"> <SiteSeo /> </slot>
    <LaTeX />
    <Analytics />
    <ThemeScript />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Noto+Serif+SC:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="mx-auto max-w-[880px] min-h-100vh w-full flex flex-col px-4 py-5 sm:px-6 sm:py-10">
    <!-- 极简现代顶栏 -->
    <header
      class="transition-swup-header mb-8 w-full flex items-center justify-between gap-1 border-b border-black/[0.06] pb-5 sm:mb-12 sm:gap-4 dark:border-white/[0.08] sm:pb-6"
    >
      <a href="/" class="not-underline-hover inline-flex shrink-0 items-center" title="Teclado - 首页" data-nav-logo>
        <Signature />
      </a>

      <!-- 顶部导航 -->
      <SiteNavigation />
    </header>

    <main class="transition-swup-main w-full flex-1 outline-none">
      <slot />
    </main>

    <footer class="transition-swup-footer mt-16 pb-7 sm:mt-20 sm:pb-9">
      <SiteFooter />
    </footer>

    <script>
      document.addEventListener('animationend', removeAnimation, false)
      function removeAnimation() {
        document.documentElement.classList.remove('animation-prepared')
        document.removeEventListener('animationend', removeAnimation, false)
      }
    </script>
    <style>
      /* 页面首次加载动画 */
      html.animation-prepared .transition-swup-header,
      html.animation-prepared .transition-swup-footer {
        animation: fade-in-down 0.8s ease-out 1;
      }

      html.animation-prepared .transition-swup-main {
        animation: fade-in-down 0.8s ease-out 1;
      }

      @keyframes fade-in-down {
        0% {
          transform: translateY(-0.75rem);
          opacity: 0;
        }
        100% {
          transform: translateY(0);
          opacity: 1;
        }
      }

      /* 页面过渡动画 */
      html.is-animating .transition-swup-main {
        opacity: 0;
        transform: translateY(-0.75rem);
      }
      html.is-leaving .transition-swup-main {
        opacity: 0;
        transform: translateY(0.75rem);
      }
      .transition-swup-main {
        transition-property: opacity, transform;
        transition-duration: 0.35s;
        transition-timing-function: ease;
        opacity: 1;
      }

      @media (prefers-reduced-motion: reduce) {
        html.animation-prepared .transition-swup-header,
        html.animation-prepared .transition-swup-footer,
        html.animation-prepared .transition-swup-main {
          animation: none;
        }

        .transition-swup-main {
          transition: none;
        }
      }
    </style>
  </body>
</html>
