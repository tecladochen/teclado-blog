---
import { themeConfig } from '~/.config'
import SiteFooter from '~/components/SiteFooter.astro'
import SiteNavigation from '~/components/SiteNavigation.astro'
import Signature from '~/components/Signature.astro'
import SiteSeo from '~/components/SiteSeo.astro'
import LaTeX from '~/components/LaTeX.astro'
import Analytics from '~/components/Analytics.astro'
import ThemeScript from '~/components/ThemeScript.astro'
import SearchPalette from '~/components/SearchPalette.astro'
import '~/styles/global.css'

const lang = themeConfig.appearance.locale ?? 'en-us'
const dark = themeConfig.appearance.theme === 'dark'
---

<html lang={lang} class:list={['animation-prepared', { dark }]}>
  <head>
    <slot name="seo"> <SiteSeo /> </slot>
    <LaTeX />
    <Analytics />
    <ThemeScript />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body
    class="min-h-100vh max-w-[1000px] min-w-360px mx-auto px-6 sm:px-8 py-6 sm:py-8 flex flex-col selection:bg-[#EBE5D8] selection:text-[#1C1B1A]"
  >
    <!-- 1. 人文杂志式报头 (Editorial Masthead) -->
    <header class="transition-swup-header w-full mb-10 sm:mb-12">
      <!-- 顶部卷期与城市信息 -->
      <div
        class="flex items-center justify-between text-[11px] font-mono tracking-widest uppercase py-2 hairline-b text-[var(--paper-muted)] opacity-80"
      >
        <span>NO. 28 · VOL. IV — 2026</span>
        <span class="hidden sm:inline">FIELD NOTES &amp; DIGITAL CRAFT</span>
        <span>SHENZHEN / REMOTE</span>
      </div>

      <!-- 报头中央：手写签名与双细线装饰 -->
      <div class="py-6 sm:py-7 text-center">
        <div class="flex items-center justify-center gap-6">
          <div class="h-[1px] bg-[var(--paper-border)] flex-1 max-w-[140px] hidden sm:block"></div>
          <a
            href="/"
            class="not-underline-hover inline-block transition-transform duration-300 hover:scale-[1.02]"
            title="Teclado - Home"
          >
            <Signature height="2.75rem" />
          </a>
          <div class="h-[1px] bg-[var(--paper-border)] flex-1 max-w-[140px] hidden sm:block"></div>
        </div>
        <p class="font-serif italic text-xs tracking-[0.25em] text-[var(--paper-muted)] mt-2 uppercase select-none">
          Digital Garden &amp; Essays by Teclado
        </p>
      </div>

      <!-- 经典报刊式导航条目 -->
      <SiteNavigation />
    </header>

    <main class="transition-swup-main flex-1 w-full outline-none">
      <slot />
    </main>

    <footer
      class="transition-swup-footer pt-10 pb-8 hairline-t mt-16 flex flex-wrap items-center justify-between gap-3 text-xs text-[var(--paper-muted)] font-mono"
    >
      <SiteFooter />
    </footer>

    <SearchPalette />

    <script>
      document.addEventListener('animationend', removeAnimation, false)
      function removeAnimation() {
        document.documentElement.classList.remove('animation-prepared')
        document.removeEventListener('animationend', removeAnimation, false)
      }
    </script>
    <style>
      /* 页面首次加载动画 */
      html.animation-prepared .transition-swup-header,
      html.animation-prepared .transition-swup-footer {
        animation: fade-in-down 0.8s ease-out 1;
      }

      html.animation-prepared .transition-swup-main {
        animation: fade-in-down 0.8s ease-out 1;
      }

      @keyframes fade-in-down {
        0% {
          transform: translateY(-0.75rem);
          opacity: 0;
        }
        100% {
          transform: translateY(0);
          opacity: 1;
        }
      }

      /* 页面过渡动画 */
      html.is-animating .transition-swup-main {
        opacity: 0;
        transform: translateY(-0.75rem);
      }
      html.is-leaving .transition-swup-main {
        opacity: 0;
        transform: translateY(0.75rem);
      }
      .transition-swup-main {
        transition-duration: 0.35s;
        transition-timing-function: ease;
        transform: translateY(0);
        opacity: 1;
      }
    </style>
  </body>
</html>
