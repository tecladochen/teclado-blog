---
import { themeConfig } from '~/.config'
import Analytics from '~/components/Analytics.astro'
import LaTeX from '~/components/LaTeX.astro'
import Signature from '~/components/Signature.astro'
import SiteFooter from '~/components/SiteFooter.astro'
import SiteNavigation from '~/components/SiteNavigation.astro'
import SiteSeo from '~/components/SiteSeo.astro'
import ThemeScript from '~/components/ThemeScript.astro'
import '@fontsource-variable/inter/wght.css'
import '@fontsource-variable/jetbrains-mono/wght.css'
import '~/styles/global.css'

const lang = themeConfig.appearance.locale ?? 'en-us'
const dark = themeConfig.appearance.theme === 'dark'
---

<html lang={lang} class:list={['animation-prepared', { dark }]}>
  <head>
    <script is:inline>
      ;(() => {
        const root = document.documentElement
        const storageKey = 'teclado:signature-intro-played'
        const clearIntro = () => delete root.dataset.signatureIntro
        let hasPlayed = false

        try {
          hasPlayed = sessionStorage.getItem(storageKey) === 'true'
        }
        catch {
          // Session storage is optional; the signature can still animate once per page.
        }

        if (!hasPlayed) {
          root.dataset.signatureIntro = 'play'
          try {
            sessionStorage.setItem(storageKey, 'true')
          }
          catch {
            // Ignore storage failures in privacy-restricted browsers.
          }
          window.setTimeout(clearIntro, 2800)
        }
      })()
    </script>
    <slot name="seo"> <SiteSeo /> </slot>
    <LaTeX />
    <Analytics />
    <ThemeScript />
  </head>

  <body class="mx-auto max-w-[880px] min-h-100vh w-full flex flex-col px-4 py-5 sm:px-6 sm:py-10">
    <!-- 极简现代顶栏 -->
    <header
      class="page-intro mb-8 w-full flex items-center justify-between gap-1 border-b border-black/[0.06] pb-5 sm:mb-12 sm:gap-4 dark:border-white/[0.08] sm:pb-6"
    >
      <a href="/" class="not-underline-hover inline-flex shrink-0 items-center" title="Teclado - 首页" data-nav-logo>
        <Signature />
      </a>

      <!-- 顶部导航 -->
      <SiteNavigation />
    </header>

    <main class="page-content w-full flex-1 outline-none">
      <slot />
    </main>

    <footer class="page-intro mt-16 pb-7 sm:mt-20 sm:pb-9">
      <SiteFooter />
    </footer>

    <script>
      document.addEventListener('animationend', removeAnimation, false)
      function removeAnimation(event: AnimationEvent) {
        if (event.animationName !== 'page-content-enter')
          return
        document.documentElement.classList.remove('animation-prepared')
        document.removeEventListener('animationend', removeAnimation, false)
      }
    </script>
    <style>
      /* 页面首次加载动画 */
      html.animation-prepared .page-intro {
        animation: fade-in-down 0.22s ease-out 1 both;
      }

      html.animation-prepared .page-content {
        animation: page-content-enter 0.22s cubic-bezier(0.22, 1, 0.36, 1) 1 both;
      }

      @keyframes fade-in-down {
        0% {
          transform: translateY(-0.75rem);
          opacity: 0;
        }
        100% {
          transform: translateY(0);
          opacity: 1;
        }
      }

      @keyframes page-content-enter {
        0% {
          transform: translateY(0.25rem);
          opacity: 0.62;
        }
        100% {
          transform: translateY(0);
          opacity: 1;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html.animation-prepared .page-intro,
        html.animation-prepared .page-content {
          animation: none;
        }
      }
    </style>
  </body>
</html>
