---
import { themeConfig } from '~/.config'
import SiteFooter from '~/components/SiteFooter.astro'
import SiteNavigation from '~/components/SiteNavigation.astro'
import Signature from '~/components/Signature.astro'
import SiteSeo from '~/components/SiteSeo.astro'
import LaTeX from '~/components/LaTeX.astro'
import Analytics from '~/components/Analytics.astro'
import ThemeScript from '~/components/ThemeScript.astro'
import SearchPalette from '~/components/SearchPalette.astro'
import '~/styles/global.css'

const lang = themeConfig.appearance.locale ?? 'en-us'
const dark = themeConfig.appearance.theme === 'dark'
---

<html lang={lang} class:list={['animation-prepared', { dark }]}>
  <head>
    <slot name="seo"> <SiteSeo /> </slot>
    <LaTeX />
    <Analytics />
    <ThemeScript />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-100vh w-full max-w-[740px] mx-auto px-4 sm:px-6 py-5 sm:py-10 flex flex-col">
    <!-- 极简现代顶栏 -->
    <header
      class="transition-swup-header w-full pb-5 sm:pb-6 mb-8 sm:mb-12 border-b border-black/[0.06] dark:border-white/[0.08] flex items-center justify-between gap-1 sm:gap-4"
    >
      <a
        href="/"
        class="not-underline-hover inline-flex items-center transition-transform duration-200 hover:-translate-y-0.5 shrink-0"
        title="Teclado - 首页"
      >
        <Signature />
      </a>

      <!-- 顶部导航 -->
      <SiteNavigation />
    </header>

    <main class="transition-swup-main flex-1 w-full outline-none">
      <slot />
    </main>

    <footer
      class="transition-swup-footer pt-8 pb-10 border-t border-black/[0.06] dark:border-white/[0.08] mt-16 sm:mt-20 flex flex-wrap items-center justify-between gap-4 text-xs text-neutral-500 dark:text-neutral-400 font-mono"
    >
      <SiteFooter />
    </footer>

    <SearchPalette />

    <script>
      document.addEventListener('animationend', removeAnimation, false)
      function removeAnimation() {
        document.documentElement.classList.remove('animation-prepared')
        document.removeEventListener('animationend', removeAnimation, false)
      }
    </script>
    <style>
      /* 页面首次加载动画 */
      html.animation-prepared .transition-swup-header,
      html.animation-prepared .transition-swup-footer {
        animation: fade-in-down 0.8s ease-out 1;
      }

      html.animation-prepared .transition-swup-main {
        animation: fade-in-down 0.8s ease-out 1;
      }

      @keyframes fade-in-down {
        0% {
          transform: translateY(-0.75rem);
          opacity: 0;
        }
        100% {
          transform: translateY(0);
          opacity: 1;
        }
      }

      /* 页面过渡动画 */
      html.is-animating .transition-swup-main {
        opacity: 0;
        transform: translateY(-0.75rem);
      }
      html.is-leaving .transition-swup-main {
        opacity: 0;
        transform: translateY(0.75rem);
      }
      .transition-swup-main {
        transition-duration: 0.35s;
        transition-timing-function: ease;
        transform: translateY(0);
        opacity: 1;
      }
    </style>
  </body>
</html>
