---
import '~/styles/reading-design.css'
import PostMeta from '~/components/PostMeta.astro'
import type { Post } from '~/types'

interface Props {
  post: Post
}

const { post } = Astro.props
---

<article class="article-sheet reading-design">
  <PostMeta post={post} />
  <div class="post-reading-surface">
    <div class="post-prose-content prose mx-auto w-full max-w-[39rem]">
      <slot />
    </div>
  </div>
</article>

<style is:global>
  .article-sheet {
    background: transparent;
  }
  .post-reading-surface {
    position: relative;
    padding: 72px 36px 84px 132px;
    background: linear-gradient(
      90deg,
      transparent 0,
      color-mix(in srgb, var(--reading-surface) 86%, transparent) 17%,
      color-mix(in srgb, var(--reading-surface) 96%, transparent) 88%,
      transparent 100%
    );
    border-top: 1px solid var(--reading-ink);
    border-bottom: 1px solid var(--reading-rule);
  }
  .post-reading-surface::before {
    content: '';
    position: absolute;
    top: 48px;
    bottom: 48px;
    left: 95px;
    width: 1px;
    background: var(--reading-rule);
  }
  .post-prose-content {
    max-width: 38rem;
    margin-inline: auto 24px;
    font-family: var(--reading-sans);
    color: var(--reading-ink);
    font-size: 17px;
    line-height: 2.05;
    letter-spacing: 0.006em;
  }
  .dark .post-prose-content {
    color: var(--reading-ink);
  }

  .post-prose-content h2 {
    position: relative;
    width: calc(100% + 72px);
    margin-top: 5rem;
    margin-bottom: 1.55rem;
    margin-left: -72px;
    color: var(--reading-ink);
    font-family: var(--reading-serif);
    font-size: 1.65rem;
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: -0.035em;
    scroll-margin-top: 5rem;
  }
  .dark .post-prose-content h2 {
    color: var(--reading-ink);
  }

  .post-prose-content h2::before {
    content: '';
    position: absolute;
    top: 0.82em;
    left: -60px;
    width: 40px;
    height: 1px;
    background: var(--reading-accent);
    transform-origin: right;
    transition: transform 450ms var(--reading-ease);
  }

  .post-prose-content > h2:first-child {
    margin-top: 0;
  }

  .post-prose-content h3 {
    margin-top: 3rem;
    margin-bottom: 0.9rem;
    color: var(--reading-ink);
    font-family: var(--reading-sans);
    font-size: 1.14rem;
    font-weight: 600;
    line-height: 1.6;
  }
  .dark .post-prose-content h3 {
    color: var(--reading-ink);
  }

  .post-prose-content p {
    margin-top: 1.35rem;
    margin-bottom: 1.35rem;
    text-align: start;
  }

  .post-prose-content :where(ul, ol) {
    margin-top: 1.2rem;
    margin-bottom: 1.2rem;
  }

  .post-prose-content li {
    margin-top: 0.45rem;
    margin-bottom: 0.45rem;
  }

  .post-prose-content blockquote {
    margin: 2.4rem 0 2.4rem -32px;
    padding: 1.25rem 0 1.25rem 31px;
    border-left: 2px solid var(--reading-accent);
    color: var(--reading-secondary);
    font-size: 0.95em;
    font-style: normal;
  }
  .post-prose-content blockquote p {
    margin: 0.6rem 0;
  }
  .post-prose-content a {
    color: var(--reading-accent);
    text-decoration-line: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--reading-rule);
    transition: text-decoration-color 180ms ease;
  }
  .post-prose-content a:hover {
    text-decoration-color: currentColor;
  }
  .post-prose-content strong {
    font-weight: 600;
    color: var(--reading-ink);
  }
  .post-prose-content hr {
    border-color: var(--reading-rule);
    margin-block: 2.5rem;
  }

  .post-prose-content img {
    width: calc(100% + 64px);
    max-width: calc(100% + 64px);
    margin: 2.75rem 0 2.75rem -32px;
    border: 1px solid rgba(160, 135, 110, 0.18);
    border-radius: 0.5rem;
  }

  .post-prose-content :where(h2, h3, h4) {
    text-wrap: pretty;
    scroll-margin-top: 2rem;
  }
  .post-prose-content :where(pre, table) {
    max-width: 100%;
    overflow-x: auto;
    font-size: 0.85em;
  }
  .post-prose-content table {
    display: block;
  }
  .post-prose-content pre {
    padding: 1.5rem;
    border: 1px solid var(--theme-border-subtle);
    border-radius: 4px;
    line-height: 1.7;
  }
  .post-prose-content > :first-child {
    margin-top: 0;
  }
  .post-prose-content > :last-child {
    margin-bottom: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .post-prose-content h2:target {
      animation: chapter-arrive 900ms ease-out;
    }
    @keyframes chapter-arrive {
      from {
        color: var(--reading-accent);
        transform: translateX(10px);
      }
      to {
        color: var(--reading-ink);
        transform: translateX(0);
      }
    }
  }
  @media (max-width: 767px) {
    .post-reading-surface {
      padding: 46px 18px 58px 42px;
      background: color-mix(in srgb, var(--reading-surface) 90%, transparent);
    }
    .post-reading-surface::before {
      top: 30px;
      bottom: 30px;
      left: 16px;
    }
    .post-prose-content {
      margin: 0;
      font-size: 16px;
      line-height: 2;
    }
    .post-prose-content h2 {
      width: calc(100% + 16px);
      margin-top: 4rem;
      margin-left: -16px;
      font-size: 1.55rem;
    }
    .post-prose-content h2::before {
      top: 0.82em;
      left: -27px;
      width: 18px;
    }
    .post-prose-content blockquote {
      margin-left: -16px;
      padding-left: 16px;
    }
    .post-prose-content img {
      width: calc(100% + 16px);
      max-width: calc(100% + 16px);
      margin-left: -16px;
    }
  }
</style>
